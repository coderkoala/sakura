{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __SAKURA_DIR__/hooks/session_context.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __SAKURA_DIR__/hooks/web_ground.py",
            "timeout": 45,
            "statusMessage": "checking the web"
          },
          {
            "type": "command",
            "command": "python3 __SAKURA_DIR__/hooks/coordinator_turn.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 __SAKURA_DIR__/hooks/recap_context.py",
            "timeout": 25
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __SAKURA_DIR__/hooks/tool_guard.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 __SAKURA_DIR__/hooks/undo_snapshot.py",
            "timeout": 30,
            "statusMessage": "snapshotting for ?undo"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __SAKURA_DIR__/hooks/claim_check.py",
            "timeout": 10,
            "statusMessage": "checking claims against sources"
          }
        ]
      }
    ]
  }
}
