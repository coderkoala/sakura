# Exec-policy rules: auto-allow unambiguous read-only commands so the agent is not stopped to approve
# `ls` or `git status`. Everything not matched still prompts (sandbox_mode is danger-full-access, so without
# a known-safe list the engine asks about every command). prefix_rule matches a command whose argv starts
# with the given tokens; "allow" skips approval. Add your own with `p` at a prompt (-> rules/default.rules).

# Pure readers that cannot mutate state.
prefix_rule(pattern=["ls"], decision="allow", justification="read-only")
prefix_rule(pattern=["pwd"], decision="allow", justification="read-only")
prefix_rule(pattern=["echo"], decision="allow", justification="read-only")
prefix_rule(pattern=["printf"], decision="allow", justification="read-only")
prefix_rule(pattern=["cat"], decision="allow", justification="read-only")
prefix_rule(pattern=["head"], decision="allow", justification="read-only")
prefix_rule(pattern=["tail"], decision="allow", justification="read-only")
prefix_rule(pattern=["wc"], decision="allow", justification="read-only")
prefix_rule(pattern=["stat"], decision="allow", justification="read-only")
prefix_rule(pattern=["file"], decision="allow", justification="read-only")
prefix_rule(pattern=["which"], decision="allow", justification="read-only")
prefix_rule(pattern=["type"], decision="allow", justification="read-only")
prefix_rule(pattern=["command"], decision="allow", justification="read-only")
prefix_rule(pattern=["date"], decision="allow", justification="read-only")
prefix_rule(pattern=["cal"], decision="allow", justification="read-only")
prefix_rule(pattern=["uname"], decision="allow", justification="read-only")
prefix_rule(pattern=["whoami"], decision="allow", justification="read-only")
prefix_rule(pattern=["id"], decision="allow", justification="read-only")
prefix_rule(pattern=["groups"], decision="allow", justification="read-only")
prefix_rule(pattern=["hostname"], decision="allow", justification="read-only")
prefix_rule(pattern=["uptime"], decision="allow", justification="read-only")
prefix_rule(pattern=["arch"], decision="allow", justification="read-only")
prefix_rule(pattern=["nproc"], decision="allow", justification="read-only")
prefix_rule(pattern=["locale"], decision="allow", justification="read-only")
prefix_rule(pattern=["printenv"], decision="allow", justification="read-only")
prefix_rule(pattern=["tree"], decision="allow", justification="read-only")
prefix_rule(pattern=["du"], decision="allow", justification="read-only")
prefix_rule(pattern=["df"], decision="allow", justification="read-only")
prefix_rule(pattern=["free"], decision="allow", justification="read-only")
prefix_rule(pattern=["lsblk"], decision="allow", justification="read-only")
prefix_rule(pattern=["lscpu"], decision="allow", justification="read-only")
prefix_rule(pattern=["lsusb"], decision="allow", justification="read-only")
prefix_rule(pattern=["lspci"], decision="allow", justification="read-only")
prefix_rule(pattern=["lsmod"], decision="allow", justification="read-only")
prefix_rule(pattern=["basename"], decision="allow", justification="read-only")
prefix_rule(pattern=["dirname"], decision="allow", justification="read-only")
prefix_rule(pattern=["realpath"], decision="allow", justification="read-only")
prefix_rule(pattern=["readlink"], decision="allow", justification="read-only")
prefix_rule(pattern=["true"], decision="allow", justification="read-only")
prefix_rule(pattern=["false"], decision="allow", justification="read-only")
prefix_rule(pattern=["test"], decision="allow", justification="read-only")
prefix_rule(pattern=["seq"], decision="allow", justification="read-only")
prefix_rule(pattern=["sleep"], decision="allow", justification="read-only")
prefix_rule(pattern=["jq"], decision="allow", justification="read-only")
prefix_rule(pattern=["yq"], decision="allow", justification="read-only")
prefix_rule(pattern=["column"], decision="allow", justification="read-only")
prefix_rule(pattern=["sort"], decision="allow", justification="read-only")
prefix_rule(pattern=["uniq"], decision="allow", justification="read-only")
prefix_rule(pattern=["cut"], decision="allow", justification="read-only")
prefix_rule(pattern=["tr"], decision="allow", justification="read-only")
prefix_rule(pattern=["nl"], decision="allow", justification="read-only")
prefix_rule(pattern=["tac"], decision="allow", justification="read-only")
prefix_rule(pattern=["rev"], decision="allow", justification="read-only")
prefix_rule(pattern=["sha256sum"], decision="allow", justification="read-only")
prefix_rule(pattern=["md5sum"], decision="allow", justification="read-only")
prefix_rule(pattern=["base64"], decision="allow", justification="read-only")
prefix_rule(pattern=["hexdump"], decision="allow", justification="read-only")
prefix_rule(pattern=["xxd"], decision="allow", justification="read-only")
prefix_rule(pattern=["strings"], decision="allow", justification="read-only")
prefix_rule(pattern=["grep"], decision="allow", justification="read-only")
prefix_rule(pattern=["rg"], decision="allow", justification="read-only")
prefix_rule(pattern=["fd"], decision="allow", justification="read-only")

# Read-only subcommands of otherwise-mutating tools (the bare tool is NOT allowed).
prefix_rule(pattern=["git", "status"], decision="allow", justification="read-only")
prefix_rule(pattern=["git", "log"], decision="allow", justification="read-only")
prefix_rule(pattern=["git", "diff"], decision="allow", justification="read-only")
prefix_rule(pattern=["git", "show"], decision="allow", justification="read-only")
prefix_rule(pattern=["git", "branch"], decision="allow", justification="read-only")
prefix_rule(pattern=["git", "remote"], decision="allow", justification="read-only")
prefix_rule(pattern=["git", "rev-parse"], decision="allow", justification="read-only")
prefix_rule(pattern=["git", "describe"], decision="allow", justification="read-only")
prefix_rule(pattern=["docker", "ps"], decision="allow", justification="read-only")
prefix_rule(pattern=["docker", "images"], decision="allow", justification="read-only")
prefix_rule(pattern=["docker", "logs"], decision="allow", justification="read-only")
prefix_rule(pattern=["docker", "inspect"], decision="allow", justification="read-only")
prefix_rule(pattern=["systemctl", "status"], decision="allow", justification="read-only")
prefix_rule(pattern=["kubectl", "get"], decision="allow", justification="read-only")
prefix_rule(pattern=["kubectl", "describe"], decision="allow", justification="read-only")

# Sakura web-knowledge CLIs (read-only: they fetch and print, never mutate the machine).
prefix_rule(pattern=["web_search"], decision="allow", justification="read-only web query")
prefix_rule(pattern=["wikipedia"], decision="allow", justification="read-only web query")
prefix_rule(pattern=["fetch_url"], decision="allow", justification="read-only web fetch")
prefix_rule(pattern=["sakura-recall"], decision="allow", justification="read-only search of past sessions")
prefix_rule(pattern=["sakura-memory"], decision="allow", justification="capped, scanned memory store")
prefix_rule(pattern=["himalaya", "envelope", "list"], decision="allow", justification="read-only mail listing")
prefix_rule(pattern=["himalaya", "account"], decision="allow", justification="read-only account check")
prefix_rule(pattern=["pa", "brief"], decision="allow", justification="read-only")
prefix_rule(pattern=["pa", "list"], decision="allow", justification="read-only")
prefix_rule(pattern=["pa", "roles"], decision="allow", justification="read-only")
prefix_rule(pattern=["pa", "standup"], decision="allow", justification="read-only")
prefix_rule(pattern=["pa", "remind"], decision="allow", justification="sets a reminder for the user")
prefix_rule(pattern=["view_file"], decision="allow", justification="read-only")
prefix_rule(pattern=["rag", "search"], decision="allow", justification="read-only search of the local index")
prefix_rule(pattern=["rag", "status"], decision="allow", justification="read-only")
prefix_rule(pattern=["live"], decision="allow", justification="read-only lookups of public data")
prefix_rule(pattern=["sakura-browser", "open"], decision="allow", justification="loads a page in the visible browser")
prefix_rule(pattern=["sakura-browser", "read"], decision="allow", justification="read-only")
prefix_rule(pattern=["sakura-browser", "shot"], decision="allow", justification="screenshot")
prefix_rule(pattern=["sakura-browser", "status"], decision="allow", justification="read-only")
prefix_rule(pattern=["sakura-tool", "list"], decision="allow", justification="read-only list of kept tools")
prefix_rule(pattern=["consult"], decision="allow", justification="read-only one-shot query to a local specialist model")
