#!/usr/bin/env python3
"""sakura-how <what you want> — the one command, not a session. The `?how` key.

  ?how rotate nginx logs weekly
  ?how find files over 1G changed this week
  ?how -r ...                 run it too, once you've seen it (asks y/n)
Prints the command (and one line on what it does), fit for this machine: the shell, the tools installed, the OS. It
doesn't run anything unless you pass -r and say yes. Facts about the machine come from a script, not memory.
"""
import json
import os
import shutil
import subprocess
import sys


def main(argv):
    run, words = False, []
    for a in argv:
        if a == "-r":
            run = True
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        else:
            words.append(a)
    want = " ".join(words).strip()
    if not want:
        print(__doc__.strip())
        return 2
    # Sakura's own toolkit first, with no model: if a command's manual answers the ask, say so before anything else.
    try:
        what = subprocess.run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "sakura-what"), want, "--json"], capture_output=True, text=True, timeout=10)
        top = json.loads(what.stdout or "[]")
        if top and top[0]["score"] >= 6:
            print(f"Sakura has this: {top[0]['command']} — {top[0]['about'].split(' — ', 1)[-1][:100]}")
            if top[0].get("example"):
                print(f"  e.g. {top[0]['example'][:120]}")
            print("  (sakura-what for more; the model's answer follows)")
    except Exception:
        pass
    have = [t for t in ("rg", "fd", "fzf", "jq", "yq", "docker", "systemctl", "journalctl", "gh", "git", "python3", "uv", "node", "php", "logrotate", "cron", "tmux", "rsync", "ssh", "dq", "tbl", "logs", "pa", "fleet", "procwatch") if shutil.which(t)]
    osname = subprocess.run("bash -c '. /etc/os-release && echo $PRETTY_NAME'", shell=True, capture_output=True, text=True).stdout.strip()
    brief = "\n".join([
        f"Give me the one shell command for: {want}",
        f"This machine: {osname}; shell {os.environ.get('SHELL', 'bash')}; in {os.getcwd()}; installed: {', '.join(have)}.",
        "Answer with the command on its own line in a code fence, then one line saying what it does and anything to watch for (it deletes, "
        "it needs sudo, it's slow). Prefer the tools installed here, including Sakura's own (tbl for tables, logs for errors, dq for CSV, pa for "
        "schedules) when they fit. Use `sudo -A` where root is needed. Don't run it; don't explain more than one line; don't offer alternatives unless the "
        "obvious one is dangerous.",
    ])
    r = subprocess.run(["sakura-launch", "--exec", "--skip-git-repo-check", "--json", brief], capture_output=True, text=True)
    answer = ""
    for line in r.stdout.splitlines():
        try:
            item = json.loads(line).get("item", {})
        except ValueError:
            continue
        if item.get("type") == "agent_message" and item.get("text"):
            answer = item["text"]
    if not answer:
        print("sakura-how: no answer", file=sys.stderr)
        return 1
    print(answer.strip())
    if run:
        import re
        m = re.search(r"```[a-z]*\n(.*?)```", answer, re.S)
        cmd = (m.group(1) if m else answer).strip().splitlines()[0] if (m or answer) else ""
        if cmd and input(f"\nrun `{cmd}`? [y/N] ").strip().lower() in ("y", "yes"):
            return subprocess.run(cmd, shell=True).returncode
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
