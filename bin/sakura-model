#!/usr/bin/env python3
"""sakura-model — run Sakura's big local driver when this machine can, with a budget read from the hardware.

The driver is a 35B-A3B Mixture-of-Experts model (abliterated, Q3_K_M; Ornith 1.5 by default, Qwen3.6 as the alternative,
see DRIVERS). Qwen3.6-35B-A3B (abliterated, Q3_K_M) is a 15.6 GB Mixture-of-Experts model: about 3B parameters are active
per token, so the dense part and a cache of experts sit in VRAM and the rest stays in RAM. It was measured on
an RTX 4060 Laptop, 32 GB RAM, against the 9b it replaces: 72 tok/s writing at a 7.3 GB budget and 50 tok/s at
5.3 GB (9b: 43), reading prompts about 3-4x slower, real tool calls, same eval score.

The VRAM budget comes from what's free on THIS machine, because devices differ: a laptop whose iGPU drives the
display has nearly all of the card, while a desktop with no iGPU loses what its display holds. Anything that
doesn't qualify keeps the 9b on Ollama; `up` failing is not an error for the caller, just the signal to fall back.

  sakura-model plan     what this machine would run, and why
  sakura-model up       start the server (no-op if running). Exit 0 only when it answers
  sakura-model down     stop it and free the VRAM
  sakura-model status   is it up, and what does it hold
  sakura-model gpu      temperature, Xid errors this boot, who holds the VRAM. --check exits 1 when a long job shouldn't start
  sakura-model driver [NAME]   which driver file runs (ornith15, the default; qwen36, faster, one eval miss). Switching stops the server
  sakura-model advise   what whatmodel.sh rates for this RAM and VRAM beside Sakura's line. Sends only those two numbers, only when you run it
  sakura-model pick     which model does each job (agent, fast, vision, embed, the consult roles, the driver), yours or Sakura's default
  sakura-model pick ROLE        choose from a menu: what's been tried with Sakura, what Ollama already has, and whatmodel.sh's ranking for
                                this machine (asked first: it sends RAM and VRAM, nothing else). Any Ollama tag or hf.co/… works too
  sakura-model pick ROLE TAG [--pull]   the same without the menu;  sakura-model pick ROLE --default   back to Sakura's
  sakura-model pick driver hf.co/OWNER/REPO:FILE.gguf   a GGUF of your own for the GPU driver (checksum pinned on first download)
  sakura-model get ROLE  the model that role uses now
  sakura-model pull     download the model (15.6 GB), resumable, checksum verified
  sakura-model models   every model that suits this machine, and which are missing
  sakura-model pull-all download the missing ones, most needed first, while the disk allows
                        (--background: as a user unit, so a first start doesn't wait for it)
"""
import hashlib
import json
import re
import os
import shutil
import subprocess
import sys
import time
import urllib.parse
import urllib.request

PORT = 8091
URL = f"http://127.0.0.1:{PORT}"
UNIT = "sakura-model"
# Drivers: the same shape (35B MoE, ~3B active, Q3_K_M, abliterated by huihui, quantised by mradermacher), so the VRAM budget
# below holds for all of them. `sakura-model driver NAME` switches; the default is the one that's been evaluated here.
DRIVERS = {
    "qwen36": {"repo": "mradermacher/Huihui-Qwen3.6-35B-A3B-abliterated-i1-GGUF", "revision": "860d616938187b0a7fb2dfcb24d07911b6364904",
               "file": "Huihui-Qwen3.6-35B-A3B-abliterated.i1-Q3_K_M.gguf", "size": 16764765344,
               "sha256": "a73d0d6e38be6c72745f3a60c311c8bfc4e4aea84a617651fb2b4d27e7ffc3a8",
               "about": "Qwen3.6 35B-A3B: run 30/31, wall 27/28; 72 tok/s warm, 37 after a 26K prompt (whatmodel.sh 67)"},
    "ornith15": {"repo": "mradermacher/Huihui-Ornith-1.5-35B-A3B-abliterated-i1-GGUF", "revision": "bb7ed149cb070175c6b130fa8827672550abda86",
                 "file": "Huihui-Ornith-1.5-35B-A3B-abliterated.i1-Q3_K_M.gguf", "size": 17166660096,
                 "sha256": "cae4302e05b2395a57869a88fb4885b54767392f69919b891b2be2ef753e5d45",
                 "about": "Ornith 1.5 35B-A3B, the default: run 30/30, wall 27/28; 63 tok/s warm, 26 after a 26K prompt (whatmodel.sh 69)"},
}
import importlib.machinery as _im
CHOICES = _im.SourceFileLoader("sakura_choices", os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib", "sakura_choices.py")).load_module()
# Drivers you added (sakura-model pick driver hf.co/…): same fields; size and sha256 are learned on the first download.
for _n, _d in CHOICES.load().get("drivers", {}).items():
    DRIVERS.setdefault(_n, {**_d, "about": _d.get("about") or f"yours: {_d['repo']}/{_d['file']} (untested here; the VRAM budget was measured on 35B-A3B MoE)", "user": True})
HF = os.environ.get("SAKURA_HF_BASE", "https://huggingface.co")
WHATMODEL = os.environ.get("SAKURA_WHATMODEL_URL", "https://whatmodel.sh/")
MODEL_DIR = os.environ.get("SAKURA_MODEL_DIR", os.path.expanduser("~/.local/share/sakura/models"))
DRIVER_FILE = os.path.join(os.environ.get("SAKURA_HOME", os.path.expanduser("~/.sakura")), "driver")


def driver_name():
    name = os.environ.get("SAKURA_DRIVER")
    if not name:
        try:
            name = open(DRIVER_FILE).read().strip()
        except OSError:
            name = ""
    return name if name in DRIVERS else "ornith15"


DRIVER = DRIVERS[driver_name()]
SLUG = "qwen36-q3"  # the alias the launcher and evals address; kept stable across drivers so nothing else changes
REPO, REVISION, FILENAME, SIZE, SHA256 = DRIVER["repo"], DRIVER.get("revision") or "main", DRIVER["file"], DRIVER.get("size"), DRIVER.get("sha256")
MODEL = os.path.join(MODEL_DIR, FILENAME)
ENGINE_DIR = os.environ.get("SAKURA_ENGINE_DIR", "/usr/local/lib/ollama")
ENGINE = os.path.join(ENGINE_DIR, "llama-server")
CUDA = os.path.join(ENGINE_DIR, "cuda_v13")

DENSE_MIB = 2140        # measured: VRAM in use minus the expert cache, at 32K context
HEADROOM_MIB = 800      # measured: leaves the 5200 MiB cache that ran 26 eval cases at 7.3 GB on an 8 GB card
MIN_BUDGET_MIB = 5000   # below this too few experts fit; lower budgets were not evaluated
MAX_CACHE_MIB = 15000   # the experts' own size: more VRAM than this buys nothing
MIN_RAM_GIB = 28        # 15.6 GB of model stays mapped beside the desktop
IDLE_SLEEP_SECONDS = 1200   # the model leaves VRAM after 20 idle minutes; the next `?` brings it back
HOT_C = 83                  # a card this hot shouldn't start hours of work
BAD_XIDS = {"79", "120", "154"}  # fell off the bus, GSP exception, reset required: nothing runs right until a reboot


def vram():
    """(total, used) MiB of the first NVIDIA GPU, or None."""
    try:
        out = subprocess.run(["nvidia-smi", "--query-gpu=memory.total,memory.used", "--format=csv,noheader,nounits"],
                             capture_output=True, text=True, timeout=10).stdout.splitlines()[0]
        total, used = (int(x) for x in out.split(","))
        return total, used
    except Exception:
        return None


def ram_gib():
    with open("/proc/meminfo") as f:
        return int(f.readline().split()[1]) / 1048576


def running():
    try:
        return urllib.request.urlopen(URL + "/health", timeout=2).status == 200
    except Exception as e:
        return getattr(e, "code", None) == 503  # still loading


def healthy():
    try:
        return urllib.request.urlopen(URL + "/health", timeout=2).status == 200
    except Exception:
        return False


def ollama_vram_mib():
    """VRAM held by models Ollama has loaded; `up` unloads them, so they count as free."""
    try:
        out = subprocess.run(["nvidia-smi", "--query-compute-apps=process_name,used_memory", "--format=csv,noheader,nounits"],
                             capture_output=True, text=True, timeout=10).stdout
        return sum(int(l.rsplit(",", 1)[1]) for l in out.splitlines() if "ollama" in l or "llama-server" in l)
    except Exception:
        return 0


def plan():
    """(ok, reason, cache_mib) for this machine."""
    if not (os.access(ENGINE, os.X_OK) and os.path.isdir(CUDA)):
        return False, f"no llama-server with CUDA at {ENGINE_DIR} (it ships with Ollama)", 0
    v = vram()
    if not v:
        return False, "no NVIDIA GPU", 0
    if ram_gib() < MIN_RAM_GIB:
        return False, f"{ram_gib():.0f} GiB RAM, needs {MIN_RAM_GIB}", 0
    total, used = v
    budget = total - max(0, used - ollama_vram_mib()) - HEADROOM_MIB
    if budget < MIN_BUDGET_MIB:
        return False, f"VRAM budget {budget} MiB of {total} (others hold {used} MiB), needs {MIN_BUDGET_MIB}", 0
    cache = min(budget - DENSE_MIB, MAX_CACHE_MIB)
    if not (os.path.isfile(MODEL) and (SIZE is None or os.path.getsize(MODEL) == SIZE)):
        return False, f"model not downloaded; this machine qualifies with a {cache} MiB expert cache: sakura-model pull", cache
    return True, f"{total} MiB card, {budget} MiB budget, {cache} MiB expert cache", cache


def up():
    if healthy():
        return 0
    if running():  # loading: just wait below
        pass
    else:
        subprocess.run(["systemctl", "--user", "stop", UNIT], capture_output=True)
        subprocess.run(["systemctl", "--user", "reset-failed", UNIT], capture_output=True)
        ok, reason, cache = plan()
        if not ok:
            print(f"sakura-model: {reason}", file=sys.stderr)
            return 1
        # Ollama's models would otherwise hold the VRAM this budget just counted as free.
        ps = subprocess.run(["ollama", "ps"], capture_output=True, text=True).stdout.splitlines()[1:]
        for line in ps:
            if line.strip():
                subprocess.run(["ollama", "stop", line.split()[0]], capture_output=True)
        cmd = ["systemd-run", "--user", f"--unit={UNIT}", "--collect", "--quiet",
               f"--setenv=LD_LIBRARY_PATH={CUDA}:{ENGINE_DIR}", f"--setenv=GGML_BACKEND_PATH={CUDA}/libggml-cuda.so",
               ENGINE, "-m", MODEL, "--alias", SLUG, "--host", "127.0.0.1", "--port", str(PORT),
               "-ngl", "99", "--cpu-moe", "--moe-cache-mib", str(cache), "-c", "32768", "--jinja", "-fa", "on",
               "-ctk", "q8_0", "-ctv", "q8_0", "--parallel", "1", "--no-webui",
               # The 7k-token system prompt is the same every turn: reuse its KV cache, in chunks, so only the new part is read.
               "--cache-reuse", "256",
               "--sleep-idle-seconds", str(IDLE_SLEEP_SECONDS)]
        if subprocess.run(cmd).returncode != 0:
            return 1
    deadline = time.time() + 180
    while time.time() < deadline:
        if healthy():
            return 0
        if subprocess.run(["systemctl", "--user", "is-active", "--quiet", UNIT]).returncode != 0:
            print(f"sakura-model: server exited; journalctl --user -u {UNIT}", file=sys.stderr)
            return 1
        time.sleep(1)
    print("sakura-model: server did not answer in 180 s", file=sys.stderr)
    return 1


def gpu_state():
    """(temperature C or None, [xid codes this boot], [(process, MiB)])."""
    temp, xids, holders = None, [], []
    try:
        temp = int(subprocess.run(["nvidia-smi", "--query-gpu=temperature.gpu", "--format=csv,noheader,nounits"],
                                  capture_output=True, text=True, timeout=10).stdout.split()[0])
    except Exception:
        pass
    try:
        import re
        log = subprocess.run("journalctl -k -b --no-pager -q 2>/dev/null | grep -F Xid", shell=True, capture_output=True, text=True, timeout=30).stdout
        xids = re.findall(r"Xid \(PCI:[^)]*\): (\d+)", log)
    except Exception:
        pass
    try:
        out = subprocess.run(["nvidia-smi", "--query-compute-apps=process_name,used_memory", "--format=csv,noheader,nounits"],
                             capture_output=True, text=True, timeout=10).stdout
        holders = [(l.rsplit(",", 1)[0].strip().rsplit("/", 1)[-1], int(l.rsplit(",", 1)[1])) for l in out.splitlines() if "," in l]
    except Exception:
        pass
    return temp, xids, holders


def gpu(check=False):
    temp, xids, holders = gpu_state()
    if temp is None and not holders:
        print("no NVIDIA GPU answering")
        return 1 if check else 0
    bad = sorted(set(xids) & BAD_XIDS)
    print(f"temperature: {temp} C" + (f" (hot: over {HOT_C})" if temp is not None and temp >= HOT_C else ""))
    print(f"Xid errors this boot: {len(xids)}" + (f" (codes {', '.join(sorted(set(xids)))}; {', '.join(bad)} means a reboot is needed)" if xids else ""))
    print("VRAM held by: " + (", ".join(f"{p} {m} MiB" for p, m in holders) or "nobody"))
    if check:
        if bad:
            print(f"not safe for a long job: Xid {', '.join(bad)} this boot; reboot first")
            return 1
        if temp is not None and temp >= HOT_C:
            print(f"not safe for a long job: {temp} C; let it cool")
            return 1
    return 0


def driver(args):
    if not args:
        cur = driver_name()
        for name, d in DRIVERS.items():
            f = os.path.join(MODEL_DIR, d["file"])
            here = os.path.isfile(f) and (d.get("size") is None or os.path.getsize(f) == d["size"])
            print(f"{'*' if name == cur else ' '} {name:<9} {'here' if here else 'not downloaded':<14} {d['about']}")
        return 0
    name = args[0]
    if name not in DRIVERS:
        print(f"sakura-model: no driver {name}; one of: {', '.join(DRIVERS)}", file=sys.stderr)
        return 2
    os.makedirs(os.path.dirname(DRIVER_FILE), exist_ok=True)
    with open(DRIVER_FILE, "w") as f:
        f.write(name + "\n")
    d = DRIVERS[name]
    subprocess.run(["systemctl", "--user", "stop", UNIT], capture_output=True)
    print(f"driver: {name} ({d['about']}). " + ("Downloaded; the next `sakura-model up` runs it." if os.path.isfile(os.path.join(MODEL_DIR, d["file"])) else "Not downloaded yet: sakura-model pull"))
    return 0


def advise():
    """whatmodel.sh's list for this machine, next to what Sakura runs. A lookup the user asks for, sending RAM and VRAM only."""
    ram_kib = int(open("/proc/meminfo").readline().split()[1])
    v = vram()
    url = f"https://whatmodel.sh/?ram={ram_kib}&vram={v[0] if v else 0}&n=15&format=json"
    try:
        data = json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "curl/8"}), timeout=20))
    except Exception as e:
        print(f"sakura-model: whatmodel.sh didn't answer: {e}", file=sys.stderr)
        return 1
    print(f"whatmodel.sh for {ram_kib // 1048576} GiB RAM and {v[0] if v else 0} MiB VRAM (its scores, measured elsewhere):")
    mine = {"Qwen3.6 35B-A3B": "the driver (qwen36)", "Ornith 1.5 35B-A3B": "driver candidate (sakura-model driver ornith15)",
            "Qwen3.5 9B": "the fallback 9b", "Spark-X2.6 4B": "fast-tier candidate"}
    for m in data.get("models", []):
        sp = m.get("speed") or {}
        tag = next((v for k, v in mine.items() if k.lower() in m["name"].lower()), "")
        print(f"  {m.get('rank', '?'):>4}  {m['name']:<34} {m.get('score', 0):>5.1f}  ~{m.get('need_gb', '?')} GB  {str(sp.get('value', '')) + ' tok/s' if sp else '':<10} {tag}")
    print("A higher score isn't a better Sakura: the driver has to call tools in the qwen-code shape and pass evals/run.py here. "
          "To use one: `sakura-model pick ROLE` (agent, fast, vision, a consult role or the driver) offers this list in its menu.")
    return 0


def pull():
    if os.path.isfile(MODEL) and (SIZE is None or os.path.getsize(MODEL) == SIZE):
        print("already downloaded; verifying")
    else:
        os.makedirs(MODEL_DIR, exist_ok=True)
        part = MODEL + ".part"
        url = f"{HF}/{REPO}/resolve/{REVISION or 'main'}/{FILENAME}"
        print(f"downloading {SIZE / 2**30:.1f} GiB to {MODEL_DIR}" if SIZE else f"downloading {FILENAME} to {MODEL_DIR}")
        if subprocess.run(["curl", "-fL", "-C", "-", "--retry", "5", "--retry-delay", "5", "-o", part, url]).returncode:
            return 1
        os.replace(part, MODEL)
    h = hashlib.sha256()
    with open(MODEL, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 24), b""):
            h.update(chunk)
    if SHA256 is None:
        # a driver you added: trust on first download, then hold it to that
        d = CHOICES.load()
        d["drivers"][driver_name()].update({"sha256": h.hexdigest(), "size": os.path.getsize(MODEL)})
        CHOICES.save(d)
        print(f"checksum pinned: {h.hexdigest()} (every later pull is held to it)")
        return 0
    if h.hexdigest() != SHA256:
        os.replace(MODEL, MODEL + ".bad")
        print(f"CHECKSUM MISMATCH, not using it (moved to {MODEL}.bad)", file=sys.stderr)
        return 1
    print("checksum OK")
    return 0


BIN = os.path.dirname(os.path.realpath(__file__))
PULL_UNIT = "sakura-models"
DISK_MARGIN_GIB = 10    # left free after the downloads, so a full disk never breaks the desktop


def ollama_models():
    """Ollama models Sakura uses, most needed first: (name, what for, min RAM GiB, download GiB).
    Names come from where they're used (sakura-launch, consult, rag), so this list can't drift from them."""
    from importlib.machinery import SourceFileLoader
    roles = {r: CHOICES.get(r) for r in ("coder", "coder-fast", "reason", "security", "prose")}  # your picks, else the defaults
    rag, big, fast = CHOICES.get("embed"), CHOICES.get("agent"), CHOICES.get("fast")
    # RAM floors: the model loaded beside a desktop. Sizes: the Q4 downloads, measured 2026-11.
    return [
        (big, "the agent when the driver can't run, and the intent check", 0, 6.6),
        (rag, "rag search", 0, 0.7),
        (fast, "SAKURA_FAST=1: Spark-X2.6 4B, 28/30 on evals/run.py, median 8 s", 0, 4.4),
        (roles["coder-fast"], "consult coder-fast", 0, 1.9),
        (CHOICES.get("vision"), "look (images, screenshots, scans)", 0, 3.2),
        (roles["security"], "consult security", 16, 4.7),
        (roles["prose"], "consult prose", 16, 4.9),
        (roles["coder"], "consult coder", 24, 9.0),
        (roles["reason"], "consult reason", 24, 9.0),
    ]


def ollama_have():
    try:
        tags = json.loads(urllib.request.urlopen(os.environ.get("OLLAMA_API_BASE", "http://127.0.0.1:11434") + "/api/tags", timeout=5).read())
    except Exception:
        return None
    names = set()
    for m in tags.get("models", []):
        names.add(m["name"])
        if m["name"].endswith(":latest"):
            names.add(m["name"][:-7])
    return names


def free_gib(path):
    while path and not os.path.exists(path):
        path = os.path.dirname(path)
    return shutil.disk_usage(path or "/").free / 2**30


def model_plan():
    """[(name, why, size GiB, state)] for this machine. state: have | missing | skip: reason."""
    have = ollama_have()
    ram = ram_gib()
    rows = []
    for name, why, min_ram, size in ollama_models():
        if have is not None and name in have:
            rows.append((name, why, size, "have"))
        elif ram < min_ram:
            rows.append((name, why, size, f"skip: {ram:.0f} GiB RAM, needs {min_ram}"))
        else:
            rows.append((name, why, size, "missing"))
    ok, reason, cache = plan()
    gib = (SIZE or 0) / 2**30
    if ok or (os.path.isfile(MODEL) and (SIZE is None or os.path.getsize(MODEL) == SIZE)):  # a busy card today doesn't make the file missing
        rows.append((FILENAME, "the driver, on this machine's GPU", gib, "have"))
    elif cache:  # qualifies, only the file is missing
        rows.append((FILENAME, "the driver, on this machine's GPU", gib, "missing"))
    else:
        rows.append((FILENAME, "the driver, on this machine's GPU", gib, f"skip: {reason}"))
    return rows, have


def models():
    rows, have = model_plan()
    if have is None:
        print("Ollama isn't answering, so its models can't be checked: sudo systemctl start ollama")
    for name, why, size, state in rows:
        print(f"  {state:8.60s}  {size:5.1f} GiB  {name}  ({why})")
    return 0


def pull_all(background=False):
    if background:
        if subprocess.run(["systemctl", "--user", "is-active", "--quiet", PULL_UNIT]).returncode == 0:
            print(f"already downloading: journalctl --user -u {PULL_UNIT}")
            return 0
        subprocess.run(["systemctl", "--user", "reset-failed", PULL_UNIT], capture_output=True)
        # A unit doesn't inherit this shell, so the overrides that choose the models go with it.
        keep = ("SAKURA_RAG_MODEL", "SAKURA_BIG_MODEL", "SAKURA_FAST_MODEL", "SAKURA_MODEL_DIR", "OLLAMA_API_BASE", "OLLAMA_MODELS", "NTFY_TOPIC", "NTFY_SERVER")
        env = [f"--setenv={k}={os.environ[k]}" for k in keep if k in os.environ]
        r = subprocess.run(["systemd-run", "--user", f"--unit={PULL_UNIT}", "--collect", "--quiet", "--nice=10",
                            "-p", "IOSchedulingClass=idle", *env, os.path.realpath(__file__), "pull-all"])
        if r.returncode == 0:
            print(f"downloading Sakura's models in the background: journalctl --user -fu {PULL_UNIT}")
        return r.returncode
    rows, have = model_plan()
    if have is None:
        print("sakura-model: Ollama isn't answering; start it (sudo systemctl start ollama) and run sakura-model pull-all", file=sys.stderr)
        return 1
    ollama_dir = os.environ.get("OLLAMA_MODELS") or ("/usr/share/ollama/.ollama/models" if os.path.isdir("/usr/share/ollama") else os.path.expanduser("~/.ollama/models"))
    got, skipped, failed = [], [], []
    for name, why, size, state in rows:
        if state != "missing":
            continue
        where = MODEL_DIR if name == FILENAME else ollama_dir
        if free_gib(where) - size < DISK_MARGIN_GIB:
            skipped.append(f"{name} ({size:.1f} GiB; {free_gib(where):.0f} GiB free, keeping {DISK_MARGIN_GIB})")
            continue
        print(f"pulling {name} ({size:.1f} GiB): {why}", flush=True)
        rc = pull() if name == FILENAME else subprocess.run(["ollama", "pull", name]).returncode
        (failed if rc else got).append(name)
    for s in skipped:
        print(f"skipped, not enough disk: {s}")
    for f in failed:
        print(f"failed: {f}; sakura-model pull-all retries it", file=sys.stderr)
    if got or failed or skipped:
        msg = f"{len(got)} downloaded" + (f", {len(failed)} failed" if failed else "") + (f", {len(skipped)} skipped for disk" if skipped else "")
        print(msg)
        notify = os.path.join(BIN, "notify")
        if os.access(notify, os.X_OK):
            subprocess.run([notify, "Sakura models", msg + ". sakura-model models shows the rest."], capture_output=True)
    else:
        print("every model that suits this machine is here")
    return 1 if failed else 0


def whatmodel_list(n=15):
    """whatmodel.sh's ranking for this RAM and VRAM: [{name, score, need_gb, tok_s, tag}]. Sends those two numbers, nothing else."""
    ram_kib = int(open("/proc/meminfo").readline().split()[1])
    v = vram()
    sep = "&" if "?" in WHATMODEL else "?"
    url = f"{WHATMODEL}{sep}ram={ram_kib}&vram={v[0] if v else 0}&n={n}&format=json"
    data = json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "curl/8"}), timeout=20))
    out = []
    for m in data.get("models", []):
        sp = m.get("speed") or {}
        tag = m.get("ollama") or m.get("ollama_tag") or m.get("tag")
        repo = m.get("hf") or m.get("hf_repo") or m.get("repo") or m.get("gguf")
        if not tag and repo:
            repo = re.sub(r"^https?://huggingface\.co/", "", repo).strip("/")
            tag = f"hf.co/{repo}" + ("" if ":" in repo else f":{m.get('quant') or 'Q4_K_M'}")
        out.append({"name": m.get("name", "?"), "score": m.get("score"), "need_gb": m.get("need_gb"), "tok_s": sp.get("value"), "tag": tag})
    return out


def hf_gguf_for(name):
    """The most-downloaded GGUF repo on Hugging Face for a model name, as an Ollama hf.co tag; None if there isn't one."""
    q = re.sub(r"[\s_]+", "-", name.strip())
    url = f"{HF}/api/models?search={urllib.parse.quote(q)}&filter=gguf&sort=downloads&direction=-1&limit=1"
    try:
        hits = json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "sakura-model"}), timeout=20))
    except Exception:
        return None
    return f"hf.co/{hits[0]['id']}:Q4_K_M" if hits else None


def ollama_pull(tag):
    print(f"pulling {tag} …", flush=True)
    return subprocess.run(["ollama", "pull", tag]).returncode


def note_for(role, tag):
    """One line of what to expect; nothing is refused."""
    kind = CHOICES.ROLES[role][3] if role in CHOICES.ROLES else "driver"
    tested = any(t == tag for t, _ in CHOICES.KNOWN.get(role, []))
    bits = []
    if not tested and kind in ("chat", "driver"):
        bits.append("untested with Sakura's tools here: `evals/run.py --model " + (tag if kind == "chat" else "qwen36-q3") + "` measures it")
    if "abliterat" not in tag.lower() and "uncensored" not in tag.lower() and kind in ("chat", "consult", "driver"):
        bits.append("a stock model may refuse some of your requests (Sakura's defaults are abliterated)")
    if role == "embed":
        bits.append("rag's index was made with the old one: `rag index` your folders again")
    return "; ".join(bits)


def set_role(role, tag, pull_it):
    d = CHOICES.load()
    if tag is None:
        d["roles"].pop(role, None)
        CHOICES.save(d)
        print(f"{role}: back to Sakura's default, {CHOICES.ROLES[role][1]}")
        return 0
    d["roles"][role] = tag
    CHOICES.save(d)
    env = CHOICES.ROLES[role][0]
    print(f"{role}: {tag}" + (f"  (${env} is set in this shell and still wins)" if os.environ.get(env) else ""))
    n = note_for(role, tag)
    if n:
        print("  " + n)
    if CHOICES.ROLES[role][3] == "chat":
        CHOICES.catalog()  # so the picked model gets Sakura's prompt and context window
    have = ollama_have()
    if have is not None and tag not in have:
        if pull_it:
            return ollama_pull(tag)
        print(f"  not downloaded yet: sakura-model pull-all, or ollama pull {tag}")
    return 0


def set_driver(spec):
    """hf.co/OWNER/REPO:FILE.gguf (or OWNER/REPO:FILE.gguf, or a NAME already known)."""
    if spec in DRIVERS:
        return driver([spec])
    m = re.match(r"^(?:hf\.co/|https?://huggingface\.co/)?([\w.-]+/[\w.-]+)[:/](.+\.gguf)$", spec)
    if not m:
        print("sakura-model: a driver is hf.co/OWNER/REPO:FILE.gguf, or one of: " + ", ".join(DRIVERS), file=sys.stderr)
        return 2
    repo, file = m.groups()
    name = re.sub(r"[^\w]+", "-", file.rsplit(".", 1)[0]).strip("-").lower()[:40]
    d = CHOICES.load()
    d["drivers"][name] = {"repo": repo, "file": file, "revision": "main", "size": None, "sha256": None}
    CHOICES.save(d)
    os.makedirs(os.path.dirname(DRIVER_FILE), exist_ok=True)
    open(DRIVER_FILE, "w").write(name + "\n")
    subprocess.run(["systemctl", "--user", "stop", UNIT], capture_output=True)
    print(f"driver: {name} ({repo}/{file}), yours")
    print("  " + note_for("driver", file) + "; the VRAM budget was measured on 35B-A3B MoE models, so another shape may need SAKURA_CACHE_MIB")
    print("  download it: sakura-model pull  (its checksum is pinned on that first download)")
    return 0


def ask(prompt):
    try:
        return input(prompt).strip()
    except EOFError:
        return ""


def pick(args):
    pull_it = "--pull" in args
    use_whatmodel = "--whatmodel" in args
    args = [a for a in args if a not in ("--pull", "--whatmodel")]
    if not args:
        rows = [(r, CHOICES.get(r), CHOICES.source(r), why) for r, (_, _, why, _) in CHOICES.ROLES.items()]
        rows.append(("driver", driver_name(), "yours" if DRIVERS[driver_name()].get("user") or os.path.exists(DRIVER_FILE) else "default", "the GPU driver (llama-server), where the machine qualifies"))
        w = max(len(r[1]) for r in rows)
        print(f"{'ROLE':<11} {'MODEL'.ljust(w)}  {'FROM':<8} FOR")
        for r, tag, src, why in rows:
            print(f"{r:<11} {tag.ljust(w)}  {src:<8} {why}")
        print("\nchange one: sakura-model pick ROLE   (a menu, with whatmodel.sh's ranking for this machine)")
        return 0
    role = args[0]
    if role == "driver":
        if len(args) > 1:
            return set_driver(args[1])
        cands = [(n, d["about"]) for n, d in DRIVERS.items()]
    elif role not in CHOICES.ROLES:
        print(f"sakura-model: no role {role}; one of: {', '.join(CHOICES.ROLES)}, driver", file=sys.stderr)
        return 2
    else:
        if len(args) > 1:
            return set_role(role, None if args[1] == "--default" else args[1], pull_it)
        cands = list(CHOICES.KNOWN.get(role, []))
        have = ollama_have() or set()
        known = {t for t, _ in cands}
        pulled = sorted({t[:-7] if t.endswith(":latest") else t for t in have} - known)
        cands += [(t, "already in Ollama") for t in pulled][:12]
    print(f"{role}: now {CHOICES.get(role) if role != 'driver' else driver_name()}\n")
    for i, (tag, why) in enumerate(cands, 1):
        print(f"  {i:>2}  {tag:<58} {why}")
    if role != "driver" and CHOICES.ROLES[role][3] in ("chat", "consult", "vision"):
        if use_whatmodel or ask("\nadd whatmodel.sh's ranking for this machine? It's sent your RAM and VRAM, nothing else [Y/n] ").lower() in ("", "y", "yes"):
            try:
                wm = whatmodel_list()
            except Exception as e:
                print(f"  (whatmodel.sh didn't answer: {e})")
                wm = []
            if wm:
                print("\n  whatmodel.sh, for this machine (its scores, measured elsewhere):")
            for m in wm:
                cands.append((m["tag"] or f"?{m['name']}", f"whatmodel.sh {m['score']}  ~{m['need_gb']} GB" + (f"  {m['tok_s']} tok/s" if m["tok_s"] else "")))
                i = len(cands)
                print(f"  {i:>2}  {(m['tag'] or m['name'] + '  (looked up on Hugging Face if picked)'):<58} {cands[-1][1]}")
    choice = ask("\nnumber, any Ollama tag or hf.co/… (Enter keeps it): ")
    if not choice:
        print("unchanged")
        return 0
    if choice.isdigit() and 1 <= int(choice) <= len(cands):
        tag = cands[int(choice) - 1][0]
    else:
        tag = choice
    if tag.startswith("?"):
        found = hf_gguf_for(tag[1:])
        if not found:
            print(f"no GGUF of “{tag[1:]}” found on Hugging Face; type its Ollama tag or hf.co/OWNER/REPO:QUANT instead", file=sys.stderr)
            return 1
        if ask(f"use {found}? [Y/n] ").lower() not in ("", "y", "yes"):
            print("unchanged")
            return 0
        tag = found
    if role == "driver":
        return set_driver(tag)
    if not pull_it and ollama_have() is not None and tag not in (ollama_have() or set()):
        pull_it = ask(f"download {tag} now? [Y/n] ").lower() in ("", "y", "yes")
    return set_role(role, tag, pull_it)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "plan"
    if cmd in ("-h", "--help"):
        print(__doc__)
        return 0
    if cmd == "plan":
        ok, reason, _ = plan()
        print(f"{SLUG}: {reason}" if ok else f"9b on Ollama: {reason}")
        return 0
    if cmd == "up":
        return up()
    if cmd == "down":
        subprocess.run(["systemctl", "--user", "stop", UNIT], capture_output=True)
        return 0
    if cmd == "status":
        v = vram()
        print(("up" if healthy() else "down"), f"at {URL}", f"VRAM {v[1]}/{v[0]} MiB" if v else "")
        return 0
    if cmd == "gpu":
        return gpu(check="--check" in sys.argv[2:])
    if cmd == "driver":
        return driver(sys.argv[2:])
    if cmd == "pick":
        return pick(sys.argv[2:])
    if cmd == "get" and len(sys.argv) > 2:
        if sys.argv[2] == "driver":
            print(driver_name())
            return 0
        if sys.argv[2] not in CHOICES.ROLES:
            print(f"sakura-model: no role {sys.argv[2]}", file=sys.stderr)
            return 2
        print(CHOICES.get(sys.argv[2]))
        return 0
    if cmd == "advise":
        return advise()
    if cmd == "pull":
        return pull()
    if cmd == "models":
        return models()
    if cmd == "pull-all":
        return pull_all(background="--background" in sys.argv[2:])
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())
