#!/usr/bin/env python3
"""logs [HOST] [--since 1h] [--unit NAME] [--all] — the errors on a machine, as a table, grouped, with no model.

  logs                      this machine: journald errors (priority err and worse) in the last hour, grouped by message
  logs starlight            the same over ssh
  logs starlight --since 24h --unit nginx
  logs starlight --files    also the usual log files: nginx error.log, php-fpm, Laravel storage/logs, mysql, postgres, docker containers
  logs --raw                the lines themselves, newest last, not grouped
  logs starlight --follow   stream new errors as they happen, grouped every few seconds (Ctrl-C stops)
  logs mute "pattern"       hide lines matching it (regex, against source and message) from every listing; per machine
  logs mutes | unmute N     what's muted, with hit counts since muting | stop hiding one
  logs --no-mute            show everything, mutes ignored
  logs --json
Output: count, first seen, last seen, unit or file, message (digits, hex ids and paths collapsed so repeats group). Pipe
to `tbl --md` for a report. Sakura uses this for "ssh in and show me the errors": it's the command, not a dig.
"""
import json
import os
import re
import shlex
import subprocess
import sys
import time

FILES = [
    "/var/log/nginx/error.log", "/var/log/apache2/error.log", "/var/log/php*-fpm.log", "/var/log/php/*.log", "/var/log/mysql/error.log",
    "/var/log/postgresql/*.log", "/var/log/syslog", "/var/log/messages", "/var/www/*/storage/logs/laravel*.log", "/srv/*/storage/logs/laravel*.log",
    "/home/*/*/storage/logs/laravel*.log", "/var/log/supervisor/*.log", "/var/log/caddy/*.log",
]
LEVEL = re.compile(r"\b(?:ERROR|CRITICAL|ALERT|EMERGENCY|FATAL|error|crit|emerg|\[error\]|\[crit\]|\.ERROR:|\.CRITICAL:|Exception|Traceback)\b")
NOISE = [(re.compile(r"0x[0-9a-f]{4,}"), "0x…"), (re.compile(r"\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b"), "<uuid>"),
         (re.compile(r"\b[0-9a-f]{12,}\b"), "<hex>"), (re.compile(r"\b\d{1,3}(?:\.\d{1,3}){3}\b"), "<ip>"), (re.compile(r"\b\d+\b"), "N"),
         (re.compile(r"(/[\w.-]+){3,}"), "<path>"), (re.compile(r"\s+"), " ")]


def collapse(msg):
    for rx, rep in NOISE:
        msg = rx.sub(rep, msg)
    return msg.strip()[:160]


def remote(host, script):
    cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", host, script] if host else ["bash", "-c", script]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        sys.exit(f"logs: {host or 'local'} didn't answer in time")
    if r.returncode and not r.stdout.strip():
        sys.exit(f"logs: {host or 'local'}: {r.stderr.strip()[-300:] or 'no output'}")
    return r.stdout


def journal(host, since, unit):
    script = f"journalctl --no-pager -q -p err -o json --since '-{since}'" + (f" -u {shlex.quote(unit)}" if unit else "") + " 2>/dev/null || sudo -n journalctl --no-pager -q -p err -o json --since '-{since}' 2>/dev/null"
    out = remote(host, script)
    rows = []
    for line in out.splitlines():
        try:
            d = json.loads(line)
        except ValueError:
            continue
        msg = d.get("MESSAGE")
        if isinstance(msg, list):
            msg = bytes(msg).decode("utf-8", "replace")
        ts = int(d.get("__REALTIME_TIMESTAMP", "0")) // 1000000
        unit = d.get("_SYSTEMD_UNIT") or ""
        if not unit or re.fullmatch(r"(?:user@\d+|session-\w+|init)\.(?:service|scope)", unit):  # a user session's unit says nothing: use the program
            unit = d.get("SYSLOG_IDENTIFIER") or d.get("_COMM") or unit or "?"
        rows.append((ts, unit, str(msg or "")))
    return rows


def files(host, since):
    mins = {"m": 1, "h": 60, "d": 1440}
    m = re.fullmatch(r"(\d+)([mhd])", since)
    minutes = int(m.group(1)) * mins[m.group(2)] if m else 60
    pats = " ".join(FILES)
    script = (f"for f in {pats}; do [ -r \"$f\" ] || continue; find \"$f\" -mmin -{minutes} 2>/dev/null | grep -q . || continue; "
              f"tail -n 400 \"$f\" 2>/dev/null | grep -aE 'ERROR|CRITICAL|ALERT|EMERGENCY|FATAL|\\[error\\]|\\[crit\\]|error|Exception|Traceback' | sed \"s|^|$f\\t|\"; done")
    out = remote(host, script)
    rows = []
    for line in out.splitlines():
        if "\t" not in line:
            continue
        f, msg = line.split("\t", 1)
        if LEVEL.search(msg):
            ts = re.search(r"(20\d\d[-/]\d\d[-/]\d\d[ T]\d\d:\d\d:\d\d)", msg)
            rows.append((ts.group(1) if ts else "", f.split("/")[-1], msg.strip()))
    return rows


def fmt_ts(ts):
    if isinstance(ts, int):
        import datetime as dt
        return dt.datetime.fromtimestamp(ts).strftime("%m-%d %H:%M") if ts else ""
    return ts[5:16] if ts else ""


def follow(host, unit):
    """New journald errors as they come, grouped and re-printed every few seconds."""
    import time
    script = "journalctl --no-pager -q -p err -o json -f -n 0" + (f" -u {shlex.quote(unit)}" if unit else "")
    cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", host, script] if host else ["bash", "-c", script]
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    groups, last_print = {}, time.time()
    print(f"following errors on {host or 'this machine'}" + (f" for {unit}" if unit else "") + " (Ctrl-C stops)", flush=True)
    try:
        import select
        while True:
            ready, _, _ = select.select([p.stdout], [], [], 1.0)
            if ready:
                line = p.stdout.readline()
                if not line:
                    break
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                msg = d.get("MESSAGE")
                if isinstance(msg, list):
                    msg = bytes(msg).decode("utf-8", "replace")
                unit_ = d.get("_SYSTEMD_UNIT") or ""
                if not unit_ or re.fullmatch(r"(?:user@\d+|session-\w+|init)\.(?:service|scope)", unit_):
                    unit_ = d.get("SYSLOG_IDENTIFIER") or d.get("_COMM") or unit_ or "?"
                key = (unit_, collapse(str(msg or "")))
                g = groups.setdefault(key, {"count": 0, "example": str(msg or ""), "last": 0})
                g["count"] += 1
                g["last"] = time.time()
            if groups and time.time() - last_print >= 3:
                last_print = time.time()
                print("\033[H\033[2J" if sys.stdout.isatty() else "", end="")
                print("count\tlast\tsource\tmessage")
                for (src, _), g in sorted(groups.items(), key=lambda kv: -kv[1]["last"])[:40]:
                    print(f"{g['count']}\t{time.strftime('%H:%M:%S', time.localtime(g['last']))}\t{src}\t{' '.join(g['example'].split())[:160]}", flush=True)
            if p.poll() is not None and not ready:
                break
    except KeyboardInterrupt:
        pass
    finally:
        p.terminate()
    return 0


MUTES = os.path.join(os.environ.get("SAKURA_HOME", os.path.expanduser("~/.sakura")), "logs-mutes.json")


def load_mutes():
    try:
        d = json.load(open(MUTES))
        return d.get("items", [])
    except (OSError, ValueError):
        return []


def save_mutes(items):
    os.makedirs(os.path.dirname(MUTES), exist_ok=True)
    json.dump({"v": 1, "items": items}, open(MUTES, "w"), indent=1)


def apply_mutes(rows, count=True):
    mutes = load_mutes()
    if not mutes:
        return rows
    keep, hit = [], False
    rx = [(m, re.compile(m["pattern"])) for m in mutes]
    for ts, src, msg in rows:
        m = next((mu for mu, r in rx if r.search(f"{src} {msg}")), None)
        if m is None:
            keep.append((ts, src, msg))
        elif count:
            m["hits"] = m.get("hits", 0) + 1
            hit = True
    if hit:
        save_mutes(mutes)
    return keep


def cmd_mute(args):
    if not args:
        sys.exit('usage: logs mute "pattern"')
    pattern = " ".join(args)
    try:
        re.compile(pattern)
    except re.error as e:
        sys.exit(f"logs: not a valid regex: {e}")
    items = load_mutes()
    if any(m["pattern"] == pattern for m in items):
        sys.exit("logs: already muted")
    items.append({"pattern": pattern, "added": time.strftime("%Y-%m-%d"), "hits": 0})
    save_mutes(items)
    print(f"muted ({len(items)} total): {pattern}   (logs mutes to review; logs --no-mute to peek past them)")


def cmd_mutes(_):
    items = load_mutes()
    if not items:
        print("nothing muted")
        return
    for i, m in enumerate(items, 1):
        print(f"{i}  {m['added']}  {m.get('hits', 0):>6} hidden  {m['pattern']}")


def cmd_unmute(args):
    items = load_mutes()
    if not args or not args[0].isdigit() or not 1 <= int(args[0]) <= len(items):
        sys.exit("usage: logs unmute N   (from: logs mutes)")
    gone = items.pop(int(args[0]) - 1)
    save_mutes(items)
    print(f"unmuted: {gone['pattern']}")


def main(argv):
    if argv[:1] == ["mute"]:
        return cmd_mute(argv[1:])
    if argv[:1] == ["mutes"]:
        return cmd_mutes(argv[1:])
    if argv[:1] == ["unmute"]:
        return cmd_unmute(argv[1:])
    no_mute = "--no-mute" in argv
    argv = [a for a in argv if a != "--no-mute"]
    host, since, unit, want_files, raw, as_json = None, "1h", None, False, False, False
    if "--follow" in argv:
        argv = [a for a in argv if a != "--follow"]
        host = next((a for a in argv if not a.startswith("-") and a not in ("1h",)), None) if argv and not argv[0].startswith("-") else None
        unit = argv[argv.index("--unit") + 1] if "--unit" in argv else None
        return follow(host, unit)
    it = iter(argv)
    for a in it:
        if a == "--since":
            since = next(it, "1h")
        elif a == "--unit":
            unit = next(it, None)
        elif a in ("--files", "--all"):
            want_files = True
        elif a == "--raw":
            raw = True
        elif a == "--json":
            as_json = True
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        elif host is None and not a.startswith("-"):
            host = a
    rows = journal(host, since, unit)
    if want_files:
        rows += files(host, since)
    if not no_mute:
        rows = apply_mutes(rows)
    if not rows:
        print(f"no errors on {host or 'this machine'} in the last {since}" + (f" for {unit}" if unit else ""))
        return 0
    if raw:
        for ts, src, msg in rows:
            print(f"{fmt_ts(ts)}  {src}  {msg}")
        return 0
    groups = {}
    for ts, src, msg in rows:
        key = (src, collapse(msg))
        g = groups.setdefault(key, {"count": 0, "first": ts, "last": ts, "example": msg})
        g["count"] += 1
        g["first"], g["last"] = min(g["first"], ts, key=lambda x: str(x)), max(g["last"], ts, key=lambda x: str(x))
    items = sorted(groups.items(), key=lambda kv: -kv[1]["count"])
    if as_json:
        print(json.dumps([{"count": g["count"], "first": fmt_ts(g["first"]), "last": fmt_ts(g["last"]), "source": k[0], "message": g["example"]} for k, g in items], indent=1))
        return 0
    print("count\tfirst\tlast\tsource\tmessage")
    for (src, _), g in items:
        print(f"{g['count']}\t{fmt_ts(g['first'])}\t{fmt_ts(g['last'])}\t{src}\t{' '.join(g['example'].split())[:220]}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
