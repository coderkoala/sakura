#!/usr/bin/env python3
"""sakura-complete — bash completion for every Sakura command, generated from the commands' own manuals. No list to keep by hand.

  eval "$(sakura-complete)"        in ~/.bashrc (shell/sakura.bash does this); Tab then completes `conv <Tab>` → merge split pages…,
                                   `vault <Tab>`, `money <Tab>`, `--flags`, and files where a tool takes one
  sakura-complete --show conv      what it learned for one command
  sakura-complete --json           every command's subcommands and flags
How: a manual line that starts with the command's own name is a usage line; its second word is a subcommand when it's a plain
lowercase word (merge, import, archive), and every --flag anywhere in the manual is a flag. Hosts for `ports HOST`, `drift … HOST`
and `?on` come from ssh's config. Kept tools (sakura-tool) complete by name.
"""
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
BIN = os.path.join(ROOT, "bin")
HOST_TOOLS = {"ports", "drift", "logs", "sakura-on", "fleet"}
HAND_DONE = {"pa", "sakura-tonight", "sakura-guardian", "logs", "sakura-on"}  # shell/sakura.bash completes these by hand; leave them
STOPWORDS = {"the", "a", "an", "is", "are", "what", "which", "who", "when", "how", "and", "or", "to", "of", "in", "on", "for", "with", "that", "this", "it", "its", "your", "my", "then", "every", "one", "any", "all", "just"}
PLACEHOLDER = re.compile(r"^(?:[A-Z][A-Z0-9_.-]*|<[^>]+>|\[.*|FILE.*|URL.*|DIR.*|PATH.*|\".*|'.*|-)$")


def header(path):
    try:
        lines = open(path, encoding="utf-8", errors="replace").read().splitlines()
    except OSError:
        return []
    out = []
    if len(lines) > 1 and lines[1].startswith('"""'):
        body = lines[1][3:]
        if body.rstrip().endswith('"""'):
            return [body.rstrip()[:-3]]
        out.append(body)
        for l in lines[2:]:
            if '"""' in l:
                out.append(l.split('"""')[0])
                break
            out.append(l)
    else:
        for l in lines[1:]:
            if l.startswith("#"):
                out.append(l.lstrip("#"))
            elif l.strip():
                break
    return out


def learn(name, manual):
    subs, flags = [], []
    for l in manual:
        for w in re.findall(r"(?<![\w-])(--[a-z][\w-]*)", l):
            if w not in flags and w not in ("--", "--to"):
                flags.append(w)
        if "--to" in l and "--to" not in flags:
            flags.append("--to")
        m = re.match(rf"\s*(?:\?)?{re.escape(name)}\s+([a-z][\w-]*)(?:\s|$|\|)", l)
        if m:
            sub = m.group(1)
            if sub not in subs and not PLACEHOLDER.match(sub) and len(sub) > 1 and sub not in STOPWORDS:
                subs.append(sub)
        # "merge|split|pages" alternations on one line
        m2 = re.match(rf"\s*{re.escape(name)}\s+([a-z][\w-]*(?:\|[a-z][\w-]*)+)", l)
        if m2:
            for sub in m2.group(1).split("|"):
                if sub not in subs and sub not in STOPWORDS:
                    subs.append(sub)
    return subs, flags


def table():
    out = {}
    for n in sorted(os.listdir(BIN)):
        p = os.path.join(BIN, n)
        if os.path.isfile(p) and os.access(p, os.X_OK):
            h = header(p)
            if h:
                subs, flags = learn(n, h)
                out[n] = {"subs": subs, "flags": flags}
    return out


def script(t):
    lines = ["# generated by sakura-complete; eval \"$(sakura-complete)\"",
             "__sakura_c_hosts() { awk 'tolower($1)==\"host\"{for(i=2;i<=NF;i++) if ($i !~ /[*?]/) print $i}' ~/.ssh/config 2>/dev/null; }",
             "__sakura_c() {",
             "  local cmd=${COMP_WORDS[0]##*/} cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]} subs flags hosts=0",
             "  case \"$cmd\" in"]
    for n, d in t.items():
        if n in HAND_DONE:
            continue
        subs = " ".join(d["subs"])
        flags = " ".join(d["flags"])
        hosts = "1" if n in HOST_TOOLS else "0"
        lines.append(f"    {n}|?{n.replace('sakura-', '')}) subs='{subs}'; flags='{flags}'; hosts={hosts} ;;")
    lines += ["    *) subs=''; flags='' ;;",
              "  esac",
              "  if [[ $cur == -* ]]; then COMPREPLY=($(compgen -W \"$flags\" -- \"$cur\")); return; fi",
              "  if [[ $COMP_CWORD -eq 1 && -n $subs ]]; then COMPREPLY=($(compgen -W \"$subs\" -- \"$cur\") $(compgen -f -- \"$cur\")); return; fi",
              "  if [[ $hosts -eq 1 ]]; then COMPREPLY=($(compgen -W \"$(__sakura_c_hosts)\" -- \"$cur\") $(compgen -f -- \"$cur\")); return; fi",
              "  COMPREPLY=($(compgen -f -- \"$cur\"))",
              "}",
              "complete -o filenames -F __sakura_c " + " ".join(n for n in t if n not in HAND_DONE) + " 2>/dev/null"]
    keys = [f"?{n.replace('sakura-', '')}" for n in t if n.startswith("sakura-") and n not in HAND_DONE] + ["?what", "?otp", "?docs", "?last"]
    lines.append("complete -o filenames -F __sakura_c " + " ".join(f"'{k}'" for k in keys) + " 2>/dev/null")
    return "\n".join(lines) + "\n"


def main():
    a = sys.argv[1:]
    if a and a[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    t = table()
    if a == ["--json"]:
        print(json.dumps(t, indent=1))
        return 0
    if len(a) == 2 and a[0] == "--show":
        d = t.get(a[1])
        if not d:
            print(f"sakura-complete: no command {a[1]}", file=sys.stderr)
            return 1
        print(f"{a[1]}: subcommands: {' '.join(d['subs']) or '(none)'}\n{' ' * len(a[1])}  flags: {' '.join(d['flags']) or '(none)'}")
        return 0
    sys.stdout.write(script(t))
    return 0


if __name__ == "__main__":
    sys.exit(main())
