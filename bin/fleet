#!/usr/bin/env python3
"""fleet — the user's machines, as one thing. Which are up, what each is for, which has the GPU or RAM free, run it there.

  fleet                      every host from ~/.ssh/config (and its Include files): up or not, load, free RAM, GPU
  fleet HOST                 one host in detail
  fleet pick gpu|ram|cpu     the reachable host with the most free of it (prints its name; use it in a command)
  fleet run "COMMAND"        the command on every reachable host, in parallel, each line prefixed with the host
  fleet note HOST "what it's for"   remembered in ~/.sakura/fleet.json and shown in the list
Hosts are whatever ssh knows; github.com and wildcards are skipped. A host that doesn't answer in 6 s is down for this
list; a refused login stays refused (shims/ssh): fleet never tries another key or password.
"""
import concurrent.futures
import glob
import json
import os
import re
import subprocess
import sys

NOTES = os.path.join(os.environ.get("SAKURA_HOME", os.path.expanduser("~/.sakura")), "fleet.json")
SKIP = re.compile(r"github\.com|gitlab\.com|bitbucket\.org|\*|\?")
PROBE = ("hostname; nproc; awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo; cut -d' ' -f1 /proc/loadavg; "
         "(nvidia-smi --query-gpu=name,memory.used,memory.total,temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -1) || true")


def hosts():
    seen, out = set(), []

    def read(path):
        try:
            text = open(os.path.expanduser(path), encoding="utf-8", errors="replace").read()
        except OSError:
            return
        for line in text.splitlines():
            m = re.match(r"\s*Include\s+(.+)", line, re.I)
            if m:
                for pat in m.group(1).split():
                    pat = os.path.expanduser(pat)
                    if not pat.startswith("/"):
                        pat = os.path.expanduser("~/.ssh/" + pat)
                    for p in sorted(glob.glob(pat)):
                        read(p)
            m = re.match(r"\s*Host\s+(.+)", line, re.I)
            if m:
                for h in m.group(1).split():
                    if not SKIP.search(h) and h not in seen:
                        seen.add(h)
                        out.append(h)
    read(os.environ.get("SAKURA_SSH_CONFIG", "~/.ssh/config"))
    return out


def notes():
    try:
        return json.load(open(NOTES))
    except (OSError, ValueError):
        return {}


def probe(host):
    try:
        r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", host, PROBE], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return host, None
    if r.returncode != 0 or not r.stdout.strip():
        return host, None
    lines = r.stdout.strip().splitlines()
    info = {"hostname": lines[0] if lines else "?", "cpus": int(lines[1]) if len(lines) > 1 and lines[1].isdigit() else 0,
            "ram_free_mib": int(lines[2]) if len(lines) > 2 and lines[2].isdigit() else 0,
            "load": float(lines[3]) if len(lines) > 3 else 0.0, "gpu": None}
    if len(lines) > 4 and "," in lines[4]:
        name, used, total, temp = [x.strip() for x in lines[4].split(",")[:4]]
        info["gpu"] = {"name": name, "used_mib": int(used), "total_mib": int(total), "temp": int(temp)}
    return host, info


def probe_all(names):
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(16, max(1, len(names)))) as ex:
        return dict(ex.map(probe, names))


def line(host, info, note):
    if info is None:
        return f"down     {host:<14} {note}"
    gpu = f"  GPU {info['gpu']['name']} {info['gpu']['total_mib'] - info['gpu']['used_mib']} MiB free, {info['gpu']['temp']} C" if info["gpu"] else ""
    return f"up       {host:<14} {info['cpus']} cpus, load {info['load']:.1f}, {info['ram_free_mib'] // 1024} GiB RAM free{gpu}  {note}"


def cmd_list(_):
    names = hosts()
    if not names:
        print("no hosts in ~/.ssh/config")
        return
    n = notes()
    for host, info in probe_all(names).items():
        print(line(host, info, n.get(host, "")))


def cmd_pick(args):
    what = args[0] if args else "ram"
    res = {h: i for h, i in probe_all(hosts()).items() if i}
    if what == "gpu":
        res = {h: i for h, i in res.items() if i["gpu"]}
        key = lambda h: res[h]["gpu"]["total_mib"] - res[h]["gpu"]["used_mib"]
    elif what == "cpu":
        key = lambda h: res[h]["cpus"] - res[h]["load"]
    else:
        key = lambda h: res[h]["ram_free_mib"]
    if not res:
        print(f"no reachable host has {what}", file=sys.stderr)
        return 1
    best = max(res, key=key)
    print(best)
    return 0


def cmd_run(args):
    if not args:
        sys.exit('usage: fleet run "COMMAND"')
    command = " ".join(args)
    up = [h for h, i in probe_all(hosts()).items() if i]

    def one(host):
        r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", host, command], capture_output=True, text=True, timeout=120)
        return host, r.returncode, (r.stdout + r.stderr)
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        for host, code, out in ex.map(one, up):
            for l in out.rstrip().splitlines() or [f"(exit {code})"]:
                print(f"{host}: {l}")


def cmd_note(args):
    if len(args) < 2:
        sys.exit('usage: fleet note HOST "what it is for"')
    n = notes()
    n[args[0]] = " ".join(args[1:])
    os.makedirs(os.path.dirname(NOTES), exist_ok=True)
    json.dump(n, open(NOTES, "w"), indent=1)
    print(f"{args[0]}: {n[args[0]]}")


def main(argv):
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if not argv:
        return cmd_list([])
    if argv[0] == "pick":
        return cmd_pick(argv[1:])
    if argv[0] == "run":
        return cmd_run(argv[1:])
    if argv[0] == "note":
        return cmd_note(argv[1:])
    host, info = probe(argv[0])
    print(line(host, info, notes().get(host, "")))
    if info:
        print(json.dumps(info, indent=1))
    return 0 if info else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
