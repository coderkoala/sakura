#!/usr/bin/env python3
"""conv — every conversion people paste into a website, done here with the open-source tools the websites run anyway.
Nothing leaves the machine; the input is never overwritten; the output lands next to it (or -o FILE / --dir DIR).

  conv FILE... --to EXT        documents  md html docx odt rtf epub tex rst txt ↔ (pandoc); docx xlsx pptx odt → pdf (LibreOffice);
                               pdf → txt (pdftotext), pdf → png|jpg (pdftoppm, one per page), pdf → docx (LibreOffice)
                               sheets     xlsx xls ods → csv (LibreOffice; one file per sheet when there are several), csv → xlsx|ods|pdf
                               books      epub mobi azw3 fb2 → epub|mobi|azw3|pdf|txt|md|docx, and md docx html → epub|mobi|azw3, for a reader:
                               pandoc does epub and fb2 alone; anything Kindle (mobi, azw3) and a book → pdf is calibre's ebook-convert.
                               The title and author travel with the book;
  --title "T" --author "A"     set them instead (a markdown file with no front matter gets its file name as the title)
                               images     png jpg webp gif tiff bmp heic avif svg ↔ (ImageMagick, or Pillow)
                               sound/video mp4 mkv webm mov avi mp3 m4a wav flac ogg opus ↔ (ffmpeg); video → gif
  conv merge a.pdf b.pdf…      one pdf (qpdf; pdfunite or pypdf if it's missing)   -o out.pdf
  conv split x.pdf [--every N] one file per page (or per N pages)
  conv pages x.pdf 1-3,7       those pages;   conv rotate x.pdf 90|180|270 [--pages 2]
  conv compress FILE           pdf (ghostscript /ebook), jpg|png|webp (quality 82, longest side 2000), video (h264 crf 26)
  conv ocr scan.pdf|image      a searchable pdf (ocrmypdf, else tesseract); SAKURA_OCR_LANGS=eng+nep for other languages
  conv unlock x.pdf            remove a pdf's password: asked for on the terminal, never stored, never in the command line
  conv redact x.pdf "pattern"… remove every match for real (text, and the image underneath): not a black box over it (PyMuPDF);
                               --regex for patterns; it says how many it removed
  conv fields form.pdf         a form's fields and what's in them;   conv fill form.pdf data.json   fill them (pypdf; --flatten to fix)
  conv sign x.pdf              a PAdES signature with your own key (pyHanko): --key k.pem --cert c.pem, or --self-signed "Name" once,
                               which makes a key in ~/.sakura/sign (0600) and reuses it;  conv verify x.pdf  who signed, and is it intact
  conv strip FILE...           remove metadata — EXIF, GPS, author, software — before a file leaves you (exiftool, else magick/ffmpeg/qpdf)
  conv trim video.mp4 START [END]   cut a piece (00:01:30 or 90), copying the streams, no re-encode
  conv audio video.mp4 [--to mp3]   the sound track (then `hear FILE` can transcribe it)
  conv gif clip.mp4 [--fps 12 --width 480]   a gif;   conv thumbs video.mp4   a contact sheet;   conv shrink video.mp4  = compress
  conv subs video.mp4 [--lang ne] [--burn] [--model small]   subtitles as an .srt next to it, from the speech (whisper on this machine,
                               the same model `hear` uses); --burn also writes a copy with them drawn in. `translate x.srt --to en` keeps the timings
  conv URL --to pdf|png|html|md|txt   a web page saved here: printed to pdf or a full-page png by the local headless browser (Chromium,
                               or Playwright's), to html as fetched, to md/txt through pandoc. Only that URL is fetched.
  conv extract ARCHIVE...      zip, tar(.gz/.bz2/.xz/.zst), 7z, rar: into a new folder named after the archive, never into the
                               current directory; entries that would land outside it (zip-slip) are refused
  conv denoise FILE            remove hiss, hum and noise from a recording or tape, or from a video's sound with the picture copied untouched
                               (ffmpeg afftdn). The noise floor is measured from the quietest moments of the file;
  --strength DB                how much to take off, afftdn's own figure (default 12, up to 97);  --floor DB  the noise floor, if you know it
  --model FILE.rnnn            a speech-denoising network instead (ffmpeg arnndn; the model file is yours to fetch, none is shipped)
  conv stems SONG [--two vocals] [--model NAME]   vocals, drums, bass and other as separate files in a new "SONG stems" folder
                               (Demucs, when installed; its model is fetched once on first use). --two vocals makes vocals and the rest
  conv --tools                 which converters are here and the install line for each that isn't
  --dry prints each command instead of running it;  --json  one line per output
"""
import getpass
import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile

signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # `conv --tools | head` ends quietly

DOCS = {"md", "markdown", "html", "htm", "docx", "odt", "rtf", "epub", "tex", "rst", "txt", "org", "adoc", "ipynb", "fb2", "pptx", "xlsx", "ods", "odp", "doc", "xls", "ppt"}
IMAGES = {"png", "jpg", "jpeg", "webp", "gif", "tiff", "tif", "bmp", "heic", "heif", "avif", "svg", "ico", "pnm", "ppm"}
AUDIO = {"mp3", "m4a", "aac", "wav", "flac", "ogg", "opus", "wma", "aiff"}
VIDEO = {"mp4", "mkv", "webm", "mov", "avi", "m4v", "mpg", "mpeg", "ts", "3gp", "wmv", "flv"}
OFFICE = {"docx", "doc", "odt", "rtf", "pptx", "ppt", "odp", "xlsx", "xls", "ods"}
SHEETS = {"xlsx", "xls", "ods"}
EBOOKS = {"epub", "mobi", "azw3", "azw", "fb2"}
KINDLE = {"mobi", "azw3", "azw"}  # pandoc reads and writes neither
CALIBRE_IN = EBOOKS | {"docx", "html", "htm", "txt", "odt", "rtf", "pdf", "md"}
CALIBRE_OUT = {"epub", "mobi", "azw3", "fb2", "pdf", "txt", "docx", "rtf"}
TOOLS = {  # name: (how to install)
    "pandoc": "sudo -A apt-get install -y pandoc", "libreoffice": "sudo -A apt-get install -y libreoffice-core libreoffice-writer libreoffice-calc libreoffice-impress",
    "pdftotext": "sudo -A apt-get install -y poppler-utils", "pdftoppm": "sudo -A apt-get install -y poppler-utils", "pdfunite": "sudo -A apt-get install -y poppler-utils",
    "qpdf": "sudo -A apt-get install -y qpdf", "gs": "sudo -A apt-get install -y ghostscript", "magick": "sudo -A apt-get install -y imagemagick",
    "ffmpeg": "sudo -A apt-get install -y ffmpeg", "chromium": "sudo -A apt-get install -y chromium", "ocrmypdf": "uv tool install ocrmypdf  (and sudo -A apt-get install -y tesseract-ocr)",
    "tesseract": "sudo -A apt-get install -y tesseract-ocr", "exiftool": "sudo -A apt-get install -y libimage-exiftool-perl", "pymupdf": "pip install pymupdf  (conv redact)", "pyhanko": "pip install pyhanko  (conv sign/verify)",
    "ebook-convert": "sudo -A apt-get install -y calibre  (books to and from mobi/azw3, a book to pdf)",
    "demucs": "uv tool install demucs --with numpy  (conv stems; its model, about 80 MB, is fetched on first use)",
}
DRY = "--dry" in sys.argv
AS_JSON = "--json" in sys.argv
META = {"title": None, "author": None}  # --title / --author, for a book
made = []


def have(tool):
    if tool in ("pymupdf", "pyhanko"):
        return subprocess.run([sys.executable, "-c", f"import {tool}"], capture_output=True).returncode == 0 or None
    if tool == "magick":
        return shutil.which("magick") or shutil.which("convert")
    if tool == "libreoffice":
        return shutil.which("libreoffice") or shutil.which("soffice")
    return shutil.which(tool)


def need(tool):
    p = have(tool)
    if not p:
        print(f"conv: this needs {tool}, which isn't installed:\n  {TOOLS.get(tool, tool)}", file=sys.stderr)
        sys.exit(3)
    return p


def ext(path):
    return os.path.splitext(path)[1].lower().lstrip(".")


def out_path(src, new_ext, o=None, outdir=None, suffix=""):
    if o:
        return o
    base = os.path.splitext(os.path.basename(src))[0] + suffix
    d = outdir or os.path.dirname(os.path.abspath(src))
    cand = os.path.join(d, f"{base}.{new_ext}")
    n = 2
    while os.path.exists(cand) or os.path.abspath(cand) == os.path.abspath(src):
        cand = os.path.join(d, f"{base} ({n}).{new_ext}")
        n += 1
    return cand


def run(cmd, tool, out, quiet=True, env=None):
    if DRY:
        print(" ".join(shlex.quote(c) for c in cmd))
        return True
    r = subprocess.run(cmd, capture_output=quiet, text=True, env=env)
    if r.returncode != 0:
        print(f"conv: {tool} failed on {cmd[-1] if not out else out}:\n{(r.stderr or r.stdout or '').strip()[-800:]}", file=sys.stderr)
        return False
    if out:
        made.append({"out": out, "tool": tool})
        if not AS_JSON:
            print(f"wrote {out}  ({tool})")
    return True


def convert_one(src, to, o, outdir):
    if not os.path.exists(src):
        print(f"conv: no such file {src}", file=sys.stderr)
        return False
    s, t = ext(src), to.lower().lstrip(".")
    t = {"jpeg": "jpg", "markdown": "md", "htm": "html", "tif": "tiff"}.get(t, t)
    if s in EBOOKS or t in EBOOKS:
        done = ebook(src, s, t, o, outdir)
        if done is not None:
            return done
    if s in SHEETS and t == "csv":
        return sheets_csv(src, o, outdir)
    if s == "csv" and t in ("xlsx", "xls", "ods", "pdf", "html"):
        return office(src, t, o, outdir)
    if s == "pdf":
        if t == "txt":
            out = out_path(src, "txt", o, outdir)
            return run([need("pdftotext"), "-layout", src, out], "pdftotext", out)
        if t in ("png", "jpg"):
            out = out_path(src, t, o, outdir)
            stem = os.path.splitext(out)[0]
            ok = run([need("pdftoppm"), "-r", "150", "-png" if t == "png" else "-jpeg", src, stem], "pdftoppm", None)
            if ok and not DRY:
                pages = sorted(p for p in os.listdir(os.path.dirname(stem) or ".") if p.startswith(os.path.basename(stem) + "-") and p.endswith("." + t))
                for p in pages:
                    made.append({"out": os.path.join(os.path.dirname(stem) or ".", p), "tool": "pdftoppm"})
                    if not AS_JSON:
                        print(f"wrote {os.path.join(os.path.dirname(stem) or '.', p)}  (pdftoppm)")
            return ok
        if t in OFFICE or t == "html":
            return office(src, t, o, outdir)
    if t == "pdf" and (s in OFFICE or s in ("html", "txt")):
        return office(src, "pdf", o, outdir)
    if t == "pdf" and s in ("md", "rst", "org", "tex", "epub", "fb2"):
        # pandoc needs a pdf engine; go through html and LibreOffice so nothing else needs installing
        html = out_path(src, "html", None, outdir)
        if not run([need("pandoc"), src, "-s", "-o", html], "pandoc", None):
            return False
        ok = office(html, "pdf", o, outdir)
        if not DRY and os.path.exists(html):
            os.unlink(html)
        return ok
    if t == "pdf" and s in IMAGES:
        out = out_path(src, "pdf", o, outdir)
        return run([need("magick"), src, out], "imagemagick", out)
    if s in DOCS and t in DOCS:
        if t == "pptx" and s not in OFFICE:  # slides from markdown or html are pandoc's; LibreOffice can't read those into Impress
            return pandoc_doc(src, t, out_path(src, t, o, outdir))
        if s in OFFICE and t in OFFICE or s in ("xlsx", "xls", "ods", "pptx", "ppt", "odp") or t in ("xlsx", "xls", "ods", "pptx", "ppt", "odp"):
            return office(src, t, o, outdir)
        return pandoc_doc(src, t, out_path(src, t, o, outdir))
    if s in IMAGES and t in IMAGES:
        out = out_path(src, t, o, outdir)
        if have("magick"):
            return run([have("magick"), src, *(["-background", "white", "-flatten"] if t == "jpg" else []), out], "imagemagick", out)
        return pillow(src, out)
    if (s in AUDIO or s in VIDEO) and (t in AUDIO or t in VIDEO or t == "gif"):
        if t == "gif":
            return gif(src, o, outdir, 12, 480)
        out = out_path(src, t, o, outdir)
        args = [need("ffmpeg"), "-hide_banner", "-loglevel", "error", "-i", src]
        if t in AUDIO:
            args += ["-vn"]
            if t == "mp3":
                args += ["-c:a", "libmp3lame", "-q:a", "2"]
            elif t == "m4a":
                args += ["-c:a", "aac", "-b:a", "192k"]
        elif t == "mp4":
            args += ["-c:v", "libx264", "-preset", "medium", "-crf", "20", "-c:a", "aac", "-movflags", "+faststart"]
        elif t == "webm":
            args += ["-c:v", "libvpx-vp9", "-crf", "32", "-b:v", "0", "-c:a", "libopus"]
        return run([*args, out], "ffmpeg", out)
    print(f"conv: I don't know how to turn .{s} into .{t}", file=sys.stderr)
    return False


def pandoc_meta():
    return [x for k in ("title", "author") if META[k] for x in ("--metadata", f"{k}={META[k]}")]


def pandoc_book(src, out, final=True):
    """A document → epub or fb2. A book needs a title: the document's own, else --title, else the file's name. A metadata
    file is the one place pandoc takes a value the document's own front matter still overrides."""
    with tempfile.TemporaryDirectory() as tmp:
        default = os.path.join(tmp, "title.yaml")
        with open(default, "w") as f:
            f.write("title: " + json.dumps(os.path.splitext(os.path.basename(src))[0]) + "\n")
        return run([need("pandoc"), src, "-s", "--metadata-file", default, *pandoc_meta(), "-o", out], "pandoc", out if final else None)


def pandoc_doc(src, t, out):
    fmt = {"md": "gfm", "txt": "plain", "tex": "latex"}.get(t, t)
    book = ext(src) in EBOOKS
    if t in ("epub", "fb2") and not book:
        return pandoc_book(src, out)
    args = [need("pandoc"), src, "-o", out]
    if t in ("html", "epub", "docx", "odt", "rtf", "fb2") or (t == "md" and book):
        args.insert(2, "-s")  # on a book → md, -s is what keeps the title and author, as front matter
    if t == "html" and not book and not META["title"]:
        args += ["--metadata", f"title={os.path.splitext(os.path.basename(src))[0]}"]
    args += pandoc_meta()
    if t in ("md", "txt", "tex"):
        args += ["-t", "gfm-raw_html" if t == "md" and book else fmt]  # a book's markup is full of anchors nobody reads
    return run(args, "pandoc", out)


def calibre_env():
    env = dict(os.environ)
    if not env.get("DISPLAY") and not env.get("WAYLAND_DISPLAY"):
        env.setdefault("QT_QPA_PLATFORM", "offscreen")
    if hasattr(os, "geteuid") and os.geteuid() == 0:
        env.setdefault("QTWEBENGINE_CHROMIUM_FLAGS", "--no-sandbox")  # the Chromium that prints calibre's pdf refuses root otherwise
    return env


def ebook(src, s, t, o, outdir):
    """A book for a reader. None means pandoc's ordinary path does this pair; anything Kindle, and a book → pdf, is calibre's."""
    cal, pan = have("ebook-convert"), have("pandoc")
    kindle = s in KINDLE or t in KINDLE
    if t == "azw":
        print("conv: nothing writes .azw any more; a Kindle reads azw3 (--to azw3) or mobi", file=sys.stderr)
        return False
    if not kindle and "pdf" not in (s, t) and (pan or not cal):
        return None  # epub and fb2 to and from documents: pandoc alone
    if not kindle and t == "pdf" and not cal:
        return None  # pandoc → html → LibreOffice, as before
    if not cal:
        print(f"conv: .{s} → .{t} is calibre's work (ebook-convert), and it isn't installed:\n  {TOOLS['ebook-convert']}", file=sys.stderr)
        if not kindle and pan:
            print("  (without it, pandoc alone does epub and fb2 to and from md, docx, html, txt)", file=sys.stderr)
        sys.exit(3)
    if t not in CALIBRE_OUT and t not in ("md", "html", "odt", "rst", "tex", "org"):
        print(f"conv: I don't know how to turn .{s} into .{t}", file=sys.stderr)
        return False
    out = out_path(src, t, o, outdir)
    env = calibre_env()
    meta = [*(["--title", META["title"]] if META["title"] else []), *(["--authors", META["author"]] if META["author"] else [])]
    stem = os.path.splitext(os.path.basename(src))[0]
    with tempfile.TemporaryDirectory() as tmp:
        first = src
        if s not in CALIBRE_IN or (s not in EBOOKS and s != "pdf" and pan):
            # a document: pandoc makes the epub (chapters from the headings, front matter as the title), calibre the Kindle file
            first = os.path.join(tmp, stem + ".epub")
            if not pandoc_book(src, first, final=False):
                return False
        if t in CALIBRE_OUT:
            return run([cal, first, out, *meta], "calibre", out, env=env)
        if not pan and t == "md":
            txt = os.path.join(tmp, stem + ".txt")  # calibre names the format by the extension
            if not run([cal, first, txt, "--txt-output-formatting=markdown", *meta], "calibre", None, env=env):
                return False
            if not DRY:
                shutil.move(txt, out)
                made.append({"out": out, "tool": "calibre"})
                if not AS_JSON:
                    print(f"wrote {out}  (calibre)")
            return True
        # md, html, odt…: calibre opens the Kindle file, pandoc writes the document
        mid = os.path.join(tmp, stem + ".epub")
        return run([cal, first, mid, *meta], "calibre", None, env=env) and pandoc_doc(mid, t, out)


def sheets_csv(src, o, outdir):
    """Every sheet as its own csv: LibreOffice's filter with sheet -1, UTF-8, commas, text quoted."""
    lo = need("libreoffice")
    flt = "csv:Text - txt - csv (StarCalc):44,34,76,1,,0,false,true,false,false,false,-1"
    with tempfile.TemporaryDirectory() as tmp:
        if not run([lo, "--headless", "--norestore", "--convert-to", flt, "--outdir", tmp, src], "libreoffice", None, env=dict(os.environ, HOME=os.environ.get("HOME", "/tmp"))):
            return False
        if DRY:
            return True
        got = sorted(os.listdir(tmp))
        if not got:
            print(f"conv: libreoffice made nothing for {src}", file=sys.stderr)
            return False
        stem = os.path.splitext(os.path.basename(src))[0]
        for f in got:
            sheet = os.path.splitext(f)[0][len(stem) + 1:]
            out = out_path(src, "csv", o, outdir) if len(got) == 1 else out_path(src, "csv", None, outdir or (os.path.dirname(os.path.abspath(o)) if o else None), suffix=f" {sheet}")
            shutil.move(os.path.join(tmp, f), out)
            made.append({"out": out, "tool": "libreoffice"})
            if not AS_JSON:
                print(f"wrote {out}  (libreoffice)")
    return True


def pillow(src, out):
    try:
        from PIL import Image
    except ImportError:
        need("magick")
    if DRY:
        print(f"pillow: {src} -> {out}")
        return True
    im = Image.open(src)
    if ext(out) in ("jpg", "jpeg") and im.mode in ("RGBA", "P", "LA"):
        im = im.convert("RGB")
    im.save(out)
    made.append({"out": out, "tool": "pillow"})
    if not AS_JSON:
        print(f"wrote {out}  (pillow)")
    return True


def office(src, t, o, outdir):
    lo = need("libreoffice")
    env = dict(os.environ, HOME=os.environ.get("HOME", "/tmp"))
    # into a folder of its own first: LibreOffice names the file itself, and writes over one of that name already there
    with tempfile.TemporaryDirectory() as tmp:
        if not run([lo, "--headless", "--norestore", "--convert-to", t, "--outdir", tmp, src], "libreoffice", None, env=env):
            return False
        if DRY:
            return True
        got = os.listdir(tmp)
        if not got:
            print(f"conv: libreoffice made nothing for {src}", file=sys.stderr)
            return False
        final = o or out_path(src, t, None, outdir)
        shutil.move(os.path.join(tmp, got[0]), final)
    made.append({"out": final, "tool": "libreoffice"})
    if not AS_JSON:
        print(f"wrote {final}  (libreoffice)")
    return True


def pdf_merge(files, o):
    out = o or out_path(files[0], "pdf", None, None, suffix=" merged")
    if have("qpdf"):
        return run([have("qpdf"), "--empty", "--pages", *files, "--", out], "qpdf", out)
    if have("pdfunite"):
        return run([have("pdfunite"), *files, out], "pdfunite", out)
    try:
        from pypdf import PdfWriter
    except ImportError:
        need("qpdf")
    w = PdfWriter()
    for f in files:
        w.append(f)
    w.write(out)
    made.append({"out": out, "tool": "pypdf"})
    print(f"wrote {out}  (pypdf)")
    return True


def pdf_pages_count(src):
    q = have("qpdf")
    if q:
        r = subprocess.run([q, "--show-npages", src], capture_output=True, text=True)
        if r.returncode == 0:
            return int(r.stdout.strip())
    try:
        from pypdf import PdfReader
        return len(PdfReader(src).pages)
    except Exception:
        return 0


def pdf_split(src, every, outdir):
    q = need("qpdf")
    n = pdf_pages_count(src)
    d = outdir or os.path.dirname(os.path.abspath(src))
    stem = os.path.splitext(os.path.basename(src))[0]
    ok = True
    for start in range(1, n + 1, every):
        end = min(start + every - 1, n)
        out = os.path.join(d, f"{stem} p{start}" + (f"-{end}" if end != start else "") + ".pdf")
        ok &= run([q, src, "--pages", ".", f"{start}-{end}", "--", out], "qpdf", out)
    return ok


def pdf_pages(src, spec, o, outdir):
    q = need("qpdf")
    out = o or out_path(src, "pdf", None, outdir, suffix=f" p{spec}")
    return run([q, src, "--pages", ".", spec, "--", out], "qpdf", out)


def pdf_rotate(src, deg, pages, o, outdir):
    q = need("qpdf")
    out = o or out_path(src, "pdf", None, outdir, suffix=f" rotated{deg}")
    return run([q, src, f"--rotate=+{deg}:{pages or '1-z'}", out], "qpdf", out)


def compress(src, o, outdir):
    s = ext(src)
    if s == "pdf":
        out = o or out_path(src, "pdf", None, outdir, suffix=" small")
        return run([need("gs"), "-sDEVICE=pdfwrite", "-dCompatibilityLevel=1.5", "-dPDFSETTINGS=/ebook", "-dNOPAUSE", "-dQUIET", "-dBATCH", f"-sOutputFile={out}", src], "ghostscript", out)
    if s in IMAGES:
        out = o or out_path(src, "jpg" if s in ("jpg", "jpeg", "heic", "heif", "tiff", "tif", "bmp") else s, None, outdir, suffix=" small")
        return run([need("magick"), src, "-auto-orient", "-resize", "2000x2000>", "-quality", "82", "-strip", out], "imagemagick", out)
    if s in VIDEO:
        out = o or out_path(src, "mp4", None, outdir, suffix=" small")
        return run([need("ffmpeg"), "-hide_banner", "-loglevel", "error", "-i", src, "-c:v", "libx264", "-preset", "slow", "-crf", "26",
                    "-vf", "scale='min(1280,iw)':-2", "-c:a", "aac", "-b:a", "128k", "-movflags", "+faststart", out], "ffmpeg", out)
    print(f"conv: can't compress a .{s}", file=sys.stderr)
    return False


def ocr(src, o, outdir):
    out = o or out_path(src, "pdf", None, outdir, suffix=" ocr")
    if have("ocrmypdf"):
        args = [have("ocrmypdf"), "--skip-text", "-l", os.environ.get("SAKURA_OCR_LANGS", "eng"), src, out] if ext(src) == "pdf" else [have("ocrmypdf"), "--image-dpi", "300", "-l", os.environ.get("SAKURA_OCR_LANGS", "eng"), src, out]
        return run(args, "ocrmypdf", out)
    t = need("tesseract")
    if ext(src) == "pdf":
        print("conv: tesseract alone reads images; for a pdf install ocrmypdf: " + TOOLS["ocrmypdf"], file=sys.stderr)
        return False
    return run([t, src, os.path.splitext(out)[0], "pdf"], "tesseract", out)


def unlock(src, o, outdir):
    q = need("qpdf")
    out = o or out_path(src, "pdf", None, outdir, suffix=" unlocked")
    if DRY:
        print(f"{q} --password-file=<asked on the terminal> --decrypt {shlex.quote(src)} {shlex.quote(out)}")
        return True
    pw = os.environ.get("SAKURA_CONV_PASSWORD") if os.environ.get("SAKURA_CONV_PASSWORD_FROM_ENV_FOR_TESTS") else None
    if pw is None:
        try:
            pw = getpass.getpass(f"password for {os.path.basename(src)} (not stored): ")
        except (EOFError, KeyboardInterrupt):
            print("\nconv: no password given; nothing done", file=sys.stderr)
            return False
    # the password goes to qpdf on a file descriptor, never on the command line where `ps` and the recap would see it
    r, w = os.pipe()
    os.write(w, pw.encode())
    os.close(w)
    cmd = [q, f"--password-file=/dev/fd/{r}", "--decrypt", src, out]
    p = subprocess.run(cmd, capture_output=True, text=True, pass_fds=(r,))
    os.close(r)
    if p.returncode != 0:
        print(f"conv: qpdf couldn't open it: {p.stderr.strip()[-300:]}", file=sys.stderr)
        return False
    made.append({"out": out, "tool": "qpdf"})
    if not AS_JSON:
        print(f"wrote {out}  (qpdf)")
    return True


def redact(src, patterns, regex, o, outdir):
    try:
        import pymupdf
    except ImportError:
        print("conv: redaction needs PyMuPDF: uv pip install pymupdf  (or pip install pymupdf)", file=sys.stderr)
        return False
    import re as _re
    out = o or out_path(src, "pdf", None, outdir, suffix=" redacted")
    if DRY:
        print(f"pymupdf: redact {patterns} in {src} -> {out}")
        return True
    doc = pymupdf.open(src)
    n = 0
    for page in doc:
        rects = []
        if regex:
            words = page.get_text("words")
            text_line = {}
            for w in words:
                text_line.setdefault((w[5], w[6]), []).append(w)
            for key, ws in text_line.items():
                line = " ".join(w[4] for w in ws)
                for m in _re.finditer("|".join(patterns), line):
                    # words whose span overlaps the match
                    pos = 0
                    for w in ws:
                        start, end = pos, pos + len(w[4])
                        if start < m.end() and end > m.start():
                            rects.append(pymupdf.Rect(w[:4]))
                        pos = end + 1
        else:
            for pat in patterns:
                rects += page.search_for(pat)
        for r in rects:
            page.add_redact_annot(r, fill=(0, 0, 0))
        if rects:
            page.apply_redactions(images=pymupdf.PDF_REDACT_IMAGE_PIXELS if hasattr(pymupdf, "PDF_REDACT_IMAGE_PIXELS") else 2)
            n += len(rects)
    doc.save(out, garbage=4, deflate=True)
    doc.close()
    made.append({"out": out, "tool": "pymupdf", "removed": n})
    if not AS_JSON:
        print(f"wrote {out}  (pymupdf); removed {n} match{'es' if n != 1 else ''}" + ("" if n else " — nothing matched; the original is untouched either way"))
    return True


def fields(src):
    from pypdf import PdfReader
    r = PdfReader(src)
    f = r.get_fields() or {}
    if AS_JSON:
        print(json.dumps({k: (v.get("/V") if hasattr(v, "get") else None) for k, v in f.items()}, indent=1, default=str))
        return True
    if not f:
        print("no form fields (not an AcroForm; `conv fill` can't help, but `conv x.pdf --to docx` and editing can)")
        return True
    w = max(len(k) for k in f)
    for k, v in f.items():
        val = v.get("/V") if hasattr(v, "get") else None
        kind = {"/Tx": "text", "/Btn": "checkbox", "/Ch": "choice", "/Sig": "signature"}.get(str(v.get("/FT")) if hasattr(v, "get") else "", "?")
        print(f"  {k.ljust(w)}  {kind:<9} {'' if val in (None, '') else str(val)}")
    return True


def fill(src, data_path, flatten, o, outdir):
    from pypdf import PdfReader, PdfWriter
    from pypdf.generic import NameObject, BooleanObject
    try:
        data = json.load(open(data_path))
    except (OSError, ValueError) as e:
        print(f"conv: can't read {data_path}: {e}", file=sys.stderr)
        return False
    out = o or out_path(src, "pdf", None, outdir, suffix=" filled")
    if DRY:
        print(f"pypdf: fill {len(data)} fields from {data_path} into {src} -> {out}")
        return True
    r = PdfReader(src)
    w = PdfWriter(clone_from=r)
    known = set((r.get_fields() or {}).keys())
    unknown = [k for k in data if k not in known]
    for page in w.pages:
        w.update_page_form_field_values(page, {k: v for k, v in data.items() if k in known}, auto_regenerate=False)
    if "/AcroForm" in w._root_object:
        w._root_object["/AcroForm"][NameObject("/NeedAppearances")] = BooleanObject(True)
    if flatten:
        try:
            w.flatten()  # pypdf >= 5
        except Exception:
            pass
    w.write(out)
    made.append({"out": out, "tool": "pypdf", "filled": len(data) - len(unknown), "unknown": unknown})
    if not AS_JSON:
        print(f"wrote {out}  (pypdf); {len(data) - len(unknown)} fields filled" + (f"; not in the form: {', '.join(unknown)}" if unknown else ""))
    return True


SIGN_DIR = os.path.join(os.environ.get("SAKURA_HOME", os.path.expanduser("~/.sakura")), "sign")


def self_signed(name):
    """A key and certificate of the user's own, made once with openssl, kept 0600."""
    os.makedirs(SIGN_DIR, mode=0o700, exist_ok=True)
    key, cert = os.path.join(SIGN_DIR, "key.pem"), os.path.join(SIGN_DIR, "cert.pem")
    if not (os.path.exists(key) and os.path.exists(cert)):
        subprocess.run(["openssl", "req", "-x509", "-newkey", "rsa:3072", "-nodes", "-keyout", key, "-out", cert, "-days", "3650",
                        "-subj", f"/CN={name}", "-addext", "keyUsage=digitalSignature,nonRepudiation"], check=True, capture_output=True)
        os.chmod(key, 0o600)
        if not AS_JSON:
            print(f"made a signing key for “{name}” in {SIGN_DIR} (the .pem files are yours; back them up, never share key.pem)")
    return key, cert


def sign(src, key, cert, chain, field, reason, o, outdir):
    try:
        from pyhanko.sign import signers
        from pyhanko.sign.fields import SigFieldSpec
        from pyhanko.pdf_utils.incremental_writer import IncrementalPdfFileWriter
    except ImportError:
        print("conv: signing needs pyHanko: uv tool install pyhanko  (or pip install pyhanko)", file=sys.stderr)
        return False
    out = o or out_path(src, "pdf", None, outdir, suffix=" signed")
    if DRY:
        print(f"pyhanko: sign {src} with {key} -> {out}")
        return True
    signer = signers.SimpleSigner.load(key, cert, ca_chain_files=chain or None)
    if signer is None:
        print("conv: couldn't load the key and certificate", file=sys.stderr)
        return False
    with open(src, "rb") as f:
        w = IncrementalPdfFileWriter(f)
        meta = signers.PdfSignatureMetadata(field_name=field or "Signature1", reason=reason or None)
        pdf_signer = signers.PdfSigner(meta, signer=signer, new_field_spec=SigFieldSpec(sig_field_name=field or "Signature1", box=(400, 40, 580, 90)))
        with open(out, "wb") as outf:
            pdf_signer.sign_pdf(w, output=outf)
    made.append({"out": out, "tool": "pyhanko"})
    if not AS_JSON:
        print(f"wrote {out}  (pyhanko); `conv verify` checks it")
    return True


def verify(src, cert):
    try:
        from pyhanko.pdf_utils.reader import PdfFileReader
        from pyhanko.sign.validation import validate_pdf_signature
        from pyhanko_certvalidator import ValidationContext
        from pyhanko.keys import load_cert_from_pemder
    except ImportError:
        print("conv: verifying needs pyHanko: uv tool install pyhanko", file=sys.stderr)
        return False
    roots = []
    for c in ([cert] if cert else []) + ([os.path.join(SIGN_DIR, "cert.pem")] if os.path.exists(os.path.join(SIGN_DIR, "cert.pem")) else []):
        try:
            roots.append(load_cert_from_pemder(c))
        except Exception:
            pass
    vc = ValidationContext(trust_roots=roots, allow_fetching=False)
    with open(src, "rb") as f:
        r = PdfFileReader(f)
        sigs = r.embedded_signatures
        if not sigs:
            print("no signatures")
            return False
        ok_all = True
        for s in sigs:
            status = validate_pdf_signature(s, vc)
            signer_name = s.signer_cert.subject.human_friendly if s.signer_cert is not None else "?"
            whole = bool(status.coverage) and status.coverage.name == "ENTIRE_FILE"
            ok = status.intact and status.valid and status.trusted and whole
            ok_all &= ok
            cover = "the whole document" if whole else "part of the document (changed after signing)"
            if AS_JSON:
                print(json.dumps({"field": s.field_name, "signer": signer_name, "intact": status.intact, "valid": status.valid, "trusted": status.trusted, "covers": cover}))
            else:
                print(f"  {s.field_name}: {signer_name}; {'intact' if status.intact else 'TAMPERED'}, signature {'valid' if status.valid else 'INVALID'}, "
                      f"{'trusted' if status.trusted else 'signer not trusted (pass --cert their.pem)'}; covers {cover}")
        return ok_all


def strip(src, o, outdir):
    s = ext(src)
    out = o or out_path(src, s, None, outdir, suffix=" clean")
    # not a pdf: exiftool's edit of one is an appended update, and the author is still in the file underneath it
    if have("exiftool") and (s in IMAGES or s in VIDEO or s in AUDIO):
        if not run([have("exiftool"), "-all=", "-tagsfromfile", "@", "-orientation", "-icc_profile", "-o", out, src], "exiftool", out):
            return False
        return True
    if s in IMAGES:
        if have("magick"):
            return run([have("magick"), src, "-auto-orient", "-strip", out], "imagemagick", out)
        try:
            from PIL import Image, ImageOps
            im = ImageOps.exif_transpose(Image.open(src))
            clean = Image.new(im.mode, im.size)
            clean.putdata(list(im.getdata()))
            clean.save(out)
            made.append({"out": out, "tool": "pillow"})
            print(f"wrote {out}  (pillow)")
            return True
        except ImportError:
            need("magick")
    if s in VIDEO or s in AUDIO:
        return run([need("ffmpeg"), "-hide_banner", "-loglevel", "error", "-i", src, "-map_metadata", "-1", "-map_metadata:s", "-1", "-c", "copy", "-fflags", "+bitexact", out], "ffmpeg", out)
    if s == "pdf":
        q = need("qpdf")
        # qpdf can't drop the Info dictionary on its own; empty it through a tiny pypdf pass when available, else linearize and warn
        try:
            from pypdf import PdfReader, PdfWriter
            if DRY:
                print(f"pypdf: strip metadata {src} -> {out}")
                return True
            w = PdfWriter(clone_from=PdfReader(src))
            w.metadata = None  # drops the /Info dictionary (author, creator, producer, dates)
            if "/Metadata" in w._root_object:
                del w._root_object["/Metadata"]  # and the XMP packet
            w.write(out)
            made.append({"out": out, "tool": "pypdf"})
            print(f"wrote {out}  (pypdf)")
            return True
        except ImportError:
            return run([q, "--linearize", src, out], "qpdf", out) and print("conv: qpdf keeps the document info; pip install pypdf to drop it") is None
    print(f"conv: don't know how to strip a .{s}", file=sys.stderr)
    return False


def trim(src, start, end, o, outdir):
    out = o or out_path(src, ext(src), None, outdir, suffix=" cut")
    args = [need("ffmpeg"), "-hide_banner", "-loglevel", "error", "-ss", start, "-i", src]
    if end:
        args += ["-to", end] if ":" in end or not end.startswith("+") else ["-t", end[1:]]
        if ":" in end or not end.startswith("+"):
            # -to after -ss -i is relative to the seek point in recent ffmpeg; compute a duration instead to be exact
            args[-2:] = ["-t", str(max(0.0, to_seconds(end) - to_seconds(start)))]
    return run([*args, "-c", "copy", "-avoid_negative_ts", "make_zero", "-movflags", "+faststart", out], "ffmpeg", out)


def to_seconds(t):
    parts = [float(p) for p in t.split(":")]
    s = 0.0
    for p in parts:
        s = s * 60 + p
    return s


def audio(src, to, o, outdir):
    to = (to or "m4a").lstrip(".")
    out = o or out_path(src, to, None, outdir)
    args = [need("ffmpeg"), "-hide_banner", "-loglevel", "error", "-i", src, "-vn"]
    if to == "mp3":
        args += ["-c:a", "libmp3lame", "-q:a", "2"]
    elif to == "m4a":
        args += ["-c:a", "aac", "-b:a", "192k"]
    elif to == "wav":
        args += ["-c:a", "pcm_s16le"]
    return run([*args, out], "ffmpeg", out)


def gif(src, o, outdir, fps, width):
    out = o or out_path(src, "gif", None, outdir)
    flt = f"fps={fps},scale={width}:-1:flags=lanczos,split[s0][s1];[s0]palettegen=max_colors=128[p];[s1][p]paletteuse=dither=bayer"
    return run([need("ffmpeg"), "-hide_banner", "-loglevel", "error", "-i", src, "-vf", flt, "-loop", "0", out], "ffmpeg", out)


def noise_floor(ff, src):
    """Where afftdn should put the noise floor, in dB (-80 to -20): the level of the file's quietest moments, the hiss with
    nothing over it, plus 5. Measured on a tone under white hiss: with the floor at the hiss's own level afftdn takes off about
    10 of 12 dB asked and 16 of 30; 5 dB above it, 12 of 12 and 26 of 30, and the tone keeps its level either way."""
    r = subprocess.run([ff, "-hide_banner", "-nostats", "-loglevel", "error", "-i", src, "-vn", "-af",
                        "asetnsamples=n=2048,astats=metadata=1:reset=1,ametadata=print:key=lavfi.astats.Overall.RMS_level:file=-",
                        "-f", "null", "-"], capture_output=True, text=True)
    levels = []
    for line in r.stdout.splitlines():
        if "RMS_level=" in line:
            try:
                v = float(line.rsplit("=", 1)[1])
            except ValueError:
                continue
            if v == v and v > -120:  # not nan, not digital silence
                levels.append(v)
    if not levels:
        return None
    levels.sort()
    return max(-80.0, min(-20.0, levels[len(levels) // 10] + 5))


def denoise(src, strength, floor, model, o, outdir):
    s = ext(src)
    if s not in AUDIO and s not in VIDEO:
        print(f"conv: denoise takes a recording or a video, not a .{s}", file=sys.stderr)
        return False
    if not os.path.exists(src):
        print(f"conv: no such file {src}", file=sys.stderr)
        return False
    ff = need("ffmpeg")
    how = {}
    if model:
        if strength is not None or floor is not None:
            print("conv: --strength and --floor are afftdn's; the network (--model) has no such knob. Leave them off.", file=sys.stderr)
            return False
        if not os.path.isfile(model):
            print(f"conv: no such model file {model}", file=sys.stderr)
            return False
        flt = "arnndn=m='" + os.path.abspath(model).replace("\\", "\\\\").replace("'", "\\'").replace(":", "\\:") + "'"
        how = {"filter": "arnndn"}
    else:
        nr = 12.0 if strength is None else strength
        if not 0.01 <= nr <= 97:
            print("conv: --strength is decibels of noise taken off, 0.01 to 97 (default 12)", file=sys.stderr)
            return False
        if floor is not None and not -80 <= floor <= -20:
            print("conv: --floor is the noise floor in dB, -80 to -20", file=sys.stderr)
            return False
        nf = floor if floor is not None else (None if DRY else noise_floor(ff, src))
        if nf is None and not DRY:
            print(f"conv: no sound to measure in {src}", file=sys.stderr)
            return False
        flt = f"afftdn=nr={nr:g}:nf={'MEASURED' if nf is None else format(nf, '.1f')}"
        how = {"filter": "afftdn", "reduction_db": nr, "floor_db": nf}
    out = o or out_path(src, s, None, outdir, suffix=" denoised")
    t = ext(out)
    codec = {"mp3": ["-c:a", "libmp3lame", "-q:a", "2"], "avi": ["-c:a", "libmp3lame", "-q:a", "2"], "webm": ["-c:a", "libopus"], "opus": ["-c:a", "libopus"],
             "wav": [], "flac": [], "ogg": [], "aiff": [], "wma": []}.get(t, ["-c:a", "aac", "-b:a", "192k"])
    # the picture and subtitles are copied as they are; only the sound is filtered, so it alone is encoded again
    cmd = [ff, "-hide_banner", "-loglevel", "error", "-i", src, "-map", "0:v?", "-map", "0:a", "-map", "0:s?", "-c:v", "copy", "-c:s", "copy", "-af", flt, *codec, out]
    if not run(cmd, "ffmpeg " + how["filter"], out):
        return False
    if made and made[-1]["out"] == out:
        made[-1].update(how)
        if not AS_JSON and "floor_db" in how:
            print(f"  noise floor {how['floor_db']:.1f} dB{'' if floor is None else ' (yours)'}, {nr:g} dB taken off; --strength for more or less")
    return True


def stems(src, two, model, o, outdir):
    """Demucs does the separating; conv finds it, keeps its output folder tidy and never touches the song."""
    d = have("demucs")
    if not d:
        print(f"conv: stems needs Demucs, which isn't installed:\n  {TOOLS['demucs']}\nnothing was written.", file=sys.stderr)
        sys.exit(3)
    if not os.path.exists(src):
        print(f"conv: no such file {src}", file=sys.stderr)
        return False
    if ext(src) not in AUDIO and ext(src) not in VIDEO:
        print(f"conv: stems takes a song (or a video's sound), not a .{ext(src)}", file=sys.stderr)
        return False
    parent = outdir or os.path.dirname(os.path.abspath(src))
    stem = os.path.splitext(os.path.basename(src))[0]
    dest = o or os.path.join(parent, f"{stem} stems")
    n = 2
    while not o and os.path.exists(dest):
        dest = os.path.join(parent, f"{stem} stems ({n})")
        n += 1
    if o and os.path.exists(o):
        print(f"conv: {o} is already there; name a folder that isn't", file=sys.stderr)
        return False
    cmd = [d, *(["-n", model] if model else []), *(["--two-stems", two] if two else [])]
    if DRY:
        print(" ".join(shlex.quote(c) for c in [*cmd, "-o", dest + ".part", src]) + f"   # then its files into {shlex.quote(dest)}/")
        return True
    work = tempfile.mkdtemp(prefix=".conv-stems-", dir=os.path.dirname(os.path.abspath(dest)))
    try:
        if not run([*cmd, "-o", work, src], "demucs", None):
            return False
        got = sorted(os.path.join(r, f) for r, _, fs in os.walk(work) for f in fs if ext(f) in ("wav", "mp3", "flac"))
        if not got:
            print(f"conv: demucs ran but left no stems for {src}", file=sys.stderr)
            return False
        os.makedirs(dest)
        for f in got:
            shutil.move(f, os.path.join(dest, os.path.basename(f)))
    finally:
        shutil.rmtree(work, ignore_errors=True)
    names = [os.path.basename(f) for f in got]
    made.append({"out": dest, "tool": "demucs", "stems": names})
    if not AS_JSON:
        print(f"wrote {dest}/  (demucs): {', '.join(names)}")
    return True


WHISPER_SRT = r'''
import sys, os
from faster_whisper import WhisperModel
path, size, lang, out = sys.argv[1], sys.argv[2], sys.argv[3] or None, sys.argv[4]
model = WhisperModel(size, device="cpu", compute_type="int8", download_root=os.path.expanduser("~/.cache/sakura/whisper"))
segments, info = model.transcribe(path, vad_filter=True, beam_size=3, language=lang, word_timestamps=False)
def ts(t):
    h, r = divmod(t, 3600); m, s = divmod(r, 60)
    return "%02d:%02d:%02d,%03d" % (h, m, int(s), int(round((s - int(s)) * 1000)))
n = 0
with open(out, "w", encoding="utf-8") as f:
    for seg in segments:
        text = seg.text.strip()
        if not text:
            continue
        n += 1
        f.write(f"{n}\n{ts(seg.start)} --> {ts(seg.end)}\n{text}\n\n")
print(f"{n} {info.language} {info.language_probability:.2f}")
'''


def subs(src, lang, burn, model, o, outdir):
    """An .srt from the speech, through faster-whisper under uv (nothing installed system-wide), like `hear`."""
    ff = need("ffmpeg")
    uv = shutil.which("uv") or os.path.expanduser("~/.local/bin/uv")
    if not os.path.exists(uv):
        print("conv: subtitles need uv (https://astral.sh/uv) so faster-whisper can run in its own environment", file=sys.stderr)
        return False
    srt = o if (o and o.endswith(".srt")) else out_path(src, "srt", None, outdir)
    if DRY:
        print(f"ffmpeg -> wav; uv run --with faster-whisper python - {src} {model} {lang or 'auto'} {srt}" + (f"; ffmpeg -vf subtitles -> burned copy" if burn else ""))
        return True
    with tempfile.TemporaryDirectory() as tmp:
        wav = os.path.join(tmp, "a.wav")
        if not run([ff, "-hide_banner", "-loglevel", "error", "-i", src, "-vn", "-ac", "1", "-ar", "16000", wav], "ffmpeg", None):
            return False
        code = os.path.join(tmp, "srt.py")
        open(code, "w").write(WHISPER_SRT)
        r = subprocess.run([uv, "run", "--quiet", "--with", "faster-whisper", "python", code, wav, model, lang or "", srt], capture_output=True, text=True)
    if r.returncode != 0:
        print(f"conv: whisper failed:\n{(r.stderr or r.stdout).strip()[-800:]}", file=sys.stderr)
        return False
    n, detected, prob = (r.stdout.split() + ["?", "?", "?"])[:3]
    made.append({"out": srt, "tool": "faster-whisper", "segments": int(n) if n.isdigit() else 0, "language": detected})
    if not AS_JSON:
        print(f"wrote {srt}  (faster-whisper {model}); {n} lines, language {detected}")
    if burn:
        out = out_path(src, "mp4", None, outdir, suffix=" subtitled")
        esc = srt.replace("\\", "\\\\").replace(":", "\\:").replace("'", "\\'")
        return run([ff, "-hide_banner", "-loglevel", "error", "-i", src, "-vf", f"subtitles='{esc}'", "-c:a", "copy", out], "ffmpeg", out)
    return True


def thumbs(src, o, outdir):
    out = o or out_path(src, "jpg", None, outdir, suffix=" sheet")
    probe = subprocess.run([need("ffprobe"), "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", src], capture_output=True, text=True).stdout.strip()
    dur = float(probe or 0) or 1
    n = 16
    return run([need("ffmpeg"), "-hide_banner", "-loglevel", "error", "-i", src, "-vf", f"fps=1/{dur / n:.3f},scale=320:-1,tile=4x4", "-frames:v", "1", "-q:v", "3", out], "ffmpeg", out)


def extract(src, outdir):
    import tarfile
    import zipfile
    low = src.lower()
    stem = os.path.basename(src)
    for suf in (".tar.gz", ".tar.bz2", ".tar.xz", ".tar.zst", ".tgz", ".tbz2", ".txz", ".tar", ".zip", ".7z", ".rar"):
        if low.endswith(suf):
            stem = os.path.basename(src)[:-len(suf)]
            break
    dest = os.path.join(outdir or os.path.dirname(os.path.abspath(src)), stem)
    n = 2
    while os.path.exists(dest):
        dest = os.path.join(outdir or os.path.dirname(os.path.abspath(src)), f"{stem} ({n})")
        n += 1
    if DRY:
        print(f"extract {src} -> {dest}/")
        return True
    real_dest = os.path.realpath(dest)

    def inside(name):
        target = os.path.realpath(os.path.join(real_dest, name))
        return target == real_dest or target.startswith(real_dest + os.sep)

    refused = 0
    if zipfile.is_zipfile(src):
        os.makedirs(dest)
        with zipfile.ZipFile(src) as z:
            for info in z.infolist():
                if not inside(info.filename) or os.path.isabs(info.filename):
                    refused += 1
                    continue
                z.extract(info, dest)
        tool = "zipfile"
    elif tarfile.is_tarfile(src) and not low.endswith(".zst"):
        os.makedirs(dest)
        with tarfile.open(src) as t:
            members = []
            for m in t.getmembers():
                if m.issym() or m.islnk() or not inside(m.name) or os.path.isabs(m.name):
                    refused += 1  # links can point out of the folder; data files only
                    continue
                members.append(m)
            t.extractall(dest, members=members, filter="data")
        tool = "tarfile"
    else:
        tool = next((t for t in ("7z", "bsdtar", "unrar") if shutil.which(t)), None)
        if not tool:
            print("conv: this needs 7z (sudo -A apt-get install -y 7zip) or bsdtar (libarchive-tools)", file=sys.stderr)
            return False
        os.makedirs(dest)
        cmd = {"7z": ["7z", "x", "-y", f"-o{dest}", src], "bsdtar": ["bsdtar", "-xf", src, "-C", dest], "unrar": ["unrar", "x", "-y", src, dest + "/"]}[tool]
        if not run(cmd, tool, None):
            return False
    count = sum(len(f) for _, _, f in os.walk(dest))
    made.append({"out": dest, "tool": tool, "files": count, "refused": refused})
    if not AS_JSON:
        print(f"extracted {count} files into {dest}/  ({tool})" + (f"; refused {refused} entr{'y' if refused == 1 else 'ies'} that pointed outside it" if refused else ""))
    return True


def chromium():
    for c in ("chromium", "chromium-browser", "google-chrome", "google-chrome-stable", "brave-browser"):
        if shutil.which(c):
            return shutil.which(c)
    for d in ("/opt/pw-browsers", os.path.expanduser("~/.cache/ms-playwright")):
        if os.path.isdir(d):
            for sub in sorted(os.listdir(d), reverse=True):
                for cand in (os.path.join(d, sub), os.path.join(d, sub, "chrome-linux", "chrome"), os.path.join(d, sub, "chrome-linux", "headless_shell")):
                    if os.path.isfile(cand) and os.access(cand, os.X_OK):
                        return cand
    return None


def url_convert(url, to, o, outdir):
    import urllib.parse
    import urllib.request
    to = to.lower().lstrip(".")
    name = urllib.parse.urlparse(url).netloc.replace(":", "_") + (urllib.parse.urlparse(url).path.rstrip("/").replace("/", "_") or "")
    name = (name or "page")[:80]
    fake = os.path.join(outdir or os.getcwd(), name + ".x")
    if to not in ("pdf", "png", "html", "md", "txt"):
        print(f"conv: a page can become pdf, png, html, md or txt, not .{to}", file=sys.stderr)
        return False
    out = o or out_path(fake, to, None, outdir)
    if to in ("pdf", "png"):
        b = chromium()
        if b:
            cmd = [b, "--headless=new", "--no-sandbox", "--disable-gpu", "--hide-scrollbars", "--run-all-compositor-stages-before-draw", "--virtual-time-budget=5000",
                   f"--print-to-pdf={out}" if to == "pdf" else f"--screenshot={out}", *(["--no-pdf-header-footer"] if to == "pdf" else ["--window-size=1280,2000"]), url]
            return run(cmd, "chromium", out)
        if to == "png":
            print("conv: a png of a page needs Chromium (sudo -A apt-get install -y chromium)", file=sys.stderr)
            return False
    # html first, then whatever pandoc or LibreOffice make of it
    html = out if to == "html" else out_path(fake, "html", None, outdir)
    if DRY:
        print(f"fetch {url} -> {html}")
    else:
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) conv/1.0"})
            with urllib.request.urlopen(req, timeout=30) as r:
                open(html, "wb").write(r.read())
        except Exception as e:
            print(f"conv: couldn't fetch {url}: {e}", file=sys.stderr)
            return False
    if to == "html":
        made.append({"out": html, "tool": "fetch"})
        if not AS_JSON:
            print(f"wrote {html}  (fetched)")
        return True
    try:
        if to in ("md", "txt"):
            return run([need("pandoc"), "-f", "html", "-t", "gfm" if to == "md" else "plain", "--wrap=none", html, "-o", out], "pandoc", out)
        if to == "pdf":
            return office(html, "pdf", out, outdir)
        print(f"conv: a page can become pdf, png, html, md or txt, not .{to}", file=sys.stderr)
        return False
    finally:
        if to != "html" and not DRY and os.path.exists(html):
            os.unlink(html)


def tools_report():
    for t, how in TOOLS.items():
        p = have(t)
        print(f"  {'ok     ' if p else 'missing'}  {t:<13} {p or how}")
    try:
        import PIL  # noqa
        print("  ok       pillow        (python)")
    except ImportError:
        pass
    return 0


def main():
    a = [x for x in sys.argv[1:] if x not in ("--dry", "--json")]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if a else 2
    if a == ["--tools"]:
        return tools_report()
    opt = {"o": None, "dir": None, "to": None, "every": 1, "pages": None, "fps": 12, "width": 480, "regex": False, "flatten": False,
           "key": None, "cert": None, "chain": [], "field": None, "reason": None, "self_signed": None, "lang": None, "burn": False, "model": None,
           "strength": None, "floor": None, "two": None}
    rest = []
    while a:
        x = a.pop(0)
        if x in ("-o", "--out"):
            opt["o"] = a.pop(0)
        elif x == "--dir":
            opt["dir"] = a.pop(0)
            os.makedirs(opt["dir"], exist_ok=True)
        elif x == "--to":
            opt["to"] = a.pop(0)
        elif x == "--every":
            opt["every"] = int(a.pop(0))
        elif x == "--pages":
            opt["pages"] = a.pop(0)
        elif x == "--fps":
            opt["fps"] = int(a.pop(0))
        elif x == "--width":
            opt["width"] = int(a.pop(0))
        elif x in ("--regex", "--flatten", "--burn"):
            opt[x[2:]] = True
        elif x in ("--lang", "--model", "--two"):
            opt[x[2:]] = a.pop(0)
        elif x in ("--title", "--author"):
            META[x[2:]] = a.pop(0)
        elif x in ("--strength", "--floor"):
            try:
                opt[x[2:]] = float(a.pop(0))
            except (ValueError, IndexError):
                print(f"conv: {x} takes a number of decibels", file=sys.stderr)
                return 2
        elif x in ("--key", "--cert", "--field", "--reason", "--self-signed"):
            opt[x[2:].replace("-", "_")] = a.pop(0)
        elif x == "--chain":
            opt["chain"].append(a.pop(0))
        else:
            rest.append(x)
    if not rest:
        print(__doc__)
        return 2
    cmd, args = rest[0], rest[1:]
    ok = True
    if cmd == "merge":
        ok = len(args) >= 2 and pdf_merge(args, opt["o"])
    elif cmd == "split":
        ok = bool(args) and pdf_split(args[0], opt["every"], opt["dir"])
    elif cmd == "pages":
        ok = len(args) == 2 and pdf_pages(args[0], args[1], opt["o"], opt["dir"])
    elif cmd == "rotate":
        ok = len(args) == 2 and args[1] in ("90", "180", "270") and pdf_rotate(args[0], args[1], opt["pages"], opt["o"], opt["dir"])
    elif cmd in ("compress", "shrink"):
        for f in args:
            ok &= compress(f, opt["o"] if len(args) == 1 else None, opt["dir"])
    elif cmd == "ocr":
        ok = bool(args) and ocr(args[0], opt["o"], opt["dir"])
    elif cmd == "unlock":
        ok = bool(args) and unlock(args[0], opt["o"], opt["dir"])
    elif cmd == "redact":
        ok = len(args) >= 2 and redact(args[0], args[1:], opt["regex"], opt["o"], opt["dir"])
    elif cmd == "fields":
        ok = bool(args) and fields(args[0])
    elif cmd == "fill":
        ok = len(args) == 2 and fill(args[0], args[1], opt["flatten"], opt["o"], opt["dir"])
    elif cmd == "sign":
        if not args:
            ok = False
        else:
            key, cert = (opt["key"], opt["cert"]) if opt["key"] else (self_signed(opt["self_signed"]) if opt["self_signed"] else (None, None))
            if not key:
                print("conv sign FILE --key k.pem --cert c.pem   or   --self-signed \"Your Name\"", file=sys.stderr)
                ok = False
            else:
                ok = sign(args[0], key, cert, opt["chain"], opt["field"], opt["reason"], opt["o"], opt["dir"])
    elif cmd == "verify":
        ok = bool(args) and verify(args[0], opt["cert"])
    elif cmd == "strip":
        for f in args:
            ok &= strip(f, opt["o"] if len(args) == 1 else None, opt["dir"])
    elif cmd == "trim":
        ok = len(args) >= 2 and trim(args[0], args[1], args[2] if len(args) > 2 else None, opt["o"], opt["dir"])
    elif cmd == "audio":
        ok = bool(args) and audio(args[0], opt["to"], opt["o"], opt["dir"])
    elif cmd == "gif":
        ok = bool(args) and gif(args[0], opt["o"], opt["dir"], opt["fps"], opt["width"])
    elif cmd == "thumbs":
        ok = bool(args) and thumbs(args[0], opt["o"], opt["dir"])
    elif cmd == "subs":
        ok = bool(args) and subs(args[0], opt["lang"], opt["burn"], opt["model"] or "small", opt["o"], opt["dir"])
    elif cmd == "denoise":
        ok = bool(args)
        for f in args:
            ok &= denoise(f, opt["strength"], opt["floor"], opt["model"], opt["o"] if len(args) == 1 else None, opt["dir"])
    elif cmd == "stems":
        ok = bool(args)
        for f in args:
            ok &= stems(f, opt["two"], opt["model"], opt["o"] if len(args) == 1 else None, opt["dir"])
    elif cmd == "extract":
        ok = bool(args)
        for f in args:
            ok &= extract(f, opt["dir"])
    else:
        files = rest
        if not opt["to"]:
            print("conv FILE... --to EXT  (or merge, split, pages, rotate, compress, ocr, unlock, redact, fields, fill, sign, verify, strip, extract, trim, audio, gif, thumbs, subs, denoise, stems)", file=sys.stderr)
            return 2
        for f in files:
            if f.startswith(("http://", "https://")):
                ok &= url_convert(f, opt["to"], opt["o"] if len(files) == 1 else None, opt["dir"])
            else:
                ok &= convert_one(f, opt["to"], opt["o"] if len(files) == 1 else None, opt["dir"])
    if AS_JSON:
        for m in made:
            print(json.dumps(m))
    return 0 if ok else 1


if __name__ == "__main__":
    import logging
    logging.getLogger("pypdf").setLevel(logging.ERROR)
    try:
        sys.exit(main())
    except Exception as e:
        if not type(e).__module__.startswith(("pypdf", "fitz", "pymupdf")):
            raise
        # a file that isn't the PDF its name says, or a damaged one: one line, not a library's traceback
        print(f"conv: that isn't a PDF this can read ({type(e).__name__}: {str(e)[:120]}). `file NAME` says what it really is.", file=sys.stderr)
        sys.exit(1)
