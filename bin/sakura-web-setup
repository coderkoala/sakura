#!/usr/bin/env bash
# sakura-web-setup — install what better web access needs. Safe to run again.
#   a Python environment with trafilatura and Playwright, plus its headless Chromium
#   SearXNG in Docker, listening on 127.0.0.1:8888 only
# Sakura works without these, with plainer fetching and fewer search results.
set -eu
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/sakura"
ENVDIR="$DATA/webenv"
CONF="$HOME/.config/sakura"
IMAGE="${SAKURA_SEARXNG_IMAGE:-docker.io/searxng/searxng:latest}"
PORT="${SAKURA_SEARXNG_PORT:-8888}"
mkdir -p "$DATA" "$CONF"

command -v uv >/dev/null || { echo "needs uv: https://docs.astral.sh/uv/" >&2; exit 1; }
[ -x "$ENVDIR/bin/python" ] || uv venv -q "$ENVDIR"
uv pip install -q --python "$ENVDIR/bin/python" trafilatura playwright
"$ENVDIR/bin/python" -m playwright install chromium >/dev/null
echo "web environment: $ENVDIR"

if ! command -v docker >/dev/null; then
    echo "no Docker, so no SearXNG: search falls back to the other sources" >&2
    exit 0
fi
if [ ! -s "$CONF/searxng.secret" ]; then
    (umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$CONF/searxng.secret")
fi
docker rm -f sakura-searxng >/dev/null 2>&1 || true
docker pull -q "$IMAGE" >/dev/null
docker run -d --name sakura-searxng --restart unless-stopped -p "127.0.0.1:$PORT:8080" \
    -e "SEARXNG_SECRET=$(cat "$CONF/searxng.secret")" \
    -v "$ROOT/mcp/sakura-web/searxng/settings.yml:/etc/searxng/settings.yml:ro" "$IMAGE" >/dev/null
echo "SearXNG: http://127.0.0.1:$PORT"
