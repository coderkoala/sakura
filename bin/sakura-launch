#!/usr/bin/env bash
# sakura-launch [request...] — open Sakura in a fresh session. This is what the `?` key runs.
#
# Uses the big driver if this machine qualifies (sakura-model), otherwise the 9b on Ollama. Sakura's own hooks do its
# lookups, so they have to run on every launch. Set SAKURA_MODEL to force a model, or SAKURA_FAST=1 for the 2b.
#   --coordinator   a session that plans and hands the work to disposable workers (the `??` key)
#   --exec ARGS     a one-shot `sakura exec` on the same model (how sakura-worker runs)
set -u
# sudo -A inside Sakura: the askpass is Sakura's, so it's set here, not in every shell.
export SUDO_ASKPASS="${SUDO_ASKPASS:-$HOME/.config/sakura/askpass}"
mode=tui
case "${1:-}" in
    --coordinator) mode=coordinator; shift; export SAKURA_COORDINATOR=1 ;;
    --exec) mode=exec; shift ;;
esac
flags=(--dangerously-bypass-hook-trust)
# ssh and scp that fail instead of waiting for a password nobody can type (see shims/ssh).
# Tools Sakura kept for itself go last, so they can't stand in for anything already installed.
PATH="$(dirname "$(dirname "$(readlink -f "$0")")")/shims:$PATH:${SAKURA_TOOLS_DIR:-$HOME/.sakura/tools}/bin"
export PATH
# A worker's commands run with nobody watching, so they run behind the engine's own sandbox, not behind patterns:
# no network unless SAKURA_WORKER_NET=1, writes only to its directory, /tmp, ~/.cache and SAKURA_WORKER_WRITE (colon-separated),
# and no reading keys, agents or sockets that act as you unless SAKURA_WORKER_SECRETS names them (worker_hidden).
# Two things would walk straight through it, so they go too: an exec-policy "allow" rule skips the sandbox entirely, and
# rules/safe-reads.rules allows fetch_url and live, so a worker gets a home with no rules. MCP servers run outside it.
worker_wall() {
    if [ "${SAKURA_WORKER_NO_WALL:-0}" = 1 ]; then
        echo "sakura: this worker has no sandbox, because SAKURA_WORKER_NO_WALL=1" >&2
        return
    fi
    local real="${SAKURA_HOME:-$HOME/.sakura}" home entry
    home="$real/.worker-home"
    mkdir -p "$home"
    for entry in "$real"/* "$real"/.[!.]*; do
        case "${entry##*/}" in rules|.worker-home|'*'|'.[!.]*') continue ;; esac
        ln -sfn "$entry" "$home/${entry##*/}"
    done
    rm -f "$home/rules"
    export CODEX_HOME="$home" INTERPRETER_HOME="$home"
    if ! sakura sandbox -c 'sandbox_mode="workspace-write"' -- true >/dev/null 2>&1; then
        echo "sakura: the sandbox doesn't work on this machine, so the worker won't start. Unprivileged user namespaces are probably off: try 'sudo sysctl kernel.apparmor_restrict_unprivileged_userns=0'. To run workers without a wall anyway, set SAKURA_WORKER_NO_WALL=1 yourself." >&2
        exit 78
    fi
    # One permission profile: :workspace (its directory and /tmp writable, .git read-only), plus ~/.cache and the
    # job's write: paths, minus what acts as you (worker_hidden). The network is off unless the job asks for it.
    local fs="" path rest net=false
    fs_add() { local p="${1//\\/\\\\}"; fs+="${fs:+,}\"${p//\"/\\\"}\"=\"$2\""; }
    mkdir -p "$HOME/.cache"
    fs_add "$HOME/.cache" write
    rest="${SAKURA_WORKER_WRITE:-}"
    while [ -n "$rest" ]; do
        path="${rest%%:*}"
        [ "$rest" = "$path" ] && rest="" || rest="${rest#*:}"
        path="${path/#\~/$HOME}"
        # The engine can't mount a path that isn't there, and then every command fails, so make it or leave it out.
        [ -n "$path" ] && { [ -e "$path" ] || mkdir -p "$path" 2>/dev/null; } && [ -e "$path" ] && fs_add "$path" write
    done
    while IFS= read -r path; do
        [ -n "$path" ] && fs_add "$path" deny
    done < <(worker_hidden | while IFS= read -r p; do [ -n "$p" ] && readlink -m "$p"; done | awk '!seen[$0]++')  # real paths: bwrap can't mask through a symlink, and a repeated key is a TOML error
    [ "${SAKURA_WORKER_NET:-0}" = 1 ] && net=true
    local wall=(-c 'default_permissions="sakura-worker"' -c 'permissions.sakura-worker.extends=":workspace"'
                -c "permissions.sakura-worker.filesystem={$fs}" -c "permissions.sakura-worker.network.enabled=$net")
    # A profile the engine rejects would fail every command, so prove it first.
    if ! sakura sandbox "${wall[@]}" -- true >/dev/null 2>&1; then
        echo "sakura: the worker's sandbox profile didn't load, so the worker won't start: sakura sandbox ${wall[*]} -- true" >&2
        exit 78
    fi
    flags+=(-c 'approval_policy="never"' "${wall[@]}")
    [ "$net" = true ] || flags+=(-c 'mcp_servers.sakura-web.enabled=false')
}

# What a worker can't read: keys, agents and sockets that act as you. A job gets a kind back by naming it
# (SAKURA_WORKER_SECRETS, from its `secrets:` line: ssh, docker, mail, cloud, desktop). The sudo password and the
# shell's secrets file stay hidden whatever the job says.
worker_hidden() {
    local run="/run/user/$(id -u)" h="$HOME" allow=" ${SAKURA_WORKER_SECRETS:-} "
    allow="${allow//[:,]/ }"
    case "$allow" in *" ssh "*) ;; *) printf '%s\n' "$h/.ssh" "$run/openssh_agent" "$run/keyring/ssh" "$run/gcr/ssh" "${SSH_AUTH_SOCK:-}" ;; esac
    case "$allow" in *" docker "*) ;; *) printf '%s\n' /run/docker.sock /var/run/docker.sock "$run/docker.sock" /run/containerd/containerd.sock \
        /run/podman/podman.sock "$run/podman" "$h/.docker" ;; esac
    case "$allow" in *" mail "*) ;; *) printf '%s\n' "$h/.password-store" "$h/.gnupg" "$run/gnupg" "$h/.local/share/keyrings" "$run/keyring" \
        "$h/.config/himalaya" "$h/.mbsyncrc" "$h/.msmtprc" ;; esac
    case "$allow" in *" cloud "*) ;; *) printf '%s\n' "$h/.aws" "$h/.config/gcloud" "$h/.kube" "$h/.azure" "$h/.netrc" "$h/.git-credentials" \
        "$h/.config/gh" "$h/.npmrc" "$h/.pypirc" "$h/.terraform.d" "$h/.cargo/credentials.toml" "$h/.config/rclone" ;; esac
    case "$allow" in *" desktop "*) ;; *) printf '%s\n' "$run/bus" ;; esac
    printf '%s\n' "$h/.config/sakura/sudo.pass" "$h/.secrets.local"
}
big="${SAKURA_BIG_MODEL:-huihui_ai/qwen3.5-abliterated:9b}"
fast="${SAKURA_FAST_MODEL:-huihui_ai/qwen3.5-abliterated:2b}"

if ! command -v sakura >/dev/null 2>&1; then
    echo "sakura: the binary isn't installed. To build it, see patches/README.md in the Sakura repo." >&2
    exit 127
fi

if [ -n "${SAKURA_MODEL:-}" ]; then
    flags+=(--model "$SAKURA_MODEL")
elif [ "${SAKURA_FAST:-0}" = 1 ]; then
    flags+=(--model "$fast")
elif command -v sakura-model >/dev/null 2>&1 && sakura-model up 2>/dev/null; then
    flags+=(--model qwen36-q3 -c 'model_providers.local-ollama.base_url="http://127.0.0.1:8091/v1"')
    export SAKURA_ROUTER_URL=http://127.0.0.1:8091/v1
else
    flags+=(--model "$big")
    if ! curl -fsS --max-time 3 "${OLLAMA_API_BASE:-http://127.0.0.1:11434}/api/version" >/dev/null 2>&1; then
        echo "sakura: Ollama isn't answering, so there's no model to run. Start it with: sudo systemctl start ollama" >&2
        exit 1
    fi
    if ! ollama list 2>/dev/null | awk 'NR>1{print $1}' | grep -qx "$big"; then
        # First start: there's nothing to run without it, so wait for this one; the rest come in the background below.
        echo "sakura: first start, downloading $big (6.6 GB); the other models follow in the background." >&2
        if ! ollama pull "$big"; then
            echo "sakura: couldn't download $big. Try again with: ollama pull $big" >&2
            exit 1
        fi
    fi
fi

# Every model that suits this machine (sakura-model models), fetched in the background when some are missing.
# Checked once a day, not on every launch; workers never start downloads.
if [ "$mode" != exec ] && [ "${SAKURA_NO_AUTOPULL:-0}" != 1 ] && command -v sakura-model >/dev/null 2>&1; then
    stamp="${SAKURA_HOME:-$HOME/.sakura}/models-checked"
    if [ "$(cat "$stamp" 2>/dev/null)" != "$(date +%F)" ]; then
        date +%F > "$stamp" 2>/dev/null
        if sakura-model models 2>/dev/null | grep -q '^  missing'; then
            sakura-model pull-all --background >&2 || true
        fi
    fi
fi

if [ "$mode" = exec ]; then
    [ -n "${SAKURA_WORKER:-}" ] && worker_wall
    exec sakura exec "${flags[@]}" "$@"
fi
# sakura-trust on (or SAKURA_TRUST=1 for one session): no approval prompts. The guard, ?undo and ?recap stay.
trust="${SAKURA_TRUST:-}"
[ -z "$trust" ] && [ -e "${SAKURA_HOME:-$HOME/.sakura}/trust" ] && trust=1
[ "$trust" = 1 ] && flags+=(-c 'approval_policy="never"')
if [ "$#" -gt 0 ]; then
    exec sakura "${flags[@]}" "$*"
fi
exec sakura "${flags[@]}"
