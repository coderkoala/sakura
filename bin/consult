#!/usr/bin/env python3
"""consult <role|model> "<question>"  — ask a specialist local model one question, get text back.

Only the qwen3.5-abliterated family emits real tool calls, so it stays the agentic driver. But for a
hard, self-contained sub-problem a specialist model may answer better. `consult` sends ONE prompt to a
specialist (no tools, no session) and prints its answer, so the driver can fold it into the work. This
is how a persona "pulls its own model" without handing over the tool-calling session.

Roles (resolve to an Ollama model; edit the map or pass a raw model name):
  coder        qwen2.5-coder 14b  — hard code/algorithms (slow on 8 GB; worth it for a gnarly problem)
  coder-fast   qwen2.5-coder 3b   — quick code snippets
  reason       qwen2.5 14b        — deeper general reasoning than the 9b driver
  security     WhiteRabbitNeo 8b  — security / exploitation phrasing
  prose        dolphin3.0 8b      — long-form writing

If the big driver (sakura-model) holds the card and the specialist wouldn't fit beside it, the driver answers instead
and the output says so: spilling onto the CPU would take minutes and slow the session down too.

Usage:
  consult coder "write a correct LRU cache in Rust with O(1) ops"
  consult "huihui_ai/qwen2.5-coder-abliterate:14b" "..."     # raw model name also works
  echo "long prompt on stdin" | consult reason
Env: CONSULT_TIMEOUT (seconds, default 180), CONSULT_NUM_PREDICT (default 1024).
"""
import json
import os
import subprocess
import sys
import urllib.request

import importlib.machinery as _im
_choices = _im.SourceFileLoader("sakura_choices", os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib", "sakura_choices.py")).load_module()
# The model behind each role: your pick (sakura-model pick coder …), else Sakura's default.
ROLES = {r: _choices.get(r) for r in ("coder", "coder-fast", "reason", "security", "prose")}
BASE = os.environ.get("OLLAMA_API_BASE", "http://127.0.0.1:11434")
DRIVER = os.environ.get("SAKURA_DRIVER_URL", "http://127.0.0.1:8091")


def driver_holds_card(model):
    """True if the big driver is running and `model` needs more VRAM than is free next to it."""
    try:
        urllib.request.urlopen(DRIVER + "/health", timeout=2)
        free = int(subprocess.check_output(["nvidia-smi", "--query-gpu=memory.free", "--format=csv,noheader,nounits"],
                                           text=True, timeout=5).split()[0])
        tags = json.loads(urllib.request.urlopen(BASE + "/api/tags", timeout=5).read())["models"]
        size = next(m["size"] for m in tags if m["name"] in (model, model + ":latest")) / 1048576
    except Exception:
        return False
    return size * 1.15 > free


def ask_driver(prompt, timeout):
    body = json.dumps({"model": "driver", "messages": [{"role": "user", "content": prompt}], "temperature": 0.2,
                       "max_tokens": int(os.environ.get("CONSULT_NUM_PREDICT", 1024)),
                       "reasoning_effort": "none"}).encode()
    req = urllib.request.Request(DRIVER + "/v1/chat/completions", data=body, headers={"Content-Type": "application/json"})
    return json.loads(urllib.request.urlopen(req, timeout=timeout).read())["choices"][0]["message"].get("content") or ""


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    if len(sys.argv) < 2:
        sys.exit("usage: consult <role|model> \"<question>\"  (roles: " + ", ".join(ROLES) + ")")
    who = sys.argv[1]
    model = ROLES.get(who, who)  # a role, else treat as a raw model name
    prompt = " ".join(sys.argv[2:]).strip()
    if not prompt:
        prompt = sys.stdin.read().strip()
    if not prompt:
        sys.exit("consult: no question given (as args or on stdin)")
    timeout = int(os.environ.get("CONSULT_TIMEOUT", 180))
    if driver_holds_card(model):
        try:
            text = ask_driver(prompt, timeout).strip()
        except Exception as e:
            sys.exit(f"consult: the driver failed: {e}")
        if not text:
            sys.exit("consult: the driver returned nothing")
        print(f"[consult:{who} -> driver; {model} doesn't fit in the free VRAM]\n{text}")
        return
    body = json.dumps({
        "model": model, "prompt": prompt, "stream": False, "keep_alive": 0,
        "options": {"temperature": 0.2, "num_predict": int(os.environ.get("CONSULT_NUM_PREDICT", 1024))},
    }).encode()
    req = urllib.request.Request(BASE + "/api/generate", data=body,
                                 headers={"Content-Type": "application/json"})
    try:
        r = json.loads(urllib.request.urlopen(req, timeout=timeout).read())
    except Exception as e:
        sys.exit(f"consult: {model} failed: {e}\n(is Ollama up, and is the model pulled? `ollama pull {model}`)")
    text = (r.get("response") or "").strip()
    if not text:
        sys.exit(f"consult: {model} returned nothing")
    print(f"[consult:{who} -> {model}]\n{text}")


if __name__ == "__main__":
    main()
