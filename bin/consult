#!/usr/bin/env python3
"""consult <role|model> "<question>"  — ask a specialist local model one question, get text back.

Only the qwen3.5-abliterated family emits real tool calls, so it stays the agentic driver. But for a
hard, self-contained sub-problem a specialist model may answer better. `consult` sends ONE prompt to a
specialist (no tools, no session) and prints its answer, so the driver can fold it into the work. This
is how a persona "pulls its own model" without handing over the tool-calling session.

Roles (resolve to an Ollama model; edit the map or pass a raw model name):
  coder        qwen2.5-coder 14b  — hard code/algorithms (slow on 8 GB; worth it for a gnarly problem)
  coder-fast   qwen2.5-coder 3b   — quick code snippets
  reason       qwen2.5 14b        — deeper general reasoning than the 9b driver
  security     WhiteRabbitNeo 8b  — security / exploitation phrasing
  prose        dolphin3.0 8b      — long-form writing

Usage:
  consult coder "write a correct LRU cache in Rust with O(1) ops"
  consult "huihui_ai/qwen2.5-coder-abliterate:14b" "..."     # raw model name also works
  echo "long prompt on stdin" | consult reason
Env: CONSULT_TIMEOUT (seconds, default 180), CONSULT_NUM_PREDICT (default 1024).
"""
import json
import os
import sys
import urllib.request

ROLES = {
    "coder": "huihui_ai/qwen2.5-coder-abliterate:14b",
    "coder-fast": "huihui_ai/qwen2.5-coder-abliterate:3b",
    "reason": "huihui_ai/qwen2.5-abliterate:14b",
    "security": "WhiteRabbitNeo/Llama-3.1-WhiteRabbitNeo-2-8B:latest",
    "prose": "thomboe/dolphin3.0-llama3.1-8b-abliterated:latest",
}
BASE = os.environ.get("OLLAMA_API_BASE", "http://127.0.0.1:11434")


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: consult <role|model> \"<question>\"  (roles: " + ", ".join(ROLES) + ")")
    who = sys.argv[1]
    model = ROLES.get(who, who)  # a role, else treat as a raw model name
    prompt = " ".join(sys.argv[2:]).strip()
    if not prompt:
        prompt = sys.stdin.read().strip()
    if not prompt:
        sys.exit("consult: no question given (as args or on stdin)")
    body = json.dumps({
        "model": model, "prompt": prompt, "stream": False,
        "options": {"temperature": 0.2, "num_predict": int(os.environ.get("CONSULT_NUM_PREDICT", 1024))},
    }).encode()
    req = urllib.request.Request(BASE + "/api/generate", data=body,
                                 headers={"Content-Type": "application/json"})
    try:
        r = json.loads(urllib.request.urlopen(req, timeout=int(os.environ.get("CONSULT_TIMEOUT", 180))).read())
    except Exception as e:
        sys.exit(f"consult: {model} failed: {e}\n(is Ollama up, and is the model pulled? `ollama pull {model}`)")
    text = (r.get("response") or "").strip()
    if not text:
        sys.exit(f"consult: {model} returned nothing")
    print(f"[consult:{who} -> {model}]\n{text}")


if __name__ == "__main__":
    main()
