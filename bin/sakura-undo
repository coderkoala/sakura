#!/usr/bin/env python3
"""sakura-undo — put back everything Sakura's last turn changed (the `?undo` key). Run it again to redo.

  ?undo                 show what the last change set did, then put it back once you say yes
  ?undo --yes           without asking
  ?undo --list          the recent change sets, newest first
  ?undo --key KEY       a particular one from --list

Before the first command in a turn that might write, the guard's undo hook snapshots the directory and every file the
command names (hooks/undo_snapshot.py). Undo restores modified and deleted files and removes created ones; it snapshots
the present first, so undoing the undo redoes. Nothing outside this machine can be undone: a push, a mail, a deploy.
"""
import importlib.machinery
import os
import sys
import time

MANAGED = "/usr/local/lib/sakura/guard/undo_snapshot.py"
REPO = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "hooks", "undo_snapshot.py")
u = importlib.machinery.SourceFileLoader("undo_snapshot", MANAGED if os.path.isfile(MANAGED) else REPO).load_module()


def short(p):
    home = os.path.expanduser("~")
    return "~" + p[len(home):] if p == home or p.startswith(home + "/") else p


def describe(rec):
    when = time.strftime("%a %H:%M", time.localtime(rec["time"]))
    where = ", ".join(short(d["dir"]) for d in rec["dirs"]) or "named files only"
    first = (rec["commands"] or ["?"])[0].splitlines()[0][:70]
    return f"{when}  {where}  ({len(rec['commands'])} commands, first: {first})"


def main():
    args = sys.argv[1:]
    if "-h" in args or "--help" in args:
        print(__doc__.strip())
        return 0
    recs = u.records()
    if "--list" in args:
        for r in recs[:15]:
            print(f"{'undone ' if r['undone'] else '       '}{r['key']}\n         {describe(r)}")
        return 0
    if "--key" in args:
        key = args[args.index("--key") + 1] if args.index("--key") + 1 < len(args) else ""
        recs = [r for r in recs if r["key"] == key]
        if not recs:
            print(f"sakura-undo: no change set {key!r}; see sakura-undo --list", file=sys.stderr)
            return 1
        rec = recs[0]
    else:
        rec = next((r for r in recs if not r["undone"]), None)
        if not rec:
            print("Nothing to undo: Sakura hasn't changed anything since the snapshots began.")
            return 0
    todo = u.changes(rec)
    print(f"Last change set: {describe(rec)}")
    if rec.get("skipped"):
        print("  (too big to snapshot whole, so only the files its commands named: " + ", ".join(short(d) for d in rec["skipped"]) + ")")
    if not todo:
        print("Nothing differs from before it any more.")
        rec["undone"] = True
        u.store_record(rec)
        return 0
    for action, path, _ in todo:
        print(f"  {'put back' if action == 'restore' else 'remove  '}  {short(path)}")
    if "--yes" not in args and "-y" not in args:
        if not sys.stdin.isatty():
            print("sakura-undo: not a terminal; rerun with --yes to apply", file=sys.stderr)
            return 1
        if input(f"Put these {len(todo)} back? [y/N] ").strip().lower() not in ("y", "yes"):
            print("Left as it is.")
            return 0
    errors = u.undo(rec, todo)
    for e in errors:
        print(f"  couldn't: {e}", file=sys.stderr)
    print(f"Done: {len(todo) - len(errors)} of {len(todo)} put back. ?undo again puts them back the way they were.")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
