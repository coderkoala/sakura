#!/usr/bin/env bash
# sakura-trust on|off|status — whether Sakura asks before each command that changes something.
#
# On (the default), nothing asks: the guard still refuses what's mechanically closed (the guard itself, search-engine scraping, mail the
# user wanted to see first, installing round a kept tool's check, …), every write is still snapshotted for ?undo, and ?recap
# still records it all. Workers always run without approvals; this is about the session you're sitting at.
# Off, the TUI stops at every mutating or unknown command: q approves, w says "no, do this instead".
# One session only: SAKURA_TRUST=0 ? ...   or   SAKURA_TRUST=1 ? ... despite the switch.
set -u
case "${1:-}" in -h|--help) sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p}' "$0"; exit 0 ;; esac
file="${SAKURA_HOME:-$HOME/.sakura}/ask"
rm -f "${SAKURA_HOME:-$HOME/.sakura}/trust" 2>/dev/null  # the old opt-in marker; trust is the default now
case "${1:-status}" in
    on)  rm -f "$file" && echo "Sakura won't ask before commands (the default). ?undo puts a turn back, ?recap shows what it did. sakura-trust off to ask again." ;;
    off) mkdir -p "$(dirname "$file")" && : > "$file" && echo "Sakura asks before each command that changes something (q yes, w do it differently)." ;;
    status) if [ -e "$file" ]; then echo "off: Sakura asks before commands that change something"; else echo "on: Sakura doesn't ask before commands"; fi ;;
    *) echo "usage: sakura-trust on|off|status" >&2; exit 2 ;;
esac
