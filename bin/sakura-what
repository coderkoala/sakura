#!/usr/bin/env python3
"""sakura-what — which command does this? Ask in your own words; the answer comes from every tool's own manual, with no model.

  sakura-what "merge two pdfs"           the commands that do it, best first, each with the line of its manual that matched
  sakura-what                            what Sakura can do, grouped by situation (from AGENTS.md), one line per command
  sakura-what --keys                     the ? keys (the header of shell/sakura.bash)
  sakura-what TOOL                       that tool's manual (same as TOOL --help)
  --json                                 for other tools (sakura-how asks here first, before it asks the model)
It reads bin/*'s headers at run time, so a new command is findable the moment it exists. The `?what` key runs it.
"""
import json
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
BIN = os.path.join(ROOT, "bin")
# words people say → words the manuals use. Both sides are matched, so this only adds reach.
SYNONYMS = {
