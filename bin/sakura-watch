#!/usr/bin/env python3
"""sakura-watch [-n SECONDS] [--count N] [--explain] COMMAND... — rerun a command and show what changed between runs. The `?watch` key.

  ?watch -n 5 'df -h /'                      every 5 s (default 10), with the lines that changed highlighted
  ?watch 'ssh starlight systemctl --failed'  over ssh works the same
  ?watch --explain 'curl -s localhost:8080/health'   when the output changes, Sakura explains the change, once per change,
                                                      in a one-shot run; the loop goes on
  -n SECONDS    how often (default 10)
  --count N     stop after N runs (scripts and tests); without it, Ctrl-C stops it
  --explain     as above
Options come before the command; everything from its first word on is the command (`?watch df -h /` runs `df -h /`).
Nothing is changed anywhere; it only runs the command you gave.
"""
import difflib
import os
import subprocess
import sys
import time

CLEAR = "\033[H\033[2J"
RED, GREEN, DIM, OFF = "\033[31m", "\033[32m", "\033[2m", "\033[0m"


def run(cmd):
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=120)
        return (r.stdout + r.stderr).rstrip("\n")
    except subprocess.TimeoutExpired:
        return "(timed out after 120 s)"


def explain(cmd, before, after):
    diff = "\n".join(difflib.unified_diff(before.splitlines(), after.splitlines(), "before", "after", lineterm="", n=1))
    brief = (f"I'm watching `{cmd}`. Its output just changed. Explain what the change means and whether it needs anything from me, in at most "
             f"four lines. Don't run anything.\n\n```diff\n{diff[:6000]}\n```")
    try:
        r = subprocess.run(["sakura-launch", "--exec", "--skip-git-repo-check", brief], capture_output=True, text=True, timeout=300)
        text = r.stdout.strip().splitlines()
        return "\n".join(l for l in text if l.strip())[-1200:]
    except (OSError, subprocess.SubprocessError):
        return "(no explanation: sakura-launch failed)"


def main(argv):
    every, count, want_explain, words = 10.0, 0, False, []
    it = iter(argv)
    for a in it:
        if a in ("-n", "--count"):
            try:
                v = float(next(it, ""))
                if v < 0 or (a == "--count" and (v < 1 or v != int(v))):
                    raise ValueError
            except ValueError:
                print(f"sakura-watch: {a} takes a number ({'runs' if a == '--count' else 'seconds'})", file=sys.stderr)
                return 2
            if a == "-n":
                every = v
            else:
                count = int(v)
        elif a == "--explain":
            want_explain = True
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        else:
            # The command starts here, and its own options (df -h) are its own.
            words = [a] + list(it)
    cmd = " ".join(words).strip()
    if not cmd:
        print(__doc__.strip())
        return 2
    tty = sys.stdout.isatty()
    prev, note, changes, runs = None, "", 0, 0
    try:
        while True:
            out = run(cmd)
            runs += 1
            if tty:
                sys.stdout.write(CLEAR)
            stamp = time.strftime("%H:%M:%S")
            changed = prev is not None and prev != out
            changes += changed  # counted before the header, so the run that shows a change also counts it
            print(f"{DIM if tty else ''}every {every:g}s  {stamp}  {cmd}  ({changes} change{'s' if changes != 1 else ''}){OFF if tty else ''}")
            if not changed:
                print(out)
            else:
                before, after = prev.splitlines(), out.splitlines()
                for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, before, after).get_opcodes():
                    if tag == "equal":
                        print("\n".join(after[j1:j2]))
                    else:
                        for l in before[i1:i2]:
                            print(f"{RED if tty else ''}- {l}{OFF if tty else ''}")
                        for l in after[j1:j2]:
                            print(f"{GREEN if tty else ''}+ {l}{OFF if tty else ''}")
                if want_explain:
                    note = explain(cmd, prev, out)
            if note:
                print(f"\n{DIM if tty else ''}sakura:{OFF if tty else ''} {note}")
            prev = out
            sys.stdout.flush()
            if count and runs >= count:
                return 0
            time.sleep(every)
    except KeyboardInterrupt:
        print()
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
