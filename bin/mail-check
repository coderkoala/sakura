#!/usr/bin/env bash
# Check for unseen mail via himalaya and notify. Run by the mail-check systemd user timer.
# Account via MAIL_CHECK_ACCOUNT (default: himalaya's default account).
set -u
command -v himalaya >/dev/null 2>&1 || exit 0
acc="${MAIL_CHECK_ACCOUNT:-}"; args=(envelope list -o json); [ -n "$acc" ] && args=(-a "$acc" "${args[@]}")
json="$(himalaya "${args[@]}" -- NOT SEEN 2>/dev/null)" || exit 0
n="$(printf '%s' "$json" | python3 -c 'import json,sys;print(len(json.load(sys.stdin)))' 2>/dev/null || echo 0)"
[ "${n:-0}" -gt 0 ] && "$(dirname "$0")/notify" "Mail: $n unread" "$(printf '%s' "$json" | python3 -c 'import json,sys;[print("• "+e.get("from",{}).get("name") or e.get("from",{}).get("addr","?"),"—",e.get("subject","")[:60]) for e in json.load(sys.stdin)[:5]]' 2>/dev/null)"
exit 0
