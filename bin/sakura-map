KIND_WEIGHT = {"class": 1.0, "type": 1.0, "function": 1.0, "component": 1.0, "method": 0.8, "route": 0.8, "macro": 0.6, "const": 0.5}
KIND_WORDS = {"route": "route", "endpoint": "route", "url": "route", "component": "component", "macro": "macro"}
IDENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]{2,}")
IDENT_FULL = re.compile(r"[A-Za-z_]\w*$")
DOTTED = re.compile(r"[A-Za-z_]\w*(?:[-.][A-Za-z0-9_]+)+")


def sig(raw):
    s = " ".join(raw.split()).rstrip("{").rstrip()
    return s if len(s) <= SIG_WIDTH else s[:SIG_WIDTH - 1] + "…"


# ---- definitions, language by language -------------------------------------------------------------------------------------

STRINGS = re.compile(r'"(?:\\.|[^"\\\n])*"|\'(?:\\.|[^\'\\\n])*\'|`(?:\\.|[^`\\\n])*`')
STRINGS_C = re.compile(r'"(?:\\.|[^"\\\n])*"|\'(?:\\.|[^\'\\\n]){1,2}\'')   # 'a' and '\n' are characters; Rust's 'a is a lifetime
CONTINUES = ("{", "extends", "implements", ":", "where", ",", ")", "with", "permits")


def scan(text, opener, strings=STRINGS, hash_comments=False):
    """Walk brace-delimited source a line at a time: (line number, the raw line, the line with strings and comments
    blanked, at_decl, parent, depth). `opener(clean)` names the container a line opens (a class, an impl, a namespace;
    "" for one with no name) or returns None. at_decl is true at the top level and directly inside a container, false
    inside a function body, so a statement is never read as a declaration."""
    stack, pending, parens, in_comment = [], None, 0, False
    for no, raw in enumerate(text.split("\n"), 1):
        line = raw
        if in_comment:
            end = line.find("*/")
            if end < 0:
                continue
            line, in_comment = line[end + 2:], False
        line = strings.sub('""', line)
        line = re.sub(r"/\*.*?\*/", " ", line)
        start = line.find("/*")
        if start >= 0:
            line, in_comment = line[:start], True
        line = re.sub(r"//.*", "", line)
        if hash_comments:
            line = re.sub(r"(?:^|\s)#(?!\[).*", "", line)
        if pending is not None:  # a container whose `{` hasn't come yet: only a continuation line keeps it waiting
            s = line.strip()
            if s and parens <= 0 and not s.startswith(CONTINUES):
                pending = None
        at_decl = not stack or stack[-1] is not None
        parent = next((s for s in reversed(stack) if s), None) if at_decl else None
        yield no, raw, line, at_decl, parent, len(stack)
        name = opener(line)
        if name is not None:
            pending, parens = name, 0
        for ch in line:
            if ch == "{":
                stack.append(pending)
                pending = None
            elif ch == "}":
                if stack:
                    stack.pop()
            elif ch == "(":
                parens += 1
            elif ch == ")":
                parens -= 1
            elif ch == ";" and parens <= 0:
                pending = None


def py_defs(text):
    """Python, exactly: top-level functions, classes and their methods, CONSTANTS, and decorator routes."""
    tree = ast.parse(text)
    lines, out = text.split("\n"), []

    def visit(body, parent):
        for n in body:
            if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)):
                s = ("async " if isinstance(n, ast.AsyncFunctionDef) else "") + f"def {n.name}({ast.unparse(n.args)})"
                if n.returns is not None:
                    s += f" -> {ast.unparse(n.returns)}"
                out.append([n.name, "method" if parent else "function", n.lineno, sig(s), parent])
                for d in n.decorator_list:
                    if (isinstance(d, ast.Call) and isinstance(d.func, ast.Attribute) and d.args and isinstance(d.args[0], ast.Constant)
                            and isinstance(d.args[0].value, str) and d.func.attr in ("route", "get", "post", "put", "delete", "patch", "websocket")):
                        verb = "ANY" if d.func.attr == "route" else d.func.attr.upper()
                        out.append([f"{verb} {d.args[0].value}", "route", n.lineno, sig(f"@{ast.unparse(d)} def {n.name}"), parent])
            elif isinstance(n, ast.ClassDef):
                bases = ", ".join(ast.unparse(b) for b in n.bases)
                out.append([n.name, "class", n.lineno, sig(f"class {n.name}" + (f"({bases})" if bases else "")), parent])
                visit(n.body, n.name)
            elif isinstance(n, (ast.Assign, ast.AnnAssign)) and parent is None:
                targets = n.targets if isinstance(n, ast.Assign) else [n.target]
                if len(targets) == 1 and isinstance(targets[0], ast.Name) and re.match(r"[A-Z][A-Z0-9_]{2,}$", targets[0].id):
                    out.append([targets[0].id, "const", n.lineno, sig(lines[n.lineno - 1]), None])
            elif isinstance(n, (ast.If, ast.Try)) and parent is None:
                visit(n.body, None)
                visit(n.orelse, None)
                for h in getattr(n, "handlers", []):
                    visit(h.body, None)

    visit(tree.body, None)
    return out


def py_defs_loose(text):
    """Python that doesn't parse (half-written, Python 2, a merge conflict): the def and class lines, by indentation."""
    out, classes = [], []
    for no, raw in enumerate(text.split("\n"), 1):
        m = re.match(r"(\s*)(?:async\s+)?(def|class)\s+([A-Za-z_]\w*)", raw)
        if not m:
            continue
        indent = len(m.group(1).expandtabs(4))
        classes = [c for c in classes if c[0] < indent]
        parent = classes[-1][1] if classes else None
        if m.group(2) == "class":
            out.append([m.group(3), "class", no, sig(raw.strip().rstrip(":")), parent])
            classes.append((indent, m.group(3)))
        elif parent or not indent:
            out.append([m.group(3), "method" if parent else "function", no, sig(raw.strip().rstrip(":")), parent])
    return out


JS_NOT_NAMES = {"if", "for", "while", "switch", "catch", "return", "function", "else", "do", "try", "with", "super", "new", "typeof", "await",
                "constructor", "data", "mounted", "created", "setup", "render", "beforeMount", "unmounted", "updated", "destroyed", "beforeDestroy"}
JS_FUNC = re.compile(r"^\s*(?:export\s+)?(?:default\s+)?(?:declare\s+)?(?:async\s+)?function\s*\*?\s*([A-Za-z_$][\w$]*)\s*[(<]")
JS_CLASS = re.compile(r"^\s*(?:export\s+)?(?:default\s+)?(?:declare\s+)?(?:abstract\s+)?class\s+([A-Za-z_$][\w$]*)")
JS_TYPE = re.compile(r"^\s*(?:export\s+)?(?:declare\s+)?(?:interface|enum|namespace|const\s+enum)\s+([A-Za-z_$][\w$]*)"
                     r"|^\s*(?:export\s+)?(?:declare\s+)?type\s+([A-Za-z_$][\w$]*)\s*(?:<[^=]*>)?\s*=")
JS_VAR = re.compile(r"^\s*(export\s+)?(?:declare\s+)?(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*(?::[^=]+)?=\s*(.*)$")
JS_IS_FUNC = re.compile(r"(?:async\s+)?(?:function\b|\([^)]*\)\s*(?::\s*[^=]+?)?=>|[A-Za-z_$][\w$]*\s*=>|\([^)]*$|(?:computed|defineStore)\s*\()")
JS_METHOD = re.compile(r"^\s*(?:(?:public|private|protected|static|async|override|readonly|get|set)\s+)*\*?\s*(#?[A-Za-z_$][\w$]*)\s*(?:<[^>]*>)?"
                       r"\([^)]*\)\s*(?::\s*[^{;]+?)?\s*\{\s*\}?\s*$")
JS_PROP = re.compile(r"^\s*([A-Za-z_$][\w$]*)\s*:\s*(?:async\s+)?(?:function\b|\([^)]*\)\s*=>|[A-Za-z_$][\w$]*\s*=>)")
JS_OBJECT = re.compile(r"^\s*(?:export\s+default\s+(?:defineComponent\s*\(\s*)?\{|module\.exports\s*=\s*\{"
                       r"|(?:methods|computed|watch|actions|getters|mutations)\s*:\s*\{)")
JS_ROUTE = re.compile(r"\b(?:app|router|route|server|api)\.(get|post|put|patch|delete|all)\(\s*(['\"`])(/[^'\"`]*)\2")


def js_opener(line):
    m = JS_CLASS.match(line)
    if m:
        return m.group(1)
    return "" if JS_OBJECT.match(line) else None


def js_defs(text, offset=0):
    out = []
    for no, raw, line, at_decl, parent, depth in scan(text, js_opener):
        no += offset
        m = JS_ROUTE.search(raw)
        if m:
            out.append([f"{m.group(1).upper()} {m.group(3)}", "route", no, sig(raw), None])
        m = JS_FUNC.match(line)
        if m and (at_decl or depth <= 1):
            out.append([m.group(1), "function", no, sig(raw), None])
            continue
        m = JS_CLASS.match(line)
        if m and (at_decl or depth <= 1):
            out.append([m.group(1), "class", no, sig(raw), None])
            continue
        m = JS_TYPE.match(line)
        if m and at_decl:
            out.append([m.group(1) or m.group(2), "type", no, sig(raw), None])
            continue
        m = JS_VAR.match(line)
        if m and at_decl:
            if JS_IS_FUNC.match(m.group(3)):
                out.append([m.group(2), "function", no, sig(raw), None])
            elif m.group(1):
                out.append([m.group(2), "const", no, sig(raw), None])
            continue
        if depth and at_decl:  # directly inside a class or an object of methods
            m = JS_METHOD.match(line) or JS_PROP.match(line)
            if m and m.group(1) not in JS_NOT_NAMES:
                out.append([m.group(1), "method", no, sig(raw), parent])
    return out


def vue_defs(text, rel):
    """A single-file component: the component by its file name, and what its <script> blocks define."""
    out = [[os.path.splitext(os.path.basename(rel))[0], "component", 1, sig(f"<{os.path.splitext(os.path.basename(rel))[0]}> component"), None]]
    for m in re.finditer(r"<script\b[^>]*>(.*?)</script>", text, re.S | re.I):
        out += js_defs(m.group(1), text.count("\n", 0, m.start(1)))
    return out


PHP_TYPE = re.compile(r"^\s*(?:(?:abstract|final|readonly)\s+)*(class|interface|trait|enum)\s+([A-Za-z_]\w*)")
PHP_FUNC = re.compile(r"^\s*(?:(?:public|protected|private|static|abstract|final)\s+)*function\s+&?\s*([A-Za-z_]\w*)\s*\(")
PHP_CONST = re.compile(r"^\s*(?:(?:public|protected|private|final)\s+)*const\s+(?:[?\w|]+\s+)?([A-Za-z_]\w*)\s*=")
PHP_ROUTE = re.compile(r"(?:Route::|->)(get|post|put|patch|delete|options|any|resource|apiResource|view|redirect)\(\s*['\"]([^'\"]*)['\"]")


def php_opener(line):
    m = PHP_TYPE.match(line)
    return m.group(2) if m else None


def php_defs(text):
    out = []
    for no, raw, line, at_decl, parent, depth in scan(text, php_opener, hash_comments=True):
        if "Route::" in raw:
            m = PHP_ROUTE.search(raw)
            if m:
                out.append([f"{m.group(1).upper()} {m.group(2)}", "route", no, sig(raw), None])
                continue
        m = PHP_TYPE.match(line)
        if m and at_decl:
            out.append([m.group(2), "class" if m.group(1) == "class" else "type", no, sig(raw), None])
            continue
        m = PHP_FUNC.match(line)
        if m and (at_decl or depth <= 1):  # helpers.php wraps each function in `if (! function_exists(...))`
            out.append([m.group(1), "method" if parent else "function", no, sig(raw), parent])
            continue
        m = PHP_CONST.match(line)
        if m and at_decl:
            out.append([m.group(1), "const", no, sig(raw), parent])
    return out


GO_FUNC = re.compile(r"^func\s+(?:\(\s*(?:\w+\s+)?\*?\s*([A-Za-z_]\w*)(?:\[[^\]]*\])?\s*\)\s*)?([A-Za-z_]\w*)\s*[(\[]")
GO_ROUTE = re.compile(r"\.(GET|POST|PUT|DELETE|PATCH|Get|Post|Put|Delete|Patch|HandleFunc|Handle)\(\s*\"(/[^\"]*)\"")


def go_defs(text):
    out, in_types = [], False
    for no, raw in enumerate(text.split("\n"), 1):
        if in_types:
            m = re.match(r"\s+([A-Za-z_]\w*)\s+\S", raw)
            if raw.startswith(")"):
                in_types = False
            elif m and raw[:1] in ("\t", " ") and not raw.startswith(("\t\t", "        ")):
                out.append([m.group(1), "type", no, sig("type " + raw.strip()), None])
            continue
        m = GO_FUNC.match(raw)
        if m:
            out.append([m.group(2), "method" if m.group(1) else "function", no, sig(raw), m.group(1)])
            continue
        if re.match(r"type\s*\(\s*$", raw):
            in_types = True
            continue
        m = re.match(r"type\s+([A-Za-z_]\w*)\b", raw)
        if m:
            out.append([m.group(1), "type", no, sig(raw), None])
            continue
        m = re.match(r"(?:const|var)\s+([A-Z]\w*)\b", raw)
        if m:
            out.append([m.group(1), "const", no, sig(raw), None])
            continue
        m = GO_ROUTE.search(raw)
        if m:
            verb = m.group(1).upper()
            out.append([f"{'ANY' if verb.startswith('HANDLE') else verb} {m.group(2)}", "route", no, sig(raw), None])
    return out


RUST_VIS = r"(?:pub(?:\s*\([^)]*\))?\s+)?"
RUST_OPEN = re.compile(r"^\s*" + RUST_VIS + r"(?:unsafe\s+)?(impl|trait|mod)\b\s*(.*)")
RUST_FN = re.compile(r"^\s*" + RUST_VIS + r"(?:(?:default|const|async|unsafe|extern(?:\s*\"\")?)\s+)*fn\s+([A-Za-z_]\w*)")
RUST_TYPE = re.compile(r"^\s*" + RUST_VIS + r"(?:unsafe\s+)?(struct|enum|union|trait|type)\s+([A-Za-z_]\w*)")
RUST_CONST = re.compile(r"^\s*" + RUST_VIS + r"(?:const|static)\s+(?:mut\s+)?([A-Za-z_]\w*)\s*:")


def rust_opener(line):
    m = RUST_OPEN.match(line)
    if not m:
        return None
    if m.group(1) == "mod":
        return "" if "{" in line else None
    rest = m.group(2)
    for _ in range(3):  # impl<T: Bound<U>> Trait<T> for Type<T> → Type
        rest = re.sub(r"<[^<>]*>", "", rest)
    rest = rest.split(" where ")[0].split("{")[0].strip()
    if m.group(1) == "impl" and " for " in rest:
        rest = rest.split(" for ", 1)[1]
    m2 = re.match(r"[&\s]*((?:\w+::)*\w+)", rest.strip())
    return m2.group(1).split("::")[-1] if m2 else ""


def rust_defs(text):
    out = []
    for no, raw, line, at_decl, parent, depth in scan(text, rust_opener, strings=STRINGS_C):
        if not at_decl:
            continue
        m = RUST_FN.match(line)
        if m:
            out.append([m.group(1), "method" if parent else "function", no, sig(raw), parent])
            continue
        m = RUST_TYPE.match(line)
        if m:
            out.append([m.group(2), "type", no, sig(raw), None])
            continue
        m = re.match(r"\s*macro_rules!\s*([A-Za-z_]\w*)", line)
        if m:
            out.append([m.group(1), "macro", no, sig(raw), None])
            continue
        m = RUST_CONST.match(line)
        if m and not parent:
            out.append([m.group(1), "const", no, sig(raw), None])
    return out


def ruby_defs(text, rel=""):
    out, nest = [], []
    routes = rel.endswith("routes.rb")
    for no, raw in enumerate(text.split("\n"), 1):
        if raw.lstrip().startswith("#"):
            continue
        indent = len(raw) - len(raw.lstrip())
        m = re.match(r"\s*(class|module)\s+([A-Z]\w*(?:::[A-Z]\w*)*)", raw)
        if m:
            nest = [c for c in nest if c[0] < indent] + [(indent, m.group(2).split("::")[-1])]
            out.append([nest[-1][1], "class" if m.group(1) == "class" else "type", no, sig(raw), None])
            continue
        m = re.match(r"\s*def\s+(?:self\.)?([A-Za-z_]\w*[?!=]?)", raw)
        if m:
            nest = [c for c in nest if c[0] < indent]
            parent = nest[-1][1] if nest else None
            out.append([m.group(1), "method" if parent else "function", no, sig(raw), parent])
            continue
        m = re.match(r"\s*([A-Z][A-Z0-9_]{2,})\s*=[^=]", raw)
        if m:
            out.append([m.group(1), "const", no, sig(raw), None])
            continue
        if routes:
            m = re.match(r"\s*(get|post|put|patch|delete|resources|resource|root)\s+['\":]([\w/:.#-]+)", raw)
            if m:
                out.append([f"{m.group(1).upper()} {m.group(2)}", "route", no, sig(raw), None])
    return out


JAVA_MODS = r"(?:(?:public|protected|private|abstract|final|static|sealed|non-sealed|strictfp|synchronized|native|default)\s+)*"
JAVA_ANN = r"(?:@\w+(?:\([^)]*\))?\s+)*"
JAVA_TYPE = re.compile(r"^\s*" + JAVA_ANN + JAVA_MODS + r"(class|interface|enum|record|@interface)\s+([A-Za-z_]\w*)")
JAVA_METHOD = re.compile(r"^\s*" + JAVA_ANN + JAVA_MODS + r"(?:<[^>]+>\s+)?([\w.$]+(?:<[^()]*>)?(?:\[\])*\s+)?([A-Za-z_]\w*)\s*\([^)]*\)?\s*"
                         r"(?:throws\s+[\w.,\s]+?)?\s*[{;]?\s*$")
JAVA_ROUTE = re.compile(r"@(Get|Post|Put|Delete|Patch|Request)Mapping\(\s*(?:(?:value|path)\s*=\s*)?\"([^\"]*)\"")
JAVA_NOT_NAMES = {"if", "for", "while", "switch", "catch", "synchronized", "return", "new", "throw", "else", "try", "super", "this", "do"}


def java_opener(line):
    m = JAVA_TYPE.match(line)
    return m.group(2) if m else None


def java_defs(text):
    out = []
    for no, raw, line, at_decl, parent, depth in scan(text, java_opener, strings=STRINGS_C):
        m = JAVA_ROUTE.search(raw)
        if m:
            out.append([f"{'ANY' if m.group(1) == 'Request' else m.group(1).upper()} {m.group(2)}", "route", no, sig(raw), parent])
            continue
        if not at_decl:
            continue
        m = JAVA_TYPE.match(line)
        if m:
            out.append([m.group(2), "class" if m.group(1) in ("class", "record") else "type", no, sig(raw), None])
            continue
        m = JAVA_METHOD.match(line) if parent and "=" not in line.split("(")[0] else None
        if m and m.group(2) not in JAVA_NOT_NAMES and (m.group(1) or m.group(2) == parent) and (m.group(1) or "").strip() not in JAVA_NOT_NAMES:
            out.append([m.group(2), "method", no, sig(raw), parent])
    return out


KT_MODS = (r"(?:(?:public|private|internal|protected|data|sealed|enum|abstract|open|inner|annotation|value|final|companion|expect|actual|override"
           r"|suspend|inline|infix|operator|tailrec|external)\s+)*")
KT_TYPE = re.compile(r"^\s*" + KT_MODS + r"(?:fun\s+)?(class|interface|object)\b\s*([A-Za-z_]\w*)?")
KT_FUN = re.compile(r"^\s*" + KT_MODS + r"fun\s+(?:<[^>]+>\s+)?(?:[\w<>?,.\s]+\.)?([A-Za-z_]\w*)\s*\(")


def kotlin_opener(line):
    m = KT_TYPE.match(line)
    return (m.group(2) or "") if m else None


def kotlin_defs(text):
    out = []
    for no, raw, line, at_decl, parent, depth in scan(text, kotlin_opener, strings=STRINGS_C):
        if not at_decl:
            continue
        m = KT_TYPE.match(line)
        if m and m.group(2):
            out.append([m.group(2), "class" if m.group(1) != "interface" else "type", no, sig(raw), None])
            continue
        m = KT_FUN.match(line)
        if m:
            out.append([m.group(1), "method" if parent else "function", no, sig(raw), parent])
            continue
        m = re.match(r"\s*(?:\w+\s+)*typealias\s+([A-Za-z_]\w*)", line)
        if m:
            out.append([m.group(1), "type", no, sig(raw), None])
            continue
        m = re.match(r"\s*(?:\w+\s+)*const\s+val\s+([A-Za-z_]\w*)", line)
        if m:
            out.append([m.group(1), "const", no, sig(raw), parent])
    return out


C_OPEN = re.compile(r"^\s*(?:template\s*<[^>]*>\s*)?(?:typedef\s+)?(class|struct|union|enum(?:\s+class)?|namespace)\b\s*([A-Za-z_]\w*)?\s*(?:(?:final\s*)?:[^;{()]*)?(\{.*)?$")
C_FUNC = re.compile(r"^\s*((?:[\w:<>,\[\]]+[\s*&]+)+)?((?:\w+::)*~?[A-Za-z_]\w*)\s*\(([^;{}]*?)\)?\s*(?:const\s*)?(?:noexcept\s*)?(?:override\s*)?(?:final\s*)?"
                    r"(?:=\s*(?:0|default|delete)\s*)?([{;]?)\s*\}?\s*$")
C_NOT_NAMES = {"if", "else", "for", "while", "switch", "return", "do", "typedef", "using", "case", "goto", "sizeof", "delete", "new", "throw",
               "defined", "catch", "static_assert", "alignas", "decltype"}


def c_opener(line):
    if re.match(r"\s*extern\s*\"\"\s*\{", line):
        return ""
    m = C_OPEN.match(line)
    if not m:
        return None
    return "" if m.group(1) == "namespace" else m.group(2) or ""  # a namespace holds declarations but isn't anyone's class


def c_defs(text, rel=""):
    out = []
    header = rel.endswith((".h", ".hpp", ".hh"))
    for no, raw, line, at_decl, parent, depth in scan(text, c_opener, strings=STRINGS_C):
        s = line.strip()
        if s.startswith("#"):
            m = re.match(r"#\s*define\s+([A-Za-z_]\w*)", s)
            if m and not re.search(r"_(?:H|HH|HPP|INCLUDED)_*$", m.group(1)):
                out.append([m.group(1), "macro", no, sig(raw), None])
            continue
        m = re.match(r"\}\s*([A-Za-z_]\w*)\s*;", s) if depth == 1 else None
        if m:  # typedef struct { ... } name;
            out.append([m.group(1), "type", no, sig(raw), None])
            continue
        if not at_decl or not s:
            continue
        m = C_OPEN.match(line)
        if m and (m.group(2) or "typedef" in line):
            if m.group(2) and m.group(1) != "namespace":
                out.append([m.group(2), "class" if m.group(1) == "class" else "type", no, sig(raw), None])
            continue
        if s.startswith("typedef"):
            m = re.search(r"\(\s*\*\s*([A-Za-z_]\w*)\s*\)", s) or re.search(r"([A-Za-z_]\w*)\s*(?:\[[^\]]*\])?\s*;$", s)
            if m:
                out.append([m.group(1), "type", no, sig(raw), None])
            continue
        m = re.match(r"using\s+([A-Za-z_]\w*)\s*=", s)
        if m:
            out.append([m.group(1), "type", no, sig(raw), None])
            continue
        if "(" not in s or "=" in s.split("(")[0] or s.split("(")[0].strip().split(" ")[0] in C_NOT_NAMES:
            continue
        m = C_FUNC.match(line)
        if not m:
            continue
        full = m.group(2)
        name, scope = full.split("::")[-1], "::".join(full.split("::")[:-1]) or parent
        if name in C_NOT_NAMES or not (m.group(1) or "::" in full or name.lstrip("~") == parent):
            continue
        if m.group(4) == ";" and not (header or parent):
            continue  # a prototype in a .c file says nothing new; in a header or a class it's the interface
        out.append([name, "method" if scope else "function", no, sig(raw.rstrip().rstrip(";")), scope])
    return out


def shell_defs(text):
    out = []
    for no, raw in enumerate(text.split("\n"), 1):
        m = (re.match(r"\s*(?:function\s+)?([A-Za-z_][\w:.-]*)\s*\(\s*\)\s*(?:\{.*)?$", raw)
             or re.match(r"\s*function\s+([A-Za-z_][\w:.-]*)\s*(?:\{.*)?$", raw))
        if m:
            out.append([m.group(1), "function", no, sig(raw.split("{")[0]), None])  # a one-line function's body isn't its signature
    return out


BUILTIN = {"js": lambda t, r: js_defs(t), "vue": vue_defs, "php": lambda t, r: php_defs(t), "go": lambda t, r: go_defs(t),
           "rust": lambda t, r: rust_defs(t), "ruby": ruby_defs, "java": lambda t, r: java_defs(t), "kotlin": lambda t, r: kotlin_defs(t),
           "c": c_defs, "shell": lambda t, r: shell_defs(t)}


def definitions(lang, text, rel=""):
    """([name, kind, line, signature, parent], which source read them). Never raises: a file it can't read defines nothing."""
    if lang == "python":
        try:
            return py_defs(text), "ast"
        except (SyntaxError, ValueError, RecursionError, MemoryError):
            return py_defs_loose(text), "patterns (it doesn't parse)"
    try:
        return BUILTIN[lang](text, rel), "patterns"
    except (KeyError, RecursionError, re.error):
        return [], "patterns"


def references(lang, text):
    """({identifier: how often it appears}, [dotted or hyphenated names]): what this file mentions. Deliberately loose:
    a name in a comment or a string still says the file is about it."""
    counts = collections.Counter(IDENT.findall(text))
    for k in [k for k in counts if k in KEYWORDS]:
        del counts[k]
    if lang == "vue":  # <invoice-table> in a template is InvoiceTable
        for tag in set(re.findall(r"<([a-z][a-z0-9]*(?:-[a-z0-9]+)+)", text)):
            counts["".join(p.capitalize() for p in tag.split("-"))] += 1
    refs = dict(counts.most_common(3000))
    return refs, sorted(set(DOTTED.findall(text)))[:600]


# ---- universal-ctags, when it happens to be installed ----------------------------------------------------------------------

# what ctags calls a definition worth a line. Its constants and variables are left out: in JavaScript every `const` is one.
CTAGS_KINDS = {"function": "function", "func": "function", "generator": "function", "method": "method", "getter": "method", "setter": "method",
               "singletonMethod": "method", "class": "class", "interface": "type", "struct": "type", "enum": "type", "trait": "type",
               "typedef": "type", "union": "type", "typealias": "type", "macro": "macro"}
CTAGS_LANGS = {"js", "php", "go", "rust", "ruby", "java", "kotlin", "c", "shell"}


def ctags_program():
    """(path, version line) of a universal-ctags that writes JSON, or (None, why not)."""
    for name in ("universal-ctags", "ctags"):
        path = shutil.which(name)
        if not path:
            continue
        try:
            version = subprocess.run([path, "--version"], capture_output=True, text=True, timeout=5).stdout.split("\n")[0]
            features = subprocess.run([path, "--list-features"], capture_output=True, text=True, timeout=5).stdout
        except (OSError, subprocess.SubprocessError):
            continue
        if "Universal Ctags" in version and re.search(r"^json\b", features, re.M):
            return path, version.split(",")[0]
        return None, f"{path} isn't universal-ctags with JSON output"
    return None, "not installed"


def ctags_defs(program, root, rels, texts):
    """{rel: defs} for the files ctags understood. The signature is the source line the tag is on."""
    try:
        r = subprocess.run([program, "--output-format=json", "--fields=+nK", "--extras=-F", "-f", "-", "-L", "-"], input="\n".join(rels),
                           cwd=root, capture_output=True, text=True, timeout=90)
    except (OSError, subprocess.SubprocessError):
        return {}
    out = {}
    for line in r.stdout.splitlines():
        try:
            t = json.loads(line)
        except ValueError:
            continue
        kind = CTAGS_KINDS.get(t.get("kind"))
        rel, no, name = t.get("path"), t.get("line"), t.get("name") or ""
        if t.get("_type") != "tag" or not kind or rel not in texts or not isinstance(no, int) or not IDENT_FULL.match(name.rstrip("?!=")):
            continue
        lines = texts[rel]
        if not 1 <= no <= len(lines) or name.startswith("__anon"):
            continue
        parent = (t.get("scope") or "").replace("\\", "::").replace(".", "::").split("::")[-1] or None
        if kind == "function" and parent and t.get("scopeKind") in ("class", "struct", "interface", "trait", "impl", "implementation"):
            kind = "method"
        out.setdefault(rel, []).append([name, kind, no, sig(lines[no - 1]), parent if kind in ("method", "const") else None])
    return out


def tree_sitter_note():
    try:
        import tree_sitter  # noqa: F401
    except ImportError:
        return "not installed, and not used: ast, the patterns and ctags cover the same definitions"
    return "installed, but not used yet: ast, the patterns and ctags cover the same definitions"


# ---- which files ------------------------------------------------------------------------------------------------------------

def git(root, *args, timeout=20):
    try:
        r = subprocess.run(["git", "-C", root, *args], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout if r.returncode == 0 else None


def toplevel(path):
    out = git(path, "rev-parse", "--show-toplevel", timeout=5)
    return out.strip() if out and out.strip() else None


def skipped(rel):
    parts = rel.split("/")
    return any(p in SKIP_DIRS for p in parts[:-1]) or bool(SKIP_FILE.search(parts[-1]))


def language(root, rel):
    base = os.path.basename(rel)
    ext = os.path.splitext(base)[1].lower()
    if ext in EXT:
        return EXT[ext]
    if "." in base:
        return None
    try:  # a script with no extension says what it is on its first line
        with open(os.path.join(root, rel), "rb") as f:
            first = f.read(80).split(b"\n")[0].decode("utf-8", "replace")
    except OSError:
        return None
    if first.startswith("#!"):
        for needle, lang in SHEBANGS:
            if needle in first:
                return lang
    return None


def list_files(root):
    """(source files as [(rel, lang)], whether git listed them). Tracked and untracked-but-not-ignored in a repo; a walk otherwise."""
    listed = git(root, "ls-files", "-z", "-co", "--exclude-standard")
    if listed is not None:
        rels = [r for r in listed.split("\0") if r]
    else:
        rels = []
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS and not d.startswith("."))
            rel = os.path.relpath(dirpath, root)
            rels += [n if rel == "." else f"{rel}/{n}" for n in sorted(filenames)]
            if len(rels) > 200000:
                break
    out = []
    for rel in sorted(set(rels)):
        if skipped(rel) or os.path.islink(os.path.join(root, rel)):
            continue
        lang = language(root, rel)
        if lang:
            out.append((rel, lang))
    return out, listed is not None


def changed_files(root):
    """Files that differ from HEAD or aren't tracked yet: what's being worked on."""
    out = set()
    for args in (("diff", "--name-only", "--relative", "HEAD"), ("ls-files", "-o", "--exclude-standard")):
        listed = git(root, *args, timeout=10)
        out.update(l for l in (listed or "").splitlines() if l)
    return out


# ---- reading, with the cache ------------------------------------------------------------------------------------------------

def cache_path(root):
    return os.path.join(CACHE, hashlib.sha1(os.path.realpath(root).encode()).hexdigest()[:20] + ".json")


def load_cache(root, mode):
    try:
        with open(cache_path(root), encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict) or data.get("v") != CACHE_VERSION or data.get("mode") != mode or data.get("root") != os.path.realpath(root):
        return {}
    return data.get("files") or {}


def save_cache(root, mode, entries):
    try:
        os.makedirs(CACHE, mode=0o700, exist_ok=True)
        tmp = cache_path(root) + f".{os.getpid()}.tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"v": CACHE_VERSION, "mode": mode, "root": os.path.realpath(root), "files": entries}, f, separators=(",", ":"))
        os.replace(tmp, cache_path(root))
    except OSError:
        pass  # a cache that can't be written costs time, nothing else


def read_text(path):
    """The file's text, or None when it's binary, minified or generated."""
    try:
        with open(path, "rb") as f:
            raw = f.read(MAX_BYTES + 1)
    except OSError:
        return None
    if len(raw) > MAX_BYTES or b"\0" in raw[:4096]:
        return None
    text = raw.decode("utf-8", "replace")
    head = text[:600]
    if GENERATED.search(head) or (len(text) > 3000 and text.count("\n") < len(text) / 400):
        return None
    return text


def read_files(root, files, use_ctags=None, deadline=None, max_files=None):
    """{rel: {lang, defs, refs, names, source}} for every file read, and what happened: cache hits, misses, files left out."""
    program = use_ctags
    mode = "ctags" if program else "builtin"
    cached = load_cache(root, mode)
    max_files = max_files or int(os.environ.get("SAKURA_MAP_MAX_FILES") or 6000)
    left = 0
    if len(files) > max_files:  # a giant repo: the shallowest files say most about its shape
        files = sorted(files, key=lambda f: (f[0].count("/"), f[0]))
        left, files = len(files) - max_files, sorted(files[:max_files])
    entries, out, texts, batch, hits = {}, {}, {}, [], 0
    for rel, lang in files:
        path = os.path.join(root, rel)
        try:
            st = os.stat(path)
        except OSError:
            continue
        if st.st_size > MAX_BYTES:
            continue
        stamp = [st.st_mtime_ns, st.st_size]
        old = cached.get(rel)
        if old and old[0] == stamp and old[1].get("lang") == lang:
            entries[rel] = old
            hits += 1
            continue
        if deadline and time.monotonic() > deadline:
            left += 1
            continue
        text = read_text(path)
        if text is None:
            entries[rel] = [stamp, {"lang": lang, "skip": True}]
            continue
        defs, source = definitions(lang, text, rel)
        refs, names = references(lang, text)
        if not defs and not refs:  # an empty __init__.py: nothing to say, nothing to rank
            entries[rel] = [stamp, {"lang": lang, "skip": True}]
            continue
        entries[rel] = [stamp, {"lang": lang, "defs": defs, "refs": refs, "names": names, "source": source}]
        if program and lang in CTAGS_LANGS:
            batch.append(rel)
            texts[rel] = text.split("\n")
    if batch:
        tagged = ctags_defs(program, root, batch, texts)
        for rel in batch:
            if tagged.get(rel):
                e = entries[rel][1]
                ours = {d[2] for d in e["defs"]}
                # the patterns know this user's languages line by line; ctags adds what they missed (a signature split
                # over lines, a construct they don't know), never a second name for a line they already read
                e["defs"] = sorted(e["defs"] + [d for d in tagged[rel] if d[2] not in ours], key=lambda d: d[2])
                e["source"] = "patterns + ctags"
    misses = len(entries) - hits
    if misses or len(entries) != len(cached):
        save_cache(root, mode, entries)
    for rel, (_, e) in entries.items():
        if not e.get("skip"):
            out[rel] = e
    return out, {"hits": hits, "misses": misses, "left_out": left}


# ---- the graph and the ranking ----------------------------------------------------------------------------------------------

def subwords(name):
    return [w.lower() for w in re.findall(r"[A-Z]+(?![a-z])|[A-Z]?[a-z]+|\d+", name)]


def norm(word):
    return word[:-1] if len(word) > 3 and word.endswith("s") and not word.endswith("ss") else word


def terms_of(text):
    """The words of a task that could name a file or a symbol."""
    out = []
    for token in re.findall(r"[A-Za-z_][\w]*", text or ""):
        for w in [token.lower()] + subwords(token):
            w = norm(w)
            if len(w) >= 3 and w not in STOP and w not in out:
                out.append(w)
    return out[:40]


def name_terms(name):
    return {norm(w) for w in subwords(name)} | {norm(name.lower())}


def named_paths(text, files, root=None):
    """Files a task names outright: a path, or a file name that exists in the map."""
    by_base = collections.defaultdict(list)
    for rel in files:
        by_base[os.path.basename(rel)].append(rel)
    out = []
    for token in re.findall(r"[\w./@+-]*[\w]", text or ""):
        token = token.lstrip("./")
        if token in files:
            out.append(token)
        elif ("." in token or "-" in token or "/" in token) and len(by_base.get(os.path.basename(token), [])) == 1 and "/" not in token:
            out.append(by_base[token][0])
        elif "/" in token:
            out += [rel for rel in files if rel.endswith("/" + token)][:3]
    return list(dict.fromkeys(out))


def match_scores(files, terms):
    """{rel: how strongly the task's words point at it}: its name most, its directory and what it defines less."""
    if not terms:
        return {}
    want, out = set(terms), {}
    for rel, f in files.items():
        stem = os.path.basename(rel).split(".")[0]
        score = 0
        stem_terms = name_terms(stem)
        for t in want:
            if norm(stem.lower()) == t:
                score += 5
            elif t in stem_terms:
                score += 3
        dir_terms = set()
        for part in rel.split("/")[:-1]:
            dir_terms |= name_terms(part)
        score += len(want & dir_terms)
        defined = set()
        for d in f["defs"]:
            defined |= name_terms(d[0]) if d[1] != "route" else {norm(w) for w in re.findall(r"[a-z]{3,}", d[0].lower())}
        score += len(want & defined)
        score += 3 * len({KIND_WORDS[t] for t in want if t in KIND_WORDS} & {d[1] for d in f["defs"]})  # "the routes" means files that have some
        if score:
            out[rel] = score
    return out


def links(files, mentioned):
    """Every (file that mentions, file that defines, name, weight). A mention of a rare, specific name is strong evidence
    the first file depends on the second; `get` or a name ten files define is nearly none."""
    definers = collections.defaultdict(dict)
    stems, bases = collections.defaultdict(list), collections.defaultdict(list)
    for rel, f in files.items():
        for d in f["defs"]:
            name = d[0].rstrip("?!=")
            if d[1] != "route" and IDENT_FULL.match(name) and len(name) >= 3:
                definers[name][rel] = max(definers[name].get(rel, 0), KIND_WEIGHT.get(d[1], 0.5) if d[1] != "method" else 0.5)
        base = os.path.basename(rel)
        bases[base].append(rel)
        stem = base.split(".")[0]
        if len(stem) >= 4 and stem.lower() not in COMMON and stem not in ("__init__", "index", "main", "mod"):
            stems[stem].append(rel)
    mentions = collections.Counter()  # how many files say each defined name: one most files say is a word, not a pointer
    for f in files.values():
        mentions.update(n for n in f["refs"] if n in definers)
    crowd = max(5.0, len(files) / 4)
    weight = {}
    for name, where in definers.items():
        w = 1.0
        if mentions[name] > crowd:
            w *= (crowd / mentions[name]) ** 2
        if mentioned and name_terms(name) & mentioned:
            w *= 10
        if len(name) >= 8 and ("_" in name.strip("_") or (name != name.lower() and name != name.upper())):
            w *= 3
        if name.startswith("_"):
            w *= 0.1
        if name.lower() in COMMON or len(name) < 4:
            w *= 0.1
        elif name.islower() and "_" not in name:
            w *= 0.3  # one plain word (`render`, `notes`): prose says it too
        w /= len(where)
        if len(where) > 5:
            w *= 0.1
        weight[name] = w
    out = []
    for src, f in files.items():
        for name, count in f["refs"].items():
            where = definers.get(name)
            if where and len(where) <= 20:  # a name twenty files define points nowhere, and a million faint edges cost seconds
                w = weight[name] * count ** 0.5
                for dst, kind_w in where.items():
                    if dst != src:
                        out.append((src, dst, name, w * kind_w))
                    elif count > 1:  # used in its own file: no edge, but it says which of the file's definitions matter
                        out.append((src, src, name, weight[name] * kind_w * (count - 1) ** 0.5))
            where = stems.get(name)
            if where and len(where) <= 3:  # `import price`, `require('./price')`: the file itself is meant
                for dst in where:
                    if dst != src:
                        out.append((src, dst, None, 0.5 / len(where)))
        for name in f.get("names") or ():
            for dst in bases.get(name, ()) if len(bases.get(name, ())) <= 3 else ():
                if dst != src:
                    out.append((src, dst, None, 1.0))
    return out


def pagerank(nodes, edges, personal, damping=0.85, rounds=40, tolerance=1e-6):
    """Rank by where a reader following mentions ends up, restarting at `personal`. edges: {src: {dst: weight}}."""
    total = sum(personal.values()) or 1.0
    personal = {n: personal.get(n, 0.0) / total for n in nodes}
    out_sum = {s: sum(t.values()) for s, t in edges.items()}
    rank = dict(personal)
    for _ in range(rounds):
        new = {n: (1 - damping) * personal[n] for n in nodes}
        dangling = sum(rank[n] for n in nodes if not out_sum.get(n))
        for s, targets in edges.items():
            share = damping * rank[s] / out_sum[s]
            for t, w in targets.items():
                new[t] += share * w
        if dangling:
            for n in nodes:
                new[n] += damping * dangling * personal[n]
        moved = sum(abs(new[n] - rank[n]) for n in nodes)
        rank = new
        if moved < tolerance:
            break
    return rank


def rank_files(files, for_text="", focus=(), changed=()):
    """The ranked map: [{path, lang, rank, named, symbols: [{name, kind, line, signature, parent, rank}]}], best first."""
    nodes = sorted(files)
    if not nodes:
        return []
    terms = terms_of(for_text)
    mentioned = set(terms)
    explicit = set(named_paths(for_text, files)) | {f for f in focus if f in files}
    scores = match_scores(files, terms)
    changed = {c for c in changed if c in files}
    if len(changed) > 30 or (len(nodes) >= 4 and len(changed) * 2 > len(nodes)):
        changed = set()  # a fresh checkout or a mass edit: everything is "changed", so nothing is
    pull = {n: 8.0 * (n in explicit) + scores.get(n, 0) + 1.0 * (n in changed) for n in nodes}
    pulled = sum(pull.values())
    aimed = 0.8 if explicit or scores else 0.3  # a task's words aim hard; a dirty working tree only leans
    personal = {n: ((1 - aimed) / len(nodes) + aimed * pull[n] / pulled) if pulled else 1.0 for n in nodes}
    all_links = links(files, mentioned)
    edges = collections.defaultdict(lambda: collections.defaultdict(float))
    out_sum, own = collections.defaultdict(float), collections.defaultdict(float)
    for src, dst, _, w in all_links:
        if src != dst:
            out_sum[src] += w
            edges[src][dst] += w
        else:
            own[src] += w
    rank = pagerank(nodes, edges, personal)
    flow = collections.defaultdict(float)  # (file, name) -> the rank that arrives through mentions of that name
    for src, dst, name, w in all_links:
        if name and src != dst:
            flow[(dst, name)] += rank[src] * w / out_sum[src]
        elif name:  # its own file using it counts like one average file would, so it orders what nobody else mentions
            flow[(dst, name)] += 0.25 / len(nodes) * w / (own[src] + out_sum[src])
    # the files the task names come first; a word that matches dozens of files names none of them
    strong = sorted((n for n in nodes if scores.get(n, 0) >= 3), key=lambda n: (-scores[n], -rank[n], n))[:12]
    tier = {n: 2 if n in explicit else 1 if n in strong else 0 for n in nodes}
    order = sorted(nodes, key=lambda n: (-tier[n], -(scores.get(n, 0) if tier[n] == 1 else 0), -rank[n], n))
    top = max(rank.values())
    out = []
    for pos, rel in enumerate(order):
        f = files[rel]
        best = max((flow.get((rel, d[0].rstrip("?!=")), 0.0) for d in f["defs"]), default=0.0)
        about = name_terms(os.path.basename(rel).split(".")[0])
        symbols = []
        for d in f["defs"]:
            got = flow.get((rel, d[0].rstrip("?!=")), 0.0)
            share = 0.05 + 0.95 * (got / best if best else 0.0)
            words = name_terms(d[0]) if d[1] != "route" else {norm(w) for w in re.findall(r"[a-z]{3,}", d[0].lower())}
            # the word that picked the file doesn't pick within it: in invoice.py, "total" says more than "invoice"
            hit = sum(0.25 if t in about else 1.0 for t in mentioned & words)
            if hit:
                share = 2.0 + 4 * hit + share
            symbols.append({"name": d[0], "kind": d[1], "line": d[2], "signature": d[3], "parent": d[4],
                            "rank": share * KIND_WEIGHT.get(d[1], 0.5)})
        symbols.sort(key=lambda s: (-s["rank"], s["line"]))
        out.append({"path": rel, "lang": f["lang"], "rank": rank[rel], "score": rank[rel] + top * tier[rel] * 2, "named": tier[rel] > 0, "explicit": tier[rel] == 2,
                    "changed": rel in changed, "source": f.get("source", ""), "symbols": symbols})
    return out


# ---- the text --------------------------------------------------------------------------------------------------------------

def symbol_line(s):
    text = f"  {s['line']}: {s['signature']}"
    if s["parent"] and s["kind"] in ("method", "const") and s["parent"] not in s["signature"]:
        text += f"  ({s['parent']})"
    return text


def render(ranked, budget, title=""):
    """The map as text, never longer than `budget` characters: the best definitions that fit, grouped under their files
    in rank order. Which definitions make it is decided across the whole repo, so a top file shows many and a minor one
    its single most-used."""
    tags = []
    for pos, f in enumerate(ranked):
        for s in f["symbols"]:
            tags.append((f["score"] * s["rank"], pos, s["line"], s))
    tags.sort(key=lambda t: (-t[0], t[1], t[2]))
    with_defs = sum(1 for f in ranked if f["symbols"])

    def build(n):
        chosen = collections.defaultdict(list)
        for _, pos, _, s in tags[:n]:
            chosen[pos].append(s)
        lines = []
        for pos in sorted(chosen):
            lines.append(ranked[pos]["path"])
            lines += [symbol_line(s) for s in chosen[pos]]
        if n < len(tags):
            lines.append(f"(+{len(tags) - n} more definitions in {with_defs} files: a bigger --budget shows more, --for \"words\" aims it)")
        head = f"# {title}: {len(chosen)} of {len(ranked)} files, most referenced first; `line: signature`\n" if title else ""
        return head + "\n".join(lines) + "\n"

    if len(build(len(tags))) <= budget:  # everything fits, and without the "more" line it's shorter than nearly everything
        return build(len(tags)) if tags else ""
    lo, hi = 0, max(len(tags) - 1, 0)
    while lo < hi:  # the most definitions that fit
        mid = (lo + hi + 1) // 2
        if len(build(mid)) <= budget:
            lo = mid
        else:
            hi = mid - 1
    text = build(lo)
    while lo > 0 and len(text) > budget:  # the header's digits can move the length by a character
        lo -= 1
        text = build(lo)
    return text if lo > 0 else ""


def make(path=None, for_text="", focus=(), budget=BUDGET, source="auto", deadline=None, title=True):
    """Everything about one run: {root, ranked, text, stats, source}. `path` None means the repository you're in."""
    start = os.path.realpath(os.path.expanduser(path or os.getcwd()))
    root = start if path else (toplevel(start) or start)
    files, in_git = list_files(root)
    program, why = (None, "turned off") if source == "builtin" or os.environ.get("SAKURA_MAP_SOURCE") == "builtin" else ctags_program()
    read, stats = read_files(root, files, use_ctags=program, deadline=deadline)
    rel_focus = []
    for f in focus:
        full = os.path.realpath(os.path.join(os.getcwd(), os.path.expanduser(f)))
        rel_focus.append(os.path.relpath(full, root) if full.startswith(root + os.sep) else f)
    ranked = rank_files(read, for_text, rel_focus, changed_files(root) if in_git else ())
    name = os.path.basename(root) or root
    text = render(ranked, budget, f"map of {name}" if title else "")
    stats.update({"files": len(ranked), "definitions": sum(len(f["symbols"]) for f in ranked), "git": in_git})
    return {"root": root, "ranked": ranked, "text": text, "stats": stats,
            "source": {"python": "ast", "others": f"{why} + patterns" if program else "patterns", "ctags": why if program else f"not used ({why})",
                       "tree_sitter": tree_sitter_note()}}


# ---- the switch ------------------------------------------------------------------------------------------------------------

def is_on():
    return os.path.exists(FLAG)


def standing_budget():
    try:
        with open(FLAG, encoding="utf-8") as f:
            return max(400, min(int(f.read().strip() or BUDGET), 20000))
    except (OSError, ValueError):
        return BUDGET


def wired():
    try:
        with open(os.path.join(ROOT, "hooks.json"), encoding="utf-8") as f:
            return "repo_map.py" in f.read()
    except OSError:
        return False


def switch(word, budget):
    if word == "on":
        os.makedirs(HOME, exist_ok=True)
        with open(FLAG, "w", encoding="utf-8") as f:
            f.write(str(budget) + "\n")
        print(f"sakura-map is on: a code task in a git repo gets the map beside it, up to {budget} characters, once a session unless the focus moves.")
        if not wired():
            print("The hook isn't in hooks.json yet, so nothing will arrive: add hooks/repo_map.py under UserPromptSubmit and run ./install.sh.")
    elif word == "off":
        if os.path.exists(FLAG):
            os.remove(FLAG)
        print("sakura-map is off: nothing is added to a session. `sakura-map` still prints the map when you ask.")
    else:
        print(f"sakura-map is {'on' if is_on() else 'off'}" + (f", up to {standing_budget()} characters" if is_on() else ": `sakura-map on` makes the map standing context"))
        if is_on() and not wired():
            print("The hook isn't in hooks.json yet, so nothing arrives: add hooks/repo_map.py under UserPromptSubmit and run ./install.sh.")
    return 0


def tools():
    program, why = ctags_program()
    print("python            ast (the standard library; exact)")
    print("everything else   patterns built in: JavaScript/TypeScript, Vue and Svelte <script>, PHP and Laravel routes, Go, Rust, Ruby, Java, Kotlin, C/C++, shell")
    print(f"universal-ctags   {'used with the patterns: ' + why + ' (' + program + ')' if program else 'not used: ' + why + ' (sudo -A apt-get install -y universal-ctags)'}")
    print(f"tree-sitter       {tree_sitter_note()}")
    print(f"cache             {CACHE}")
    return 0


def main(argv):
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__.strip())
        return 0
    opts = {"budget": None, "for": [], "focus": [], "source": "auto"}
    flags, words, i = set(), [], 0
    while i < len(argv):
        a = argv[i]
        key = a.split("=", 1)[0]
        if key in ("--budget", "--for", "--focus", "--source"):
            if "=" in a:
                value = a.split("=", 1)[1]
            elif i + 1 < len(argv):
                i += 1
                value = argv[i]
            else:
                print(f"sakura-map: {key} needs a value", file=sys.stderr)
                return 2
            if key == "--budget":
                if not value.isdigit() or int(value) < 1:
                    print("sakura-map: --budget takes a number of characters, e.g. --budget 4000", file=sys.stderr)
                    return 2
                opts["budget"] = int(value)
            elif key == "--source":
                if value not in ("auto", "builtin"):
                    print("sakura-map: --source is auto or builtin", file=sys.stderr)
                    return 2
                opts["source"] = value
            else:
                opts[key[2:]].append(value)
        elif a in ("--json", "--files", "--tools"):
            flags.add(a)
        elif a.startswith("--"):
            print(f"sakura-map: I don't know {a}. sakura-map --help lists what it takes.", file=sys.stderr)
            return 2
        else:
            words.append(a)
        i += 1
    if "--tools" in flags:
        return tools()
    if words and words[0] in ("on", "off", "status") and not os.path.isdir(words[0]):
        return switch(words[0], opts["budget"] or BUDGET)
    if len(words) > 1:
        print("sakura-map: one PATH at a time. For a task's words use --for \"...\".", file=sys.stderr)
        return 2
    path = words[0] if words else None
    if path and not os.path.isdir(os.path.expanduser(path)):
        if os.path.isfile(os.path.expanduser(path)):  # a file means "the repo around it, aimed at it"
            opts["focus"].append(path)
            path = None
        else:
            print(f"sakura-map: {path} isn't a directory here.", file=sys.stderr)
            return 2
    budget = opts["budget"] or BUDGET
    m = make(path, " ".join(opts["for"]), opts["focus"], budget, opts["source"])
    if "--json" in flags:
        print(json.dumps({"root": m["root"], "source": m["source"], "stats": m["stats"], "budget": budget, "text": m["text"],
                          "files": [{k: v for k, v in f.items() if k != "score"} for f in m["ranked"]]}, indent=1))
        return 0
    if not m["ranked"]:
        print(f"sakura-map: no source files I can read under {m['root']}.", file=sys.stderr)
        return 1
    if "--files" in flags:
        for f in m["ranked"]:
            print(f"{f['rank']:.4f}  {f['path']}" + ("  (named)" if f["named"] else "") + ("  (changed)" if f["changed"] else ""))
    else:
        sys.stdout.write(m["text"])
        if not m["text"]:
            print(f"sakura-map: nothing fits in {budget} characters; try --budget {max(400, budget * 4)}.", file=sys.stderr)
            return 1
    if m["stats"]["left_out"]:
        print(f"sakura-map: {m['stats']['left_out']} more source files weren't read (the limit is SAKURA_MAP_MAX_FILES); run it on a subdirectory for those.", file=sys.stderr)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:  # `sakura-map | head`
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
