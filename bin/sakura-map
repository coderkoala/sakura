FLAG = os.path.join(HOME, "map")
CACHE = os.path.expanduser(os.environ.get("SAKURA_MAP_CACHE") or os.path.join(os.environ.get("XDG_CACHE_HOME") or "~/.cache", "sakura", "map"))
CACHE_VERSION = 1
BUDGET = 4000
MAX_BYTES = 300_000
SIG_WIDTH = 110

EXT = {".py": "python", ".pyi": "python", ".js": "js", ".mjs": "js", ".cjs": "js", ".jsx": "js", ".ts": "js", ".tsx": "js", ".mts": "js",
       ".cts": "js", ".vue": "vue", ".svelte": "vue", ".php": "php", ".go": "go", ".rs": "rust", ".rb": "ruby", ".rake": "ruby",
       ".java": "java", ".kt": "kotlin", ".kts": "kotlin", ".c": "c", ".h": "c", ".cc": "c", ".cpp": "c", ".cxx": "c", ".hpp": "c",
       ".hh": "c", ".sh": "shell", ".bash": "shell", ".zsh": "shell"}
SHEBANGS = (("python", "python"), ("bash", "shell"), ("zsh", "shell"), ("/sh", "shell"), ("env sh", "shell"), ("node", "js"), ("php", "php"), ("ruby", "ruby"))
SKIP_DIRS = {".git", "node_modules", "vendor", "third_party", "bower_components", "dist", "build", "target", "out", ".venv", "venv",
             "__pycache__", ".next", ".nuxt", ".cache", ".idea", ".tox", "coverage", "storage", "site-packages", ".gradle", "Pods"}
SKIP_FILE = re.compile(r"(?:\.min\.\w+|\.bundle\.js|[-.]lock(?:\.\w+)?|_pb2(?:_grpc)?\.py|\.pb\.go|\.generated\.\w+|\.g\.dart|_generated\.\w+|\.map)$", re.I)
GENERATED = re.compile(r"@generated|DO NOT EDIT|auto-?generated|generated by", re.I)
# names so common that a mention says nothing about which file is meant
COMMON = set("""get set run main init new test tests name names value values data key keys item items list add remove update delete create index
handle handler render show store save load open close read write start stop find make build setup call apply process parse format print log error
errors result results args kwargs self this cls true false null none string number int bool type types util utils helper helpers config app user
