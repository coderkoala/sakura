#!/usr/bin/env python3
"""sakura-fix [hint...] — fix the command that just failed. This is what the `?fix` key runs.

The shell (shell/sakura.bash) remembers the last failed command, its directory and exit status, and inside tmux what the
screen showed. This turns that into a brief and opens Sakura where the command ran, so there's nothing to copy or explain.
  --shell PID    whose failure to fix (the key passes the shell's own PID)
  --record FILE  read the failure from FILE instead (evals)
  --exec         one-shot, no TUI; prints the answer (evals, scripts)
  --json         with --exec, print the run as JSON events
  --print        print the brief and stop
"""
import json
import os
import re
import shlex
import sys
import time

USAGE = "usage: sakura-fix [--shell PID | --record FILE] [--exec | --print] [hint...]"


def record_dir():
    return os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", f"sakura-fix-{os.getuid()}")


def read_record(path):
    """(status, when, cwd, command, screen) or None. The command is everything after the third line."""
    try:
        with open(path, errors="replace") as f:
            lines = f.read().split("\n")
    except OSError:
        return None
    if len(lines) < 4 or not lines[0].strip().isdigit():
        return None
    command = "\n".join(lines[3:]).rstrip("\n")
    if not command.strip():
        return None
    try:
        when = int(lines[1])
    except ValueError:
        when = 0
    screen = ""
    try:
        with open(path + ".screen", errors="replace") as f:
            screen = f.read()
    except OSError:
        pass
    return int(lines[0]), when, lines[2], command, screen


def ago(when):
    if not when:
        return ""
    s = max(0, int(time.time()) - when)
    if s < 90:
        return "just now"
    if s < 5400:
        return f"{s // 60} minutes ago"
    if s < 172800:
        return f"{s // 3600} hours ago"
    return f"{s // 86400} days ago"


def trim_screen(screen, limit=6000):
    """The last lines of the screen, without the trailing blank ones or the prompt that came back."""
    lines = screen.rstrip().split("\n")
    text = "\n".join(lines[-80:])
    return text[-limit:]


# What makes a command unsafe to run twice: it changes something somewhere else, or can't be taken back. Checked in the
# command and in the scripts it runs. Wrongly flagging a command costs one rerun by hand; missing one can deploy twice.
UNREPEATABLE = re.compile(
    r"\bdeploy\b|\bpublish\b|\brelease\s+create\b|\bgit\s+push\b|\bdocker\s+push\b|\btwine\s+upload\b"
    r"|\bgh\s+(?:release|pr)\s+create\b|\brsync\b|\bscp\b|\bsftp\b|\bupload\b"
    r"|\bkubectl\s+(?:apply|delete|rollout|scale|patch|create)\b|\bhelm\s+(?:install|upgrade|uninstall)\b"
    r"|\bterraform\s+(?:apply|destroy)\b|\bansible-playbook\b"
    r"|\bcurl\b[^\n]*?(?:-X\s*(?:POST|PUT|PATCH|DELETE)\b|--data|--form|\s-[dFT]\s|--upload-file)|\bwget\b[^\n]*--post"
    r"|\brequests\.(?:post|put|patch|delete)\(|\burlopen\([^)\n]*data=|\bsmtplib\b|\bsendmail\b|\bhimalaya\b[^\n]*\bsend\b"
    r"|\bmail\s+-s\b|\b(?:drop\s+(?:table|database)|delete\s+from|truncate\s+table)\b|\bmigrate\b",
    re.I)


def scripts_in(command, cwd):
    """Files the command runs that we can read: words of it that are files in its directory or on a path."""
    try:
        words = shlex.split(command, comments=True)
    except ValueError:
        words = command.split()
    found = []
    for w in words:
        if w.startswith("-") or "=" in w.split("/")[0]:
            continue
        path = w if os.path.isabs(w) else os.path.join(cwd, w)
        if os.path.isfile(path) and os.path.getsize(path) < 262144 and path not in found:
            found.append(path)
    return found


def unrepeatable(command, cwd):
    """(why, scripts) when running the command again could do something twice, else (None, scripts)."""
    scripts = scripts_in(command, cwd)
    m = UNREPEATABLE.search(command)
    if m:
        return f"runs `{m.group(0).strip()}`", scripts
    for path in scripts:
        try:
            text = open(path, errors="replace").read()
        except OSError:
            continue
        if "\0" in text[:4096]:
            continue
        m = UNREPEATABLE.search(text)
        if m:
            line = text[:m.start()].count("\n") + 1
            return f"runs `{m.group(0).strip()}` ({os.path.basename(path)} line {line})", scripts
    return None, scripts


def brief(status, when, cwd, command, screen, hint, why=None):
    parts = [
        "This command just failed in my shell. Fix what's wrong with it.",
        "",
        f"Command: {command}",
        f"Directory: {cwd}",
        f"Exit status: {status}" + (f" ({ago(when)})" if when else ""),
    ]
    if hint:
        parts.append(f"From me: {hint}")
    if screen.strip():
        parts += ["", "What the terminal showed (the command's output is near the end):", "```", trim_screen(screen), "```"]
    else:
        parts += ["", "Its output wasn't saved."]
    if why:
        parts += [
            "",
            f"1. Don't run it again: it {why}, so running it twice could do that twice. A guard refuses it, and anything "
            "else that runs the same script. Find the cause by reading the files it uses, and ask me for the output if "
            "that isn't enough.",
            "2. Fix the cause. Don't delete, skip or weaken the check that failed, and don't change something unrelated "
            "just to make it pass.",
            "3. Then tell me to run it myself, and what it should print. If you can't fix it, say what you found and "
            "what you need from me.",
        ]
    else:
        parts += [
            "",
            "1. Find out why it failed. If you need its output, run it again.",
            "2. Fix the cause. Don't delete, skip or weaken the check or test that failed, and don't change something "
            "unrelated just to make it pass.",
            "3. Prove it: run the same command again and show what it printed. If you can't fix it, say what you found "
            "and what you need from me.",
        ]
    return "\n".join(parts)


def main(argv):
    shell, record, mode, hint, json_out = None, None, "tui", [], False
    it = iter(argv)
    for a in it:
        if a == "--shell":
            shell = next(it, None)
        elif a == "--record":
            record = next(it, None)
        elif a == "--json":
            json_out = True
        elif a in ("--exec", "--print"):
            mode = a[2:]
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        else:
            hint.append(a)
    if record is None:
        if not shell:
            shell = str(os.getppid())
        record = os.path.join(record_dir(), shell)
    got = read_record(record)
    if got is None:
        print("sakura-fix: nothing has failed in this shell yet, so there's nothing to fix. "
              "Run the command again, then ?fix. (Is shell/sakura.bash sourced?)", file=sys.stderr)
        return 1
    status, when, cwd, command, screen = got
    why, scripts = unrepeatable(command, cwd)
    text = brief(status, when, cwd, command, screen, " ".join(hint).strip(), why)
    if why:
        # tool_guard refuses running these again for this session: the command itself, and the scripts it runs.
        os.environ["SAKURA_FIX_NO_RERUN"] = json.dumps({"command": command, "scripts": [os.path.basename(p) for p in scripts]})
    if mode == "print":
        print(text)
        return 0
    print(f"sakura: fixing `{command}` (exit {status}{', ' + ago(when) if when else ''}, in {cwd})", file=sys.stderr)
    if why:
        print(f"sakura: it won't run it again, because it {why}. You'll rerun it yourself.", file=sys.stderr)
    if os.path.isdir(cwd):
        os.chdir(cwd)
    else:
        print(f"sakura-fix: {cwd} is gone, so this runs in {os.getcwd()}", file=sys.stderr)
    launch = ["sakura-launch"]
    if mode == "exec":
        launch += ["--exec", "--skip-git-repo-check"] + (["--json"] if json_out else []) + [text]
    else:
        launch += [text]
    try:
        os.execvp(launch[0], launch)
    except OSError as e:
        print(f"sakura-fix: couldn't start sakura-launch: {e}", file=sys.stderr)
        return 127


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
