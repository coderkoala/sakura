#!/usr/bin/env bash
# sakura-mail-setup — get email working: the himalaya client, and accounts whose passwords stay in pass.
#   sakura-mail-setup install                                      himalaya into ~/.local/bin, and pass if apt can get it
#   sakura-mail-setup account NAME EMAIL IMAP_HOST SMTP_HOST [IMAP_PORT] [SMTP_PORT]
#   sakura-mail-setup check [NAME]                                 list the inbox, to prove the account works
# Passwords are never given to this command. It tells you what to run so that you type them into pass yourself.
set -eu
HIMALAYA_VERSION="${SAKURA_HIMALAYA_VERSION:-v2.2.1}"
BIN="$HOME/.local/bin"
CONF="${HIMALAYA_CONFIG:-$HOME/.config/himalaya/config.toml}"

install_himalaya() {
    mkdir -p "$BIN"
    if ! command -v himalaya >/dev/null; then
        tmp=$(mktemp -d)
        trap 'rm -rf "$tmp"' EXIT
        curl -fsSL --max-time 180 -o "$tmp/h.tgz" "https://github.com/pimalaya/himalaya/releases/download/$HIMALAYA_VERSION/himalaya.$(uname -m)-linux.tgz"
        tar -xzf "$tmp/h.tgz" -C "$tmp"
        install -m 755 "$(find "$tmp" -type f -name himalaya | head -1)" "$BIN/himalaya"
    fi
    echo "himalaya: $(command -v himalaya || echo "$BIN/himalaya")"
    if ! command -v pass >/dev/null; then
        if sudo -A apt-get install -y pass >/dev/null 2>&1; then echo "pass: installed"; else echo "pass: not installed. Install it with your package manager."; fi
    fi
    if command -v pass >/dev/null && [ ! -e "${PASSWORD_STORE_DIR:-$HOME/.password-store}/.gpg-id" ]; then
        echo "pass isn't set up yet. You need to run this yourself, with your own GPG key: pass init <gpg-id>"
    fi
}

add_account() {
    name=$1 email=$2 imap=$3 smtp=$4 imap_port=${5:-993} smtp_port=${6:-587}
    case "$name" in *[!a-zA-Z0-9_-]*) echo "account names are letters, digits, - and _" >&2; exit 1 ;; esac
    mkdir -p "$(dirname "$CONF")"
    if [ -f "$CONF" ] && grep -q "^\[accounts\.$name\]" "$CONF"; then
        echo "$name is already in $CONF"; exit 0
    fi
    default=false; [ -s "$CONF" ] || default=true
    (umask 077; cat >> "$CONF" <<EOF

[accounts.$name]
default = $default
email = "$email"
backend.type = "imap"
backend.host = "$imap"
backend.port = $imap_port
backend.login = "$email"
backend.passwd.cmd = "pass show email/$name"
message.send.backend.type = "smtp"
message.send.backend.host = "$smtp"
message.send.backend.port = $smtp_port
message.send.backend.login = "$email"
message.send.backend.passwd.cmd = "pass show email/$name"
EOF
    )
    echo "added $name to $CONF"
    echo "Now run this yourself and type the password or app password: pass insert email/$name"
    echo "Then prove it works: sakura-mail-setup check $name"
}

case "${1:-}" in
    install) install_himalaya ;;
    account) [ $# -ge 5 ] || { sed -n 2,6p "$0"; exit 1; }; shift; add_account "$@" ;;
    check) shift; himalaya envelope list ${1:+--account "$1"} ;;
    *) sed -n 2,6p "$0"; exit 1 ;;
esac
