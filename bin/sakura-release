#!/usr/bin/env bash
# sakura-release VERSION NOTES_FILE — the whole release, repeatably: scan, version, tag, push, publish, pin.
#
#   sakura-release 0.9.7 notes.md            everything below, stopping before anything irreversible to show what it will do
#   sakura-release 0.9.7 notes.md --go       actually do it
# Steps: 1 clean tree check · 2 staged-secrets scan · 3 VERSION + commit + tag v· · 4 push with tags ·
# 5 engine assets fetched from the last release that has them (sha256 verified; the binary is unchanged since v0.6.0) ·
# 6 gh release create (run as its own command, or the permission classifier balks) · 7 the dotfiles pin, autosync paused.
# Any step failing stops the rest. Nothing here talks to a model.
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
dot="$(dirname "$here")"
ver="${1:?usage: sakura-release VERSION NOTES_FILE [--go]}"
notes="${2:?usage: sakura-release VERSION NOTES_FILE [--go]}"
go=0; [ "${3:-}" = --go ] && go=1
[[ "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "release: '$ver' isn't X.Y.Z" >&2; exit 2; }
[ -r "$notes" ] || { echo "release: can't read $notes" >&2; exit 2; }
cd "$here"
say() { printf '%s\n' "$*"; }
run() { if [ $go = 1 ]; then "$@"; else say "  would: $*"; fi; }

say "== 1/7 tree"
dirty="$(git status --porcelain)"
[ -z "$dirty" ] || { echo "release: the tree isn't clean:"; echo "$dirty" | head; exit 1; }
git rev-parse -q --verify "refs/tags/v$ver" >/dev/null && { echo "release: v$ver already exists" >&2; exit 1; }

say "== 2/7 secrets scan (the repo is public)"
if git log -p "v$(cat VERSION)..HEAD" 2>/dev/null | grep -niE "BEGIN (RSA|OPENSSH|EC) PRIVATE|password\s*=\s*['\"][^'\"]{6,}|api[_-]?key\s*[:=]\s*['\"][A-Za-z0-9_-]{16,}|ghp_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}" | grep -v "SECRET_SHAPES\|secrets scan\|docs/"; then
    echo "release: the lines above look like secrets; clean them first" >&2; exit 1
fi
say "  clean"

say "== 3/7 version and tag"
run bash -c "echo $ver > VERSION && git add VERSION && git commit -qm 'release: $ver' && git tag v$ver"

say "== 4/7 push"
run git push -q origin main --tags

say "== 5/7 engine assets"
assets="${SAKURA_RELEASE_ASSETS:-$HOME/.cache/sakura/release-assets}"
mkdir -p "$assets"
if [ ! -s "$assets/sakura-linux-x86_64.tar.gz" ]; then
    last="$(gh release list --limit 15 --json tagName,assets -q '[.[] | select(.assets | length > 0)][0].tagName')"
    [ -n "$last" ] || { echo "release: no earlier release carries the engine assets" >&2; exit 1; }
    say "  fetching from $last"
    run gh release download "$last" -D "$assets" --clobber
fi
if [ $go = 1 ]; then (cd "$assets" && sha256sum -c sakura-linux-x86_64.tar.gz.sha256 >/dev/null) && say "  sha256 OK"; fi

say "== 6/7 publish"
say "  run this as its own command (a compound trips the permission classifier):"
say "  gh release create v$ver $assets/sakura-linux-x86_64.tar.gz $assets/sakura-linux-x86_64.tar.gz.sha256 --title \"Sakura $ver\" --notes-file $notes"
if [ $go = 1 ] && [ "${SAKURA_RELEASE_PUBLISH:-0}" = 1 ]; then
    gh release create "v$ver" "$assets/sakura-linux-x86_64.tar.gz" "$assets/sakura-linux-x86_64.tar.gz.sha256" --title "Sakura $ver" --notes-file "$notes"
fi

say "== 7/7 the dotfiles pin"
if [ -e "$dot/HANDOFF-sakura.md" ]; then
    run bash -c "systemctl --user stop dotfiles-autosync.timer 2>/dev/null; cd '$dot' && git add sakura && git commit -qm 'sakura: pin v$ver' && git push -q origin main; systemctl --user start dotfiles-autosync.timer 2>/dev/null"
else
    say "  (not inside the dotfiles layout; move the pin wherever this repo is embedded)"
fi
[ $go = 1 ] && say "released v$ver" || say "dry run done; add --go to do it"
