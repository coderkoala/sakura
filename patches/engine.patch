 /// Configuration updates require harness provenance; raw system messages are never retained.
+/// Tokens a text could come to on a local model: each digit is its own token, the rest about three characters.
+fn conservative_tokens(text: &str) -> i64 {
+    let (mut digits, mut others) = (0i64, 0i64);
+    for c in text.chars() {
+        if c.is_ascii_digit() {
+            digits += 1;
+        } else {
+            others += 1;
+        }
+    }
+    digits + others / 3
+}
+
+/// The start and end of a long output with a note in between, or None if it's already short.
+fn cut_to_ends(text: &str) -> Option<String> {
+    const HEAD: usize = 500;
+    const TAIL: usize = 300;
+    let chars = text.chars().count();
+    if chars <= (HEAD + TAIL) * 2 {
+        return None;
+    }
+    let head: String = text.chars().take(HEAD).collect();
+    let tail: String = text.chars().skip(chars - TAIL).collect();
+    Some(format!(
+        "{head}\n[{} characters cut to fit the context. Run a narrower command for what you need, such as grep or sed -n.]\n{tail}",
+        chars - HEAD - TAIL
+    ))
+}
