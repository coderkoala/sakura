+/// [sakura] Adapts recorded items for a model that only sees the chat messages:
+/// - A `<lookup>` developer message becomes a user message in place. Left in the system prompt, the
+///   fact sat ~30k characters from the question and the model re-ran the lookup instead of using it.
+/// - A Stop hook prompt becomes plain user text. The message builder skips hook prompts as contextual,
+///   so the model never received them and answered a conversation ending on its own message.
+fn normalize_input_items(items: &[ResponseItem]) -> Vec<ResponseItem> {
+    items
+        .iter()
+        .cloned()
+        .map(|mut item| {
+            if let ResponseItem::Message { role, content, .. } = &mut item {
+                let is_lookup = role == "developer"
+                    && content.iter().any(|part| {
+                        matches!(part, ContentItem::InputText { text } if text.contains(LOOKUP_MARKER))
+                    });
+                if is_lookup {
+                    *role = "user".to_string();
+                } else if role == "user" {
+                    for part in content.iter_mut() {
+                        if let ContentItem::InputText { text } = part
+                            && let Some(fragment) = parse_hook_prompt_fragment(text)
+                        {
+                            *text = fragment.text;
+                        }
+                    }
+                }
+            }
+            item
+        })
+        .collect()
+}
