+    /// Keeps a small context from overflowing on command output, which is what fills it. The usual estimate
+    /// assumes about 4 characters per token, but a digit is a token of its own, so a batch of parallel calls on
+    /// logs can come to several times the window before any compaction would notice, and compaction would then
+    /// overflow too. Oldest output goes first, cut to its ends. A cut stays cut, so the prompt cache is only
+    /// invalidated when this fires, not on every step. The transcript on disk keeps the full output.
+    pub(crate) fn enforce_tool_output_budget(&mut self, context_window: i64) {
+        const LARGEST_BUDGETED_WINDOW: i64 = 65_536;
+        const PROMPT_TOKENS: i64 = 9_000; // the system prompt and tool list, which aren't in the history
+        if context_window > LARGEST_BUDGETED_WINDOW {
+            return;
+        }
+        let mut total = PROMPT_TOKENS
+            + self
+                .items
+                .iter()
+                .map(|envelope| {
+                    serde_json::to_string(&envelope.item)
+                        .map_or(0, |json| conservative_tokens(json.as_str()))
+                })
+                .sum::<i64>();
+        if total <= context_window * 7 / 10 {
+            return;
+        }
+        let target = context_window / 2;
+        let mut freed = 0;
+        for envelope in Arc::make_mut(&mut self.items).iter_mut() {
+            if total <= target {
+                break;
+            }
+            let (ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. }) = &mut envelope.item
+            else {
+                continue;
+            };
+            let FunctionCallOutputBody::Text(text) = &mut output.body else {
+                continue;
+            };
+            let Some(short) = cut_to_ends(text) else {
+                continue;
+            };
+            let saved = conservative_tokens(text) - conservative_tokens(&short);
+            *text = short;
+            total -= saved;
+            freed += saved;
+        }
+        if freed > 0 {
+            self.history_version = self.history_version.saturating_add(1);
+            if let Some(info) = &mut self.token_info {
+                info.last_token_usage.total_tokens =
+                    info.last_token_usage.total_tokens.saturating_sub(freed).max(0);
+            }
+        }
+    }
