+#[cfg(test)]
+mod sakura_tests {
+    use super::*;
+    use codex_protocol::items::HookPromptFragment;
+    use codex_protocol::items::build_hook_prompt_message;
+
+    fn message(role: &str, text: &str) -> ResponseItem {
+        ResponseItem::Message {
+            id: None,
+            role: role.to_string(),
+            content: vec![ContentItem::InputText { text: text.to_string() }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        }
+    }
+
+    fn roles_and_text(items: &[ResponseItem]) -> Vec<(String, String)> {
+        items
+            .iter()
+            .filter_map(|item| match item {
+                ResponseItem::Message { role, content, .. } => match content.first() {
+                    Some(ContentItem::InputText { text }) => Some((role.clone(), text.clone())),
+                    _ => None,
+                },
+                _ => None,
+            })
+            .collect()
+    }
+
+    #[test]
+    fn only_working_tools_are_offered() {
+        let tool = |name: &str, description: &str| json!({"function": {"name": name, "description": description}});
+        assert!(offered_to_qwen(&tool("exec_command", "Runs a command")));
+        assert!(!offered_to_qwen(&tool("Bash", "Open Interpreter harness compatibility alias for Bash.")));
+        assert!(!offered_to_qwen(&tool("create_goal", "Create a goal")));
+    }
+
+    #[test]
+    fn lookup_moves_beside_the_question_and_other_developer_text_stays() {
+        let items = vec![
+            message("developer", "skills index"),
+            message("user", "newest vue?"),
+            message("developer", "<lookup>vue 3.5.44</lookup>"),
+        ];
+        let got = roles_and_text(&normalize_input_items(&items));
+        assert_eq!(got[0].0, "developer");
+        assert_eq!(got[2], ("user".to_string(), "<lookup>vue 3.5.44</lookup>".to_string()));
+    }
+
+    #[test]
+    fn stop_hook_prompt_reaches_the_model_as_a_user_message() {
+        let hook = build_hook_prompt_message(&[HookPromptFragment {
+            text: "Do it now.".to_string(),
+            hook_run_id: "stop:1".to_string(),
+        }])
+        .expect("hook prompt");
+        let input = normalize_input_items(&[message("user", "fix it"), hook]);
+        let sent: Vec<Value> = build_qwen_messages(&input).expect("messages");
+        let last = sent.last().expect("a message");
+        assert_eq!(last["role"], "user");
+        assert!(last.to_string().contains("Do it now."), "got {last}");
+    }
+}
